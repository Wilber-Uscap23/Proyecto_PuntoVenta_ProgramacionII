            (p.Estado == true ||

             (editando && p.IdProveedor ==

                 compras.FirstOrDefault(c =>

                     c.IdCompra == idCompraEditar)?.IdProveedor)));

        if (!proveedorValido)

            return "Selecciona un proveedor válido y activo.";

        if (string.IsNullOrWhiteSpace(formulario.NumeroFactura))
            return "El número de factura es obligatorio.";
        if (formulario.FechaFactura == null)
            return "La fecha de factura es obligatoria.";
        if (formulario.FechaFactura.Value < new DateOnly(1900, 1, 1) ||
            formulario.FechaFactura.Value > DateOnly.FromDateTime(DateTime.Today))
            return "La fecha de factura no puede ser futura.";
        if (!string.IsNullOrWhiteSpace(errorFacturaPdf))
            return errorFacturaPdf;

        if (formulario.Observaciones?.Trim().Length > 255)

            return "Las observaciones no deben superar 255 caracteres.";

        if (formulario.Detalles.Count == 0)

            return "Agrega al menos un producto.";

        if (formulario.Detalles.Count > 50)

            return "Se permiten máximo 50 productos.";

        var seleccionados = new HashSet<int>();

        decimal total = 0;

        foreach (var linea in formulario.Detalles)

        {

            var producto = productos

                .FirstOrDefault(p => p.IdProducto == linea.IdProducto);

            if (producto == null)

                return "Selecciona un producto en cada fila.";

            if (producto.Estado != true)

                return $"El producto {producto.Codigo} está inactivo.";

            if (!seleccionados.Add(linea.IdProducto))

                return $"El producto {producto.Codigo} está repetido.";

            if (linea.Cantidad < 1 || linea.Cantidad > 1000000)

                return $"La cantidad de {producto.Codigo} debe estar entre 1 y 1,000,000.";

            if (linea.PrecioCosto <= 0 ||

                linea.PrecioCosto > 9999999999.99m ||

                decimal.Round(linea.PrecioCosto, 2) != linea.PrecioCosto)

            {

                return $"El costo de {producto.Codigo} debe ser positivo y tener máximo dos decimales.";

            }

            decimal subtotal = linea.Cantidad * linea.PrecioCosto;

            if (subtotal > 9999999999.99m)

                return $"El subtotal de {producto.Codigo} es demasiado alto.";

            total += subtotal;

            if (total > 9999999999.99m)

                return "El total de la compra supera el límite permitido.";

        }

        return null;

    }

    // ========================================

    // GUARDAR COMPRA NUEVA O EDITADA

    // ========================================

    private async Task GuardarCompra()

    {
        if (!EsAdmin)
        {
            errorModal = "Solo ADMIN puede guardar compras.";
            return;
        }

        if (guardando)

            return;

        guardando = true;

        errorModal = null;

        try

        {

            string? validacion = ValidarCompra();

            if (validacion != null)

            {

                errorModal = validacion;

                return;

            }

            formulario.Observaciones =

                string.IsNullOrWhiteSpace(formulario.Observaciones)

                    ? null

                    : formulario.Observaciones.Trim();

            HttpResponseMessage respuesta;

            if (editando)

            {

                respuesta = await Http.PutAsJsonAsync(

                    $"api/Compras/{idCompraEditar}", formulario);

            }

            else

            {

                respuesta = await Http.PostAsJsonAsync(

                    "api/Compras", formulario);

            }

            if (!respuesta.IsSuccessStatusCode)

            {

                errorModal = await LeerError(respuesta);

                return;

            }

            // El encabezado y el inventario ya fueron guardados por la API.
            // El archivo es opcional y se adjunta en una segunda solicitud.
            string? avisoPdf = null;
            int idGuardado = idCompraEditar;
            if (!editando)
            {
                using var doc = JsonDocument.Parse(await respuesta.Content.ReadAsStringAsync());
                if (doc.RootElement.TryGetProperty("idCompra", out var idJson))
                    idGuardado = idJson.GetInt32();
            }
            if (archivoFacturaSeleccionado != null)
            {
                if (idGuardado > 0)
                {
                    try
                    {
                        using var contenido = new MultipartFormDataContent();
                        await using var flujo = archivoFacturaSeleccionado.OpenReadStream(2 * 1024 * 1024);
                        using var archivoContenido = new StreamContent(flujo);
                        archivoContenido.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/pdf");
                        contenido.Add(archivoContenido, "archivo", archivoFacturaSeleccionado.Name);
                        using var respuestaArchivo = await Http.PostAsync($"api/Compras/{idGuardado}/factura-pdf", contenido);
                        if (!respuestaArchivo.IsSuccessStatusCode)
                            avisoPdf = "La compra se guardó, pero el PDF no se adjuntó. Podés editar la compra para intentarlo nuevamente.";
                    }
                    catch (Exception)
                    {
                        avisoPdf = "La compra se guardó, pero el PDF no se adjuntó. Podés editar la compra para intentarlo nuevamente.";
                    }
                }
                else
                {
                    avisoPdf = "La compra se guardó, pero no se pudo identificarla para adjuntar el PDF.";
                }
            }

            bool actualizado = await CargarCompras();

            await CargarCatalogos();

            mostrarFormulario = false;

            if (actualizado)

            {

                mensaje = avisoPdf ?? (editando

                    ? "Compra actualizada e inventario ajustado correctamente."

                    : "Compra registrada e inventario actualizado correctamente.");

            }

        }

        catch (Exception)

        {

            errorModal = "No se pudo guardar la compra. Verifica la API.";

        }

        finally

        {

            guardando = false;

        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && PuedeConsultar)
        {
            try
            {
                moduloComprobantes = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                    "import", "./js/comprobantes.js");
            }
            catch (Microsoft.JSInterop.JSException) { }
        }
    }

    private void SeleccionarFacturaPdf(InputFileChangeEventArgs e)
    {
        archivoFacturaSeleccionado = null;
        errorFacturaPdf = null;
        var archivo = e.File;
        if (archivo == null) return;
        if (!archivo.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ||
            archivo.Name.Length > 180 || archivo.Size == 0 || archivo.Size > 2 * 1024 * 1024)
        {
            errorFacturaPdf = "Seleccioná un PDF válido de máximo 2 MB.";
            return;
        }
        archivoFacturaSeleccionado = archivo;
    }

    private async Task AbrirFacturaPdf(int idCompra)
    {
        if (!PuedeConsultar || abriendoFacturaPdf || idCompra <= 0) return;
        abriendoFacturaPdf = true;
        errorDetalle = null;
        string? ventana = null;
        try
        {
            moduloComprobantes ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                "import", "./js/comprobantes.js");
            ventana = await moduloComprobantes.InvokeAsync<string?>("prepararVistaPdf");
            if (string.IsNullOrWhiteSpace(ventana))
                throw new InvalidOperationException("El navegador bloqueó la nueva pestaña. Permití ventanas emergentes.");

            using var respuesta = await Http.GetAsync($"api/Compras/{idCompra}/factura-pdf");
            if (!respuesta.IsSuccessStatusCode)
                throw new InvalidOperationException("No se pudo abrir el PDF de la factura.");

            var contenido = await respuesta.Content.ReadAsByteArrayAsync();
            await moduloComprobantes.InvokeVoidAsync(
                "mostrarPdf", ventana, Convert.ToBase64String(contenido));
        }
        catch (Exception ex)
        {
            errorDetalle = ex.Message;
            if (ventana != null && moduloComprobantes != null)
            {
                try { await moduloComprobantes.InvokeVoidAsync("cerrarVistaPdf", ventana); }
                catch { }
            }
        }
        finally { abriendoFacturaPdf = false; }
    }

    private async Task GestionarComprobanteCompra(int idCompra, bool descargar)
    {
        if (!PuedeConsultar || procesandoComprobanteCompra || idCompra <= 0)
            return;

        if (!Sesion.EstaAutenticado)
        {
            error = "Tu sesión ha finalizado. Iniciá sesión nuevamente.";
            return;
        }

        procesandoComprobanteCompra = true;
        error = null;
        string? ventana = null;

        try
        {
            moduloComprobantes ??=
                await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/comprobantes.js");

            if (!descargar)
            {
                ventana = await moduloComprobantes
                    .InvokeAsync<string?>("prepararVistaPdf");

                if (string.IsNullOrWhiteSpace(ventana))
                    throw new InvalidOperationException(
                        "El navegador bloqueó la pestaña del PDF.");
            }

            using var respuesta = await Http.GetAsync(
                $"api/Comprobantes/compra/{idCompra}");

            if (!respuesta.IsSuccessStatusCode)
            {
                string detalle = respuesta.StatusCode switch
                {
                    System.Net.HttpStatusCode.Unauthorized =>
                        "Tu sesión ha expirado.",
                    System.Net.HttpStatusCode.Forbidden =>
                        "No tenés permiso para consultar este comprobante.",
                    System.Net.HttpStatusCode.NotFound =>
                        "No se encontró el comprobante. Verificá que la API esté actualizada.",
                    _ =>
                        "No se pudo generar el comprobante de compra."
                };

                throw new InvalidOperationException(detalle);
            }

            byte[] contenido =
                await respuesta.Content.ReadAsByteArrayAsync();

            if (contenido.Length == 0)
                throw new InvalidOperationException(
                    "El comprobante PDF está vacío.");

            string base64 = Convert.ToBase64String(contenido);

            string nombreArchivo =
                $"Comprobante_Compra_{idCompra:000000}.pdf";

            if (descargar)
            {
                await moduloComprobantes.InvokeVoidAsync(
                    "descargarPdf", base64, nombreArchivo);
            }
            else
            {
                await moduloComprobantes.InvokeVoidAsync(
                    "mostrarPdf", ventana, base64);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;

            if (ventana != null && moduloComprobantes != null)
            {
                try
                {
                    await moduloComprobantes.InvokeVoidAsync(
                        "cerrarVistaPdf", ventana);
                }
                catch (JSException)
                {
                }
            }
        }
        finally
        {
            procesandoComprobanteCompra = false;
        }
    }

