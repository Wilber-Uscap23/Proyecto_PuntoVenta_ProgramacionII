        LineaFormulario linea, ChangeEventArgs e)

    {
        if (!EsAdmin)
            return;

        if (!int.TryParse(e.Value?.ToString(), out int id))

            id = 0;

        linea.IdProducto = id;

        var producto = productos

            .FirstOrDefault(p => p.IdProducto == id);

        linea.PrecioCosto = producto?.PrecioCosto ?? 0m;

