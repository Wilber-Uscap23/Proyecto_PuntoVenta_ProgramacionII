    private IEnumerable<ProductoOpcion> ProductosParaSelector(
        LineaFormulario linea,
        HashSet<int> habituales)
    {
        string filtro = linea.BusquedaProducto.Trim();

        return productos
            .Where(p =>
                (p.Estado == true || p.IdProducto == linea.IdProducto) &&
                (filtro.Length == 0 ||
                 p.IdProducto == linea.IdProducto ||
                 p.Codigo.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                 p.Descripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(p => habituales.Contains(p.IdProducto) ? 0 : 1)
            .ThenBy(p => p.Codigo);
    }

