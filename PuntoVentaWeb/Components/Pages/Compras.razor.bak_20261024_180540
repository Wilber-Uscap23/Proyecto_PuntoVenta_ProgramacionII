    // ========================================

    // CONFIRMAR ANULACIÓN

    // ========================================

    private void PedirAnulacion(CompraResumen compra)

    {
        if (!EsAdmin)
        {
            error = "Solo ADMIN puede anular compras.";
            return;
        }

        compraAnular = compra;

        errorAnulacion = null;

    }

    private void CerrarAnulacion()

    {

        if (anulando)

            return;

        compraAnular = null;

        errorAnulacion = null;

    }

    private async Task ConfirmarAnulacion()

    {
        if (!EsAdmin)
        {
            errorAnulacion = "Solo ADMIN puede anular compras.";
            return;
        }

        if (compraAnular == null || anulando)

            return;

        anulando = true;

        errorAnulacion = null;

        try

        {

            int id = compraAnular.IdCompra;

            var respuesta = await Http.PutAsync(

                $"api/Compras/{id}/anular", null);

            if (!respuesta.IsSuccessStatusCode)

            {

                errorAnulacion = await LeerError(respuesta);

                return;

            }

            bool actualizado = await CargarCompras();

            await CargarCatalogos();

            compraAnular = null;

            if (actualizado)

                mensaje = "Compra anulada e inventario revertido correctamente.";

        }

        catch (Exception)

        {

            errorAnulacion = "No se pudo anular la compra. Verifica la API.";

        }

        finally

        {

            anulando = false;

        }

    }

    // ========================================

    // MOSTRAR ERRORES DE LA API

    // ========================================

    private static async Task<string> LeerError(

        HttpResponseMessage respuesta)

    {

        string contenido =

            await respuesta.Content.ReadAsStringAsync();

        try

        {

            using var documento = JsonDocument.Parse(contenido);

            var raiz = documento.RootElement;

            if (raiz.TryGetProperty("mensaje", out var mensajeApi))

            {

                string? texto = mensajeApi.GetString();

                if (!string.IsNullOrWhiteSpace(texto))

                    return texto;

            }

            if (raiz.TryGetProperty("errors", out var errores) &&

                errores.ValueKind == JsonValueKind.Object)

            {

                foreach (var campo in errores.EnumerateObject())

                {

                    if (campo.Value.ValueKind != JsonValueKind.Array)

                        continue;

                    foreach (var detalle in campo.Value.EnumerateArray())

                    {

                        if (detalle.ValueKind == JsonValueKind.String)

                            return detalle.GetString()

                                ?? "Los datos no son válidos.";

                    }

                }

            }

        }

        catch (JsonException)

        {

            // La respuesta no contiene JSON válido.

        }

        return $"No se pudo completar la operación. HTTP {(int)respuesta.StatusCode}.";

    }

