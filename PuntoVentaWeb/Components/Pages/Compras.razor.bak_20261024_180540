private async Task GuardarNuevoProveedorEnCompra()
{
    if (!EsAdmin || !mostrarFormulario || !mostrarNuevoProveedor ||
        guardando || guardandoProveedor)
        return;

    guardandoProveedor = true;
    errorNuevoProveedor = null;

    try
    {
        // El controlador aplica nuevamente todas las validaciones y
        // normaliza los datos. El token de ADMIN lo maneja HttpClient.
        var datos = new
        {
            Nombre = nuevoProveedor.Nombre.Trim(),
            Nit = LimpiarCampoProveedor(nuevoProveedor.Nit)?.ToUpperInvariant(),
            Telefono = LimpiarCampoProveedor(nuevoProveedor.Telefono),
            Correo = LimpiarCampoProveedor(nuevoProveedor.Correo)?.ToLowerInvariant(),
            Contacto = LimpiarCampoProveedor(nuevoProveedor.Contacto),
            Direccion = LimpiarCampoProveedor(nuevoProveedor.Direccion)
        };

        using var respuesta = await Http.PostAsJsonAsync("api/Proveedores", datos);
        if (!respuesta.IsSuccessStatusCode)
        {
            errorNuevoProveedor = await LeerError(respuesta);
            return;
        }

        int idNuevo = 0;
        try
        {
            string json = await respuesta.Content.ReadAsStringAsync();
            using var documento = JsonDocument.Parse(json);
            if (documento.RootElement.TryGetProperty("idProveedor", out var idJson) &&
                idJson.TryGetInt32(out int idRespuesta))
            {
                idNuevo = idRespuesta;
            }
        }
        catch (JsonException)
        {
            // Si el servidor no devolviera el ID, buscar por nombre.
        }

        mostrarNuevoProveedor = false;
        try
        {
            var lista = await Http.GetFromJsonAsync<List<ProveedorOpcion>>(
                "api/Proveedores") ?? new();
            proveedores = lista;
            var creado = lista.FirstOrDefault(p => p.Estado == true &&
                p.IdProveedor == idNuevo);
            creado ??= lista.FirstOrDefault(p => p.Estado == true &&
                string.Equals(p.Nombre, datos.Nombre,
                    StringComparison.OrdinalIgnoreCase));

            if (creado != null)
            {
                formulario.IdProveedor = creado.IdProveedor;
                avisoProveedor = $"Proveedor «{creado.Nombre}» registrado y seleccionado.";
            }
            else
            {
                avisoProveedor = "Proveedor registrado. Presioná 'Actualizar proveedores' " +
                                "para seleccionarlo.";
            }
        }
        catch (Exception)
        {
            // El POST ya se guardó. No intentar crear de nuevo.
            avisoProveedor = "Proveedor registrado, pero no se pudo actualizar la lista. " +
                            "Presioná 'Actualizar proveedores'.";
        }
    }
    catch (Exception)
    {
        errorNuevoProveedor = "No se pudo registrar el proveedor. Verificá la API.";
    }
    finally
    {
        guardandoProveedor = false;
    }
}

