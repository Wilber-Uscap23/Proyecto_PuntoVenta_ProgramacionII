@page "/compras"

@rendermode InteractiveServer

@using System.Net.Http.Json

@using System.Text.Json

@using System.ComponentModel.DataAnnotations

@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using PuntoVentaWeb.Servicios

@inject HttpClient Http
@inject SesionUsuario Sesion
@inject IJSRuntime JS

<PageTitle>Compras - Sistema Punto de Venta</PageTitle>

@if (!PuedeConsultar)
{
    <div class="alert alert-danger m-4" role="alert">
        No tenés permiso para acceder al módulo de Compras.
    </div>
}
else
{
<div class="container-fluid mt-4">

    <!-- ENCABEZADO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Administración de Compras</h2>


        </div>

        @if (EsAdmin)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="AbrirNueva">
                + Nueva Compra
            </button>
        }

    </div>

    <!-- MENSAJES -->

    @if (!string.IsNullOrWhiteSpace(mensaje))

    {

        <div class="alert alert-success alert-dismissible">

            @mensaje

            <button type="button"

                    class="btn-close"

                    @onclick="() => mensaje = null">

            </button>

        </div>

    }

    @if (!string.IsNullOrWhiteSpace(error))

    {

        <div class="alert alert-danger alert-dismissible">

            @error

            <button type="button"

                    class="btn-close"

                    @onclick="() => error = null">

            </button>

        </div>

    }

    <!-- FILTROS -->

    <div class="card shadow-sm mb-3">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-8">

                    <label class="form-label">Buscar compra</label>

                    <input class="form-control"

                           placeholder="Buscar por número o proveedor..."

                           @bind="busqueda"

                           @bind:event="oninput" />

                </div>

                <div class="col-md-4">

                    <label class="form-label">Estado</label>

                    <select class="form-select" @bind="filtroEstado">

                        <option value="TODAS">Todas</option>

                        <option value="REGISTRADA">Registradas</option>

                        <option value="ANULADA">Anuladas</option>

                    </select>

                </div>

            </div>

        </div>

    </div>

    <!-- LISTADO -->

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">Listado de Compras</h5>

        </div>

        <div class="card-body">

            @if (cargando)

            {

                <p>Cargando compras...</p>

            }

            else if (!ComprasFiltradas.Any())

            {

                <div class="alert alert-info mb-0">

                    No se encontraron compras.

                </div>

            }

            else

            {

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>No.</th>

                                <th>Fecha</th>

                                <th>Proveedor</th>

                                <th>Factura</th>

                                <th>Productos</th>

                                <th>Total</th>

                                <th>Estado</th>

                                <th>Acciones</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var compra in ComprasFiltradas)

                            {

                                <tr>

                                    <td>@compra.IdCompra</td>

                                    <td>@compra.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>

                                    <td>@compra.NombreProveedor</td>

                                    <td>@Mostrar(compra.NumeroFactura)</td>

                                    <td>@compra.CantidadProductos</td>

                                    <td><strong>@Q(compra.Total)</strong></td>

                                    <td>

                                        @if (compra.Estado == "REGISTRADA")

                                        {

                                            <span class="badge bg-success">Registrada</span>

                                        }

                                        else

                                        {

                                            <span class="badge bg-danger">@compra.Estado</span>

                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex gap-1">

                                            <button type="button"

                                                    class="btn btn-info btn-sm"

                                                    @onclick="() => VerDetalle(compra.IdCompra)">

                                                Ver

                                            </button>

                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    disabled="@procesandoComprobanteCompra"
                                                    @onclick="() => GestionarComprobanteCompra(compra.IdCompra, false)">
                                                Ver PDF
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm"
                                                    disabled="@procesandoComprobanteCompra"
                                                    @onclick="() => GestionarComprobanteCompra(compra.IdCompra, true)">
                                                Descargar
                                            </button>

                                            @if (EsAdmin && compra.Estado == "REGISTRADA")

                                            {

                                                <button type="button"

                                                        class="btn btn-warning btn-sm"

                                                        @onclick="() => AbrirEditar(compra.IdCompra)">

                                                    Editar

                                                </button>

                                                <button type="button"

                                                        class="btn btn-danger btn-sm"

                                                        @onclick="() => PedirAnulacion(compra)">

                                                    Anular

                                                </button>

                                            }

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>

<!-- ======================================== -->

<!-- MODAL DE REGISTRO / EDICIÓN              -->

<!-- ======================================== -->

@if (EsAdmin && mostrarFormulario)

{

    <div class="modal fade show d-block"

         tabindex="-1"

         role="dialog"

         aria-modal="true"

         aria-label="Formulario de compra">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">

                        @(editando ? "Editar Compra" : "Registrar Nueva Compra")

                    </h5>

                    <button type="button"

                            class="btn-close btn-close-white"

                            disabled="@guardando"

                            @onclick="CerrarFormulario">

                    </button>

                </div>

                <EditForm Model="@formulario"

                          @key="formulario"

                          OnValidSubmit="GuardarCompra"

                          FormName="compraForm">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        @if (!string.IsNullOrWhiteSpace(errorModal))

                        {

                            <div class="alert alert-danger">

                                @errorModal

                            </div>

                        }

                        <!-- ENCABEZADO DE COMPRA -->

                        <h5 class="mb-3">Datos de la compra</h5>

                        <div class="row g-3 mb-4">

                            <div class="col-md-7">

                                <div class="d-flex justify-content-between align-items-center mb-1 gap-2">
                                    <label class="form-label mb-0">Proveedor *</label>
                                    <button type="button"
                                            class="btn btn-link btn-sm p-0 text-decoration-none"
                                            disabled="@(guardando || guardandoProveedor)"
                                            @onclick="AbrirNuevoProveedorEnCompra">
                                        + Nuevo proveedor
                                    </button>
                                </div>

                                <InputSelect class="form-select"

                                             @bind-Value="formulario.IdProveedor">

                                    <option value="0">

                                        -- Selecciona un proveedor --

                                    </option>

                                    @foreach (var proveedor in proveedores.Where(p =>

                                        p.Estado == true ||

                                        (editando && p.IdProveedor == formulario.IdProveedor)))

                                    {

                                        <option value="@proveedor.IdProveedor">

                                            @proveedor.Nombre

                                            @(proveedor.Estado == true ? "" : " (Inactivo)")

                                        </option>

                                    }

                                </InputSelect>

                                <ValidationMessage

                                    For="@(() => formulario.IdProveedor)"

                                    class="text-danger" />

                                <div class="d-flex align-items-center gap-2 flex-wrap mt-2">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm"
                                            disabled="@(actualizandoProveedores || guardando)"
                                            @onclick="ActualizarListaProveedores">
                                        @(actualizandoProveedores ? "Actualizando..." : "↻ Actualizar proveedores")
                                    </button>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(avisoProveedor))
                                {
                                    <small class="d-block mt-2 text-success">@avisoProveedor</small>
                                }

                                @if (!proveedores.Any(p => p.Estado == true))
                                {
                                    <div class="alert alert-warning py-2 mt-2 mb-0">
                                        Todavía no hay proveedores activos. Registrá uno con
                                        <strong>+ Nuevo proveedor</strong> para continuar.
                                    </div>
                                }

                            </div>

                            <div class="col-md-5">

                                <label class="form-label">Fecha</label>

                                <input class="form-control"

                                       value="@(fechaCompraVisible.ToString("dd/MM/yyyy HH:mm"))"

                                       readonly />

                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Número de factura *</label>
                                <InputText class="form-control" maxlength="80"
                                           @bind-Value="formulario.NumeroFactura" />
                                <ValidationMessage For="@(() => formulario.NumeroFactura)"
                                                   class="text-danger" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha de factura *</label>
                                <InputDate class="form-control" max="@FechaMaximaFactura"
                                           @bind-Value="formulario.FechaFactura" />
                                <ValidationMessage For="@(() => formulario.FechaFactura)"
                                                   class="text-danger" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Factura del proveedor (PDF opcional, máximo 2 MB)</label>
                                <InputFile OnChange="SeleccionarFacturaPdf" accept=".pdf,application/pdf"
                                           class="form-control" />
                                @if (editando && facturaPdfExistente)
                                {
                                    <small class="text-muted d-block mt-1">Esta compra ya tiene un PDF. Si adjuntás otro, lo reemplazará.</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(errorFacturaPdf))
                                {
                                    <small class="text-danger d-block mt-1">@errorFacturaPdf</small>
                                }
                            </div>

                            <div class="col-12">

                                <label class="form-label">Observaciones</label>

                                <InputTextArea class="form-control"

                                               rows="2"

                                               maxlength="255"

                                               @bind-Value="formulario.Observaciones" />

                                <ValidationMessage

                                    For="@(() => formulario.Observaciones)"

                                    class="text-danger" />

                            </div>

                        </div>

                        <!-- DETALLE -->

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <h5 class="mb-0">Detalle de productos</h5>

                            <button type="button"

                                    class="btn btn-outline-primary btn-sm"

                                    disabled="@(formulario.Detalles.Count >= 50 || guardando)"

                                    @onclick="AgregarLinea">

                                + Agregar Producto

                            </button>

                        </div>

                        <div class="table-responsive">

                            <table class="table table-bordered align-middle">

                                <thead class="table-dark">

                                    <tr>

                                        <th style="min-width:230px;">Producto</th>

                                        <th style="min-width:120px;">Cantidad</th>

                                        <th style="min-width:150px;">Costo (Q)</th>

                                        <th style="min-width:130px;">Subtotal</th>

                                        <th style="width:65px;">Quitar</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var linea in formulario.Detalles)

                                    {

                                        <tr @key="linea.Clave">

                                            <td>

                                                @{
    var habituales = compras
        .Where(c => c.IdProveedor == formulario.IdProveedor &&
                    c.Estado == "REGISTRADA")
        .SelectMany(c => c.IdsProductos)
        .ToHashSet();
}

<input type="search"
       class="form-control form-control-sm mb-1"
       placeholder="Buscar código o producto..."
       @bind="linea.BusquedaProducto"
       @bind:event="oninput" />

<select class="form-select"
        value="@linea.IdProducto"
        @onchange="e => SeleccionarProducto(linea, e)">

    <option value="0">-- Producto --</option>

    @foreach (var producto in ProductosParaSelector(linea, habituales))
    {
        <option value="@producto.IdProducto">
            @(habituales.Contains(producto.IdProducto) ? "★ Habitual: " : "")
            @producto.Codigo - @producto.Descripcion
            @(producto.Estado == true ? "" : " (Inactivo)")
        </option>
    }
</select>

                                            </td>

                                            <td>

                                                <InputNumber class="form-control"

                                                             min="1"

                                                             max="1000000"

                                                             step="1"

                                                             @bind-Value="linea.Cantidad" />

                                            </td>

                                            <td>

                                                <InputNumber class="form-control"

                                                             min="0.01"

                                                             step="0.01"

                                                             @bind-Value="linea.PrecioCosto" />

                                            </td>

                                            <td>

                                                <strong>@Q(Subtotal(linea))</strong>

                                            </td>

                                            <td>

                                                <button type="button"

                                                        class="btn btn-outline-danger btn-sm"

                                                        disabled="@(formulario.Detalles.Count <= 1 || guardando)"

                                                        @onclick="() => QuitarLinea(linea.Clave)">

                                                    Quitar

                                                </button>

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                        <ValidationMessage

                            For="@(() => formulario.Detalles)"

                            class="text-danger" />


                        <div class="d-flex justify-content-end mt-3">

                            <div class="text-end">

                                <div class="text-muted">Total de compra</div>

                                <h3 class="text-primary">@Q(TotalFormulario)</h3>

                            </div>

                        </div>


                    </div>

                    <div class="modal-footer">

                        <button type="button"

                                class="btn btn-secondary"

                                disabled="@guardando"

                                @onclick="CerrarFormulario">

                            Cancelar

                        </button>

                        <button type="submit"

                                class="btn btn-success"

                                disabled="@guardando">

                            @(guardando ? "Guardando..." :

                                editando ? "Guardar Cambios" : "Registrar Compra")

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>

    <div class="modal-backdrop fade show"></div>

}

<!-- ======================================== -->
<!-- MODAL DE REGISTRO RÁPIDO DE PROVEEDOR    -->
<!-- Permite permanecer dentro de la compra. -->
<!-- ======================================== -->
@if (EsAdmin && mostrarFormulario && mostrarNuevoProveedor)
{
    <div class="modal fade show d-block"
         style="z-index: 1080;"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Registrar nuevo proveedor sin salir de Compras">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Registrar Nuevo Proveedor</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@guardandoProveedor"
                            @onclick="CerrarNuevoProveedorEnCompra">
                    </button>
                </div>
                <EditForm Model="@nuevoProveedor"
                          @key="nuevoProveedor"
                          OnValidSubmit="GuardarNuevoProveedorEnCompra"
                          FormName="proveedorEnCompraForm">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(errorNuevoProveedor))
                        {
                            <div class="alert alert-danger">@errorNuevoProveedor</div>
                        }
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Nombre del proveedor *</label>
                                <InputText class="form-control"
                                           maxlength="150"
                                           @bind-Value="nuevoProveedor.Nombre" />
                                <ValidationMessage For="@(() => nuevoProveedor.Nombre)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">NIT *</label>
                                <InputText class="form-control"
                                           maxlength="20"
                                           @bind-Value="nuevoProveedor.Nit" />
                                <ValidationMessage For="@(() => nuevoProveedor.Nit)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono *</label>
                                <InputText class="form-control"
                                           maxlength="20"
                                           @bind-Value="nuevoProveedor.Telefono" />
                                <ValidationMessage For="@(() => nuevoProveedor.Telefono)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Correo electrónico *</label>
                                <InputText type="email"
                                           class="form-control"
                                           maxlength="150"
                                           @bind-Value="nuevoProveedor.Correo" />
                                <ValidationMessage For="@(() => nuevoProveedor.Correo)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Persona de contacto (opcional)</label>
                                <InputText class="form-control"
                                           maxlength="100"
                                           @bind-Value="nuevoProveedor.Contacto" />
                                <ValidationMessage For="@(() => nuevoProveedor.Contacto)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Dirección (opcional)</label>
                                <InputTextArea class="form-control"
                                               rows="2"
                                               maxlength="255"
                                               @bind-Value="nuevoProveedor.Direccion" />
                                <ValidationMessage For="@(() => nuevoProveedor.Direccion)" />
                            </div>
                        </div>
                        <p class="text-muted small mt-3 mb-0">Los campos con * son obligatorios.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@guardandoProveedor"
                                @onclick="CerrarNuevoProveedorEnCompra">Cancelar</button>
                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardandoProveedor">
                            @(guardandoProveedor ? "Guardando..." : "Guardar y seleccionar proveedor")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" style="z-index: 1070;"></div>
}

<!-- ======================================== -->

<!-- MODAL PARA VER DETALLE                   -->

<!-- ======================================== -->

@if (mostrarDetalle)

{

    <div class="modal fade show d-block"

         tabindex="-1"

         role="dialog"

         aria-modal="true"

         aria-label="Detalle de compra">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">Detalle de Compra</h5>

                    <button type="button"

                            class="btn-close btn-close-white"

                            @onclick="CerrarDetalle">

                    </button>

                </div>

                <div class="modal-body">

                    @if (cargandoDetalle)

                    {

                        <p>Cargando detalle...</p>

                    }

                    else if (!string.IsNullOrWhiteSpace(errorDetalle))

                    {

                        <div class="alert alert-danger">@errorDetalle</div>

                    }

                    else if (detalleSeleccionado != null)

                    {

                        <div class="row g-3 mb-3">

                            <div class="col-md-3">

                                <strong>Número:</strong>

                                @detalleSeleccionado.IdCompra

                            </div>

                            <div class="col-md-4">

                                <strong>Proveedor:</strong>

                                @detalleSeleccionado.NombreProveedor

                            </div>

                            <div class="col-md-3">

                                <strong>Fecha:</strong>

                                @detalleSeleccionado.FechaCompra.ToString("dd/MM/yyyy HH:mm")

                            </div>

                            <div class="col-md-2">

                                <strong>Estado:</strong>

                                @detalleSeleccionado.Estado

                            </div>

                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <strong>Número de factura:</strong> @Mostrar(detalleSeleccionado.NumeroFactura)
                            </div>
                            <div class="col-md-4">
                                <strong>Fecha de factura:</strong>
                                @(detalleSeleccionado.FechaFactura?.ToString("dd/MM/yyyy") ?? "No registrada")
                            </div>
                            <div class="col-md-4">
                                @if (detalleSeleccionado.TieneFacturaPdf)
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm"
                                            disabled="@abriendoFacturaPdf"
                                            @onclick="() => AbrirFacturaPdf(detalleSeleccionado.IdCompra)">
                                        @(abriendoFacturaPdf ? "Abriendo..." : "Ver factura PDF")
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">Sin PDF adjunto</span>
                                }
                            </div>
                        </div>

                        <p>

                            <strong>Observaciones:</strong>

                            @Mostrar(detalleSeleccionado.Observaciones)

                        </p>

                        <div class="table-responsive">

                            <table class="table table-striped align-middle">

                                <thead class="table-dark">

                                    <tr>

                                        <th>Código</th>

                                        <th>Producto</th>

                                        <th>Cantidad</th>

                                        <th>Precio costo</th>

                                        <th>Subtotal</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var d in detalleSeleccionado.Detalles)

                                    {

                                        <tr>

                                            <td>@d.Codigo</td>

                                            <td>@d.Descripcion</td>

                                            <td>@d.Cantidad</td>

                                            <td>@Q(d.PrecioCosto)</td>

                                            <td>@Q(d.Subtotal)</td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                        <h4 class="text-end">

                            Total: @Q(detalleSeleccionado.Total)

                        </h4>

                    }

                </div>

                <div class="modal-footer">

                    <button type="button"

                            class="btn btn-secondary"

                            @onclick="CerrarDetalle">

                        Cerrar

                    </button>

                </div>

            </div>

        </div>

    </div>

    <div class="modal-backdrop fade show"></div>

}

<!-- ======================================== -->

<!-- MODAL DE CONFIRMACIÓN DE ANULACIÓN       -->

<!-- ======================================== -->

@if (EsAdmin && compraAnular != null)

{

    <div class="modal fade show d-block"

         tabindex="-1"

         role="dialog"

         aria-modal="true"

         aria-label="Confirmar anulación de compra">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">Anular Compra</h5>

                    <button type="button"

                            class="btn-close"

                            disabled="@anulando"

                            @onclick="CerrarAnulacion">

                    </button>

                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(errorAnulacion))

                    {

                        <div class="alert alert-danger">

                            @errorAnulacion

                        </div>

                    }

                    <p>

                        ¿Deseas anular la compra

                        <strong>No. @compraAnular.IdCompra</strong>

                        de <strong>@compraAnular.NombreProveedor</strong>?

                    </p>

                    <div class="alert alert-warning mb-0">

                        Se descontarán del inventario las unidades

                        que ingresaron por esta compra.

                        Si ya no hay suficientes existencias,

                        la anulación será rechazada.

                    </div>

                    <p class="text-muted small mt-3 mb-0">

                        La compra no se eliminará del historial.

