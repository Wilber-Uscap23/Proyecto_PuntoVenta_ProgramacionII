@page "/clientes"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.RegularExpressions
@using PuntoVentaWeb.Servicios
@inject HttpClient Http
@inject SesionUsuario Sesion

<PageTitle>Clientes - Sistema Punto de Venta</PageTitle>

<div class="container-fluid mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de Clientes</h2>
        </div>

        @if (PuedeRegistrar)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="AbrirNuevo">
                + Nuevo Cliente
            </button>
        }
    </div>

    <!-- MENSAJES -->
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-success alert-dismissible">
            @mensaje
            <button type="button"
                    class="btn-close"
                    @onclick="() => mensaje = null">
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible">
            @error
            <button type="button"
                    class="btn-close"
                    @onclick="() => error = null">
            </button>
        </div>
    }

    <!-- BUSCADOR -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-8">
                    <label class="form-label">Buscar cliente</label>

                    <input type="text"
                           class="form-control"
                           placeholder="Buscar por nombre, apellido, NIT, teléfono o correo..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Estado</label>

                    <select class="form-select" @bind="filtroEstado">
                        <option value="todos">Todos</option>
                        <option value="activos">Activos</option>
                        <option value="inactivos">Inactivos</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- LISTADO -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Listado de Clientes</h5>
        </div>

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando clientes...</p>
            }
            else if (!ClientesFiltrados.Any())
            {
                <div class="alert alert-info mb-0">
                    No se encontraron clientes.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>NIT</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Dirección</th>
                                <th>Registro</th>
                                <th>Estado</th>

                                @if (PuedeAdministrar)
                                {
                                    <th>Acciones</th>
                                }
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var cliente in ClientesFiltrados)
                            {
                                <tr>
                                    <td>@cliente.IdCliente</td>
                                    <td>@cliente.Nombre</td>
                                    <td>@cliente.Apellido</td>
                                    <td>@Mostrar(cliente.Nit)</td>
                                    <td>@Mostrar(cliente.Telefono)</td>
                                    <td>@Mostrar(cliente.Correo)</td>
                                    <td>@Mostrar(cliente.Direccion)</td>
                                    <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>

                                    <td>
                                        @if (cliente.Estado == true)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    @if (PuedeAdministrar)
                                    {
                                        <td>
                                            <div class="d-flex gap-1">

                                                <button type="button"
                                                        class="btn btn-warning btn-sm"
                                                        @onclick="() => AbrirEditar(cliente)">
                                                    Editar
                                                </button>

                                                @if (cliente.Estado == true)
                                                {
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm"
                                                            @onclick="() => AbrirConfirmacion(cliente)">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-success btn-sm"
                                                            @onclick="() => AbrirConfirmacion(cliente)">
                                                        Activar
                                                    </button>
                                                }

                                            </div>
                                        </td>
                                    }
                                </tr>
                            }

                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>

<!-- MODAL DE REGISTRO Y EDICIÓN -->
@if (mostrarModal && (editando ? PuedeAdministrar : PuedeRegistrar))
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Formulario de cliente">

        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">
                        @(editando ? "Editar Cliente" : "Registrar Nuevo Cliente")
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@guardando"
                            @onclick="CerrarModal">
                    </button>

                </div>

                <EditForm Model="@formulario"
                          OnValidSubmit="GuardarCliente"
                          FormName="clienteForm">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        @if (!string.IsNullOrWhiteSpace(errorModal))
                        {
                            <div class="alert alert-danger">
                                @errorModal
                            </div>
                        }

                        <div class="row g-3">

                            <!-- NOMBRE -->
                            <div class="col-md-6">

                                <label class="form-label">Nombre *</label>

                                <InputText class="form-control"
                                           maxlength="100"
                                           @bind-Value="formulario.Nombre" />

                                <ValidationMessage
                                    For="@(() => formulario.Nombre)"
                                    class="text-danger" />

                            </div>

                            <!-- APELLIDO -->
                            <div class="col-md-6">

                                <label class="form-label">Apellido *</label>

                                <InputText class="form-control"
                                           maxlength="100"
                                           @bind-Value="formulario.Apellido" />

                                <ValidationMessage
                                    For="@(() => formulario.Apellido)"
                                    class="text-danger" />

                            </div>

                            <!-- NIT -->
                            <div class="col-md-6">

                                <label class="form-label">NIT *</label>

                                <InputText class="form-control"
                                           maxlength="10"
                                           @bind-Value="formulario.Nit" />

                                <ValidationMessage
                                    For="@(() => formulario.Nit)"
                                    class="text-danger" />

                            </div>

                            <!-- TELÉFONO -->
                            <div class="col-md-6">

                                <label class="form-label">Teléfono</label>

                                <InputText type="tel"
                                           class="form-control"
                                           maxlength="20"
                                           @bind-Value="formulario.Telefono" />

                                <ValidationMessage
                                    For="@(() => formulario.Telefono)"
                                    class="text-danger" />

                            </div>

                            <!-- CORREO -->
                            <div class="col-12">

                                <label class="form-label">Correo electrónico *</label>

                                <InputText type="email"
                                           class="form-control"
                                           maxlength="150"
                                           @bind-Value="formulario.Correo" />

                                <ValidationMessage
                                    For="@(() => formulario.Correo)"
                                    class="text-danger" />

                            </div>

                            <!-- DIRECCIÓN -->
                            <div class="col-12">

                                <label class="form-label">Dirección *</label>

                                <InputTextArea class="form-control"
                                               rows="3"
                                               maxlength="255"
                                               @bind-Value="formulario.Direccion" />

                                <ValidationMessage
                                    For="@(() => formulario.Direccion)"
                                    class="text-danger" />

                            </div>

                        </div>

                        <p class="text-muted small mt-3 mb-0">
                            Los campos marcados con * son obligatorios.
                        </p>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@guardando"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardando">

                            @(guardando ? "Guardando..." :
                                editando ? "Guardar Cambios" : "Guardar Cliente")

                        </button>

                    </div>

                </EditForm>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

<!-- MODAL PARA ACTIVAR Y DESACTIVAR -->
@if (clienteConfirmacion != null && PuedeAdministrar)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Confirmar estado del cliente">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">Confirmar Acción</h5>

                    <button type="button"
                            class="btn-close"
                            disabled="@procesandoEstado"
                            @onclick="CerrarConfirmacion">
                    </button>

                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(errorConfirmacion))
                    {
                        <div class="alert alert-danger">
                            @errorConfirmacion
                        </div>
                    }

                    <p>
                        ¿Deseas
                        <strong>
                            @(clienteConfirmacion.Estado == true
                                ? "desactivar" : "activar")
                        </strong>
                        al cliente
                        <strong>
                            @clienteConfirmacion.Nombre
                            @clienteConfirmacion.Apellido
                        </strong>?
                    </p>

                    <p class="text-muted small mb-0">
                        El cliente permanecerá registrado en MySQL.
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@procesandoEstado"
                            @onclick="CerrarConfirmacion">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn @(clienteConfirmacion.Estado == true ? "btn-danger" : "btn-success")"
                            disabled="@procesandoEstado"
                            @onclick="CambiarEstado">

                        @(procesandoEstado ? "Procesando..." :
                            clienteConfirmacion.Estado == true
                                ? "Desactivar" : "Activar")

                    </button>

                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {

    // ========================================
    // PERMISOS POR ROL
    // ========================================

    // ADMIN puede registrar, editar y cambiar estados.
    // VENDEDOR puede registrar clientes nuevos, pero no editarlos.
    // CONSULTA únicamente puede leer el listado.

    private bool PuedeAdministrar =>
        Sesion.EstaAutenticado &&
        string.Equals(
            Sesion.Rol,
            "ADMIN",
            StringComparison.OrdinalIgnoreCase
        );

    private bool PuedeRegistrar =>
        Sesion.EstaAutenticado &&
        (
            string.Equals(
                Sesion.Rol,
                "ADMIN",
                StringComparison.OrdinalIgnoreCase
            )
            ||
            string.Equals(
                Sesion.Rol,
                "VENDEDOR",
                StringComparison.OrdinalIgnoreCase
            )
        );

    // ========================================
    // MODELO PARA MOSTRAR CLIENTES
    // ========================================

    public class ClienteDto
    {
        public int IdCliente { get; set; }

        public string Nombre { get; set; } = string.Empty;

        public string Apellido { get; set; } = string.Empty;

        public string? Nit { get; set; }

        public string? Telefono { get; set; }

        public string? Correo { get; set; }

        public string? Direccion { get; set; }

        public DateTime FechaRegistro { get; set; }

        public bool? Estado { get; set; }
    }

    // ========================================
    // FORMULARIO CON VALIDACIONES
    // ========================================

    public class FormularioCliente : IValidatableObject
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage = "El nombre debe tener entre 2 y 100 caracteres."
        )]
        [RegularExpression(
            @"^[\p{L}]+(?:[ '\-][\p{L}]+)*$",
            ErrorMessage = "El nombre solo permite letras, espacios, guiones y apóstrofes."
        )]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El apellido es obligatorio.")]
        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage = "El apellido debe tener entre 2 y 100 caracteres."
        )]
        [RegularExpression(
            @"^[\p{L}]+(?:[ '\-][\p{L}]+)*$",
            ErrorMessage = "El apellido solo permite letras, espacios, guiones y apóstrofes."
        )]
        public string Apellido { get; set; } = string.Empty;

        // Únicamente el registro histórico de Consumidor Final
        // queda exento al editarlo.
        [System.Text.Json.Serialization.JsonIgnore]
        public bool EditandoConsumidorFinal { get; set; }

        [StringLength(20)]
        public string? Nit { get; set; }

        [StringLength(20)]
        public string? Telefono { get; set; }

        [EmailAddress(ErrorMessage = "Ingresa un correo válido.")]
        [StringLength(150)]
        [RegularExpression(
            @"^[^@\s]+@[^@\s]+\.[^@\s]{2,}$",
            ErrorMessage = "El correo debe tener un formato válido."
        )]
        public string? Correo { get; set; }

        [StringLength(255)]
        public string? Direccion { get; set; }

        // ========================================
        // VALIDACIONES DEL FORMULARIO
        // ========================================

        public IEnumerable<ValidationResult> Validate(
            ValidationContext validationContext)
        {
            if (!EditandoConsumidorFinal)
            {
                if (string.IsNullOrWhiteSpace(Nit))
                {
                    yield return new ValidationResult(
                        "El NIT es obligatorio.",
                        new[] { nameof(Nit) }
                    );
                }

                if (string.IsNullOrWhiteSpace(Correo))
                {
                    yield return new ValidationResult(
                        "El correo electrónico es obligatorio.",
                        new[] { nameof(Correo) }
                    );
                }

                if (string.IsNullOrWhiteSpace(Direccion))
                {
                    yield return new ValidationResult(
                        "La dirección es obligatoria.",
                        new[] { nameof(Direccion) }
                    );
                }
            }

            // Validación del NIT con o sin guion.
            if (!string.IsNullOrWhiteSpace(Nit) && !NitValido(Nit))
            {
                yield return new ValidationResult(
                    "El NIT debe contener solo números y tener de 8 a 10 dígitos.",
                    new[] { nameof(Nit) }
                );
            }

            // Validación del teléfono.
            if (!string.IsNullOrWhiteSpace(Telefono))
            {
                bool valido = Regex.IsMatch(
                    Telefono.Trim(),
                    @"^(?:\+502[ -]?)?[2-7][0-9]{3}[ -]?[0-9]{4}$"
                );

                if (!valido)
                {
                    yield return new ValidationResult(
                        "El teléfono debe tener 8 dígitos. Ejemplo: 5555-1234.",
                        new[] { nameof(Telefono) }
                    );
                }
            }

            // Validación de la dirección.
            if (!string.IsNullOrWhiteSpace(Direccion))
            {
                string texto = Direccion.Trim();

                if (texto.Length < 5 || !texto.Any(char.IsLetter))
                {
                    yield return new ValidationResult(
                        "La dirección debe contener al menos 5 caracteres e información descriptiva.",
                        new[] { nameof(Direccion) }
                    );
                }
            }
        }

        // ========================================
        // ========================================
        // NIT NUMÉRICO DE 8 A 10 DÍGITOS
        // ========================================

        private static bool NitValido(string nit)
        {
            return Regex.IsMatch(nit.Trim(), @"^[0-9]{8,10}$");
        }

    }

    // ========================================
    // VARIABLES
    // ========================================

    private List<ClienteDto> clientes = new();

    private FormularioCliente formulario = new();

    private bool cargando = true;

    private bool mostrarModal;

    private bool editando;

    private bool guardando;

    private bool procesandoEstado;

    private int idClienteEditar;

    private ClienteDto? clienteConfirmacion;

    private string busqueda = string.Empty;

    private string filtroEstado = "todos";

    private string? mensaje;

    private string? error;

    private string? errorModal;

    private string? errorConfirmacion;

    // ========================================
    // FILTRAR CLIENTES
    // ========================================

    private IEnumerable<ClienteDto> ClientesFiltrados =>
        clientes.Where(c =>
            (
                filtroEstado == "todos" ||
                (filtroEstado == "activos" && c.Estado == true) ||
                (filtroEstado == "inactivos" && c.Estado != true)
            )
            &&
            (
                string.IsNullOrWhiteSpace(busqueda) ||

                c.Nombre.Contains(
                    busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase
                ) ||

                c.Apellido.Contains(
                    busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase
                ) ||

                (
                    c.Nit?.Contains(
                        busqueda.Trim(),
                        StringComparison.OrdinalIgnoreCase
                    ) ?? false
                ) ||

                (
                    c.Telefono?.Contains(
                        busqueda.Trim(),
                        StringComparison.OrdinalIgnoreCase
                    ) ?? false
                ) ||

                (
                    c.Correo?.Contains(
                        busqueda.Trim(),
                        StringComparison.OrdinalIgnoreCase
                    ) ?? false
                )
            )
        ).OrderBy(c => c.IdCliente);

    // ========================================
    // CARGA INICIAL
    // ========================================

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    // ========================================
    // CONSULTAR CLIENTES
    // ========================================

    private async Task<bool> CargarClientes()
    {
        cargando = true;

        try
        {
            clientes = await Http.GetFromJsonAsync<List<ClienteDto>>(
                "api/Clientes"
            ) ?? new();

            error = null;

            return true;
        }
        catch (Exception)
        {
            error = "No se pudieron consultar los clientes.";

            return false;
        }
        finally
        {
            cargando = false;
        }
    }

    private static string Mostrar(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "—" : valor;
    }

    // ========================================
    // ABRIR MODAL NUEVO
    // ========================================

    private void AbrirNuevo()
    {
        if (!PuedeRegistrar)
            return;

        formulario = new FormularioCliente();

        editando = false;

        idClienteEditar = 0;

        errorModal = null;

        mostrarModal = true;
    }

    // ========================================
    // ABRIR MODAL EDITAR
    // ========================================

    private void AbrirEditar(ClienteDto cliente)
    {
        if (!PuedeAdministrar)
            return;

        formulario = new FormularioCliente
        {
            Nombre = cliente.Nombre,
            Apellido = cliente.Apellido,
            Nit = cliente.Nit,
            Telefono = cliente.Telefono,
            Correo = cliente.Correo,
            Direccion = cliente.Direccion,

            EditandoConsumidorFinal =
                string.Equals(
                    cliente.Nombre.Trim(),
                    "Consumidor",
                    StringComparison.OrdinalIgnoreCase
                )
                &&
                string.Equals(
                    cliente.Apellido.Trim(),
                    "Final",
                    StringComparison.OrdinalIgnoreCase
                )
        };

        editando = true;

        idClienteEditar = cliente.IdCliente;

        errorModal = null;

        mostrarModal = true;
    }

    private void CerrarModal()
    {
        if (guardando)
            return;

        mostrarModal = false;

        errorModal = null;
    }

    // ========================================
    // GUARDAR CLIENTE
    // ========================================

    private async Task GuardarCliente()
    {
        // VENDEDOR puede registrar, pero no editar.
        if (editando ? !PuedeAdministrar : !PuedeRegistrar)
            return;

        if (guardando)
            return;

        guardando = true;

        errorModal = null;

        try
        {
            formulario.Nombre = formulario.Nombre.Trim();

            formulario.Apellido = formulario.Apellido.Trim();

            // ========================================
            // Conservar el NIT numérico, sin agregar guion.
            formulario.Nit = Limpiar(formulario.Nit);
            formulario.Telefono = Limpiar(formulario.Telefono);

            formulario.Correo = Limpiar(formulario.Correo)?.ToLowerInvariant();

            formulario.Direccion = Limpiar(formulario.Direccion);

            HttpResponseMessage respuesta;

            if (editando)
            {
                respuesta = await Http.PutAsJsonAsync(
                    $"api/Clientes/{idClienteEditar}",
                    formulario
                );
            }
            else
            {
                respuesta = await Http.PostAsJsonAsync(
                    "api/Clientes",
                    formulario
                );
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                errorModal = await LeerError(respuesta);

                return;
            }

            bool actualizado = await CargarClientes();

            mostrarModal = false;

            if (actualizado)
            {
                mensaje = editando
                    ? "Cliente actualizado correctamente."
                    : "Cliente registrado correctamente.";
            }
        }
        catch (Exception)
        {
            errorModal = "No fue posible guardar el cliente. Revisa la API.";
        }
        finally
        {
            guardando = false;
        }
    }

    // ========================================
    // CONFIRMACIÓN
    // ========================================

    private void AbrirConfirmacion(ClienteDto cliente)
    {
        if (!PuedeAdministrar)
            return;

        clienteConfirmacion = cliente;

        errorConfirmacion = null;
    }

    private void CerrarConfirmacion()
    {
        if (procesandoEstado)
            return;

        clienteConfirmacion = null;

        errorConfirmacion = null;
    }

    // ========================================
    // ACTIVAR Y DESACTIVAR
    // ========================================

    private async Task CambiarEstado()
    {
        if (!PuedeAdministrar)
            return;

        if (clienteConfirmacion == null || procesandoEstado)
            return;

        procesandoEstado = true;

        errorConfirmacion = null;

        try
        {
            int id = clienteConfirmacion.IdCliente;

            bool activar = clienteConfirmacion.Estado != true;

            HttpResponseMessage respuesta;

            if (activar)
            {
                respuesta = await Http.PutAsync(
                    $"api/Clientes/{id}/activar",
                    null
                );
            }
            else
            {
                respuesta = await Http.DeleteAsync(
                    $"api/Clientes/{id}"
                );
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                errorConfirmacion = await LeerError(respuesta);

                return;
            }

            bool actualizado = await CargarClientes();

            clienteConfirmacion = null;

            if (actualizado)
            {
                mensaje = activar
                    ? "Cliente activado correctamente."
                    : "Cliente desactivado correctamente.";
            }
        }
        catch (Exception)
        {
            errorConfirmacion = "No fue posible conectar con la API.";
        }
        finally
        {
            procesandoEstado = false;
        }
    }

    // ========================================
    // LIMPIAR CAMPOS OPCIONALES
    // ========================================

    private static string? Limpiar(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? null
            : valor.Trim();
    }

    // ========================================
    // LEER ERRORES DEVUELTOS POR LA API
    // ========================================

    private static async Task<string> LeerError(
        HttpResponseMessage respuesta)
    {
        string contenido = await respuesta.Content.ReadAsStringAsync();

        try
        {
            using var documento = JsonDocument.Parse(contenido);

            var raiz = documento.RootElement;

            if (raiz.TryGetProperty("mensaje", out var mensajeApi))
            {
                string? texto = mensajeApi.GetString();

                if (!string.IsNullOrWhiteSpace(texto))
                    return texto;
            }

            if (raiz.TryGetProperty("errors", out var errores) &&
                errores.ValueKind == JsonValueKind.Object)
            {
                foreach (var campo in errores.EnumerateObject())
                {
                    if (campo.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var detalle in campo.Value.EnumerateArray())
                        {
                            if (detalle.ValueKind == JsonValueKind.String)
                            {
                                return detalle.GetString()
                                    ?? "Los datos no son válidos.";
                            }
                        }
                    }
                }
            }
        }
        catch (JsonException)
        {
            // La respuesta no es JSON.
        }

        return $"No se pudo completar la operación. HTTP {(int)respuesta.StatusCode}.";
    }
}