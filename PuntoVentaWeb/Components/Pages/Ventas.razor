    private Microsoft.JSInterop.IJSObjectReference? moduloComprobantes;
    private bool procesandoComprobante;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Importar el módulo desde wwwroot para poder abrir el PDF
                // durante la interacción del usuario.
                moduloComprobantes = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                    "import", "./js/comprobantes.js");
            }
            catch (Microsoft.JSInterop.JSException)
            {
                // Se intentará nuevamente al presionar un botón.
            }
        }
    }

    private async Task GestionarComprobante(int id, bool descargar, string? idVentanaPreparada = null)
    {
        if (procesandoComprobante || id <= 0)
            return;

        if (!Sesion.EstaAutenticado)
        {
            error = "Tu sesión ha finalizado. Iniciá sesión nuevamente.";
            return;
        }

        procesandoComprobante = true;
        error = null;
        // Si el registro reservó una pestaña antes de la llamada a la API,
        // reutilizarla para que el navegador no bloquee la apertura automática.
        string? idVentana = idVentanaPreparada;

        try
        {
            moduloComprobantes ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                "import", "./js/comprobantes.js");

            // Para imprimir, se reutiliza la pestaña reservada al registrar la venta
            // o se abre una pestaña nueva al presionar el botón de imprimir.
            if (!descargar && string.IsNullOrWhiteSpace(idVentana))
            {
                idVentana = await moduloComprobantes.InvokeAsync<string?>("prepararVistaPdf");
                if (string.IsNullOrWhiteSpace(idVentana))
                    throw new InvalidOperationException(
                        "El navegador bloqueó la pestaña del PDF. Permití ventanas emergentes para localhost:5105.");
            }

            // Petición mediante el HttpClient del sistema, configurado con la sesión JWT.
            // No se pone el token en la URL, el HTML ni el código JavaScript.
            using var respuesta = await Http.GetAsync(
                $"api/Comprobantes/venta/{id}",
                System.Net.Http.HttpCompletionOption.ResponseHeadersRead);

            if (!respuesta.IsSuccessStatusCode)
            {
                string detalle = respuesta.StatusCode switch
                {
                    System.Net.HttpStatusCode.Unauthorized => "Tu sesión no está autorizada o ha expirado.",
                    System.Net.HttpStatusCode.Forbidden => "No tenés permiso para consultar este comprobante.",
                    System.Net.HttpStatusCode.NotFound => "La venta solicitada no existe.",
                    _ => "No se pudo obtener el comprobante desde la API."
                };
                throw new InvalidOperationException(detalle);
            }

            byte[] contenido = await respuesta.Content.ReadAsByteArrayAsync();
            if (contenido.Length == 0)
                throw new InvalidOperationException("La API devolvió un comprobante vacío.");

            string base64 = Convert.ToBase64String(contenido);
            string nombreArchivo = $"Comprobante_Venta_{id:000000}.pdf";

            if (descargar)
                await moduloComprobantes.InvokeVoidAsync("descargarPdf", base64, nombreArchivo);
            else
                await moduloComprobantes.InvokeVoidAsync("mostrarPdf", idVentana, base64);
        }
        catch (Exception ex)
        {
            error = ex is Microsoft.JSInterop.JSDisconnectedException
                ? "Se perdió la conexión con el navegador. Actualizá la página e intentá nuevamente."
                : ex.Message;

            if (idVentana != null && moduloComprobantes != null)
            {
                try { await moduloComprobantes.InvokeVoidAsync("cerrarVistaPdf", idVentana); }
                catch (Microsoft.JSInterop.JSException) { }
            }
        }
        finally
        {
            procesandoComprobante = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (moduloComprobantes != null)
        {
            try { await moduloComprobantes.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
    }

