    // ========================================

    // VALIDACIONES DEL FORMULARIO

    // ========================================

    // Datos para alta rápida desde el formulario de ventas.
    public class ClienteRapidoDto : IValidatableObject
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, MinimumLength = 2)]
        [RegularExpression(@"^[\p{L}]+(?:[ '\-][\p{L}]+)*$",
            ErrorMessage = "El nombre solo permite letras, espacios, guiones y apóstrofes.")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "El apellido es obligatorio.")]
        [StringLength(100, MinimumLength = 2)]
        [RegularExpression(@"^[\p{L}]+(?:[ '\-][\p{L}]+)*$",
            ErrorMessage = "El apellido solo permite letras, espacios, guiones y apóstrofes.")]
        public string Apellido { get; set; } = "";

        [Required(ErrorMessage = "El NIT es obligatorio para registrar un cliente.")]
        [StringLength(20)]
        public string? Nit { get; set; }

        [StringLength(20)]
        public string? Telefono { get; set; }

        [Required(ErrorMessage = "El correo electrónico es obligatorio.")]
        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        [StringLength(150)]
        [RegularExpression(@"^[^@\s]+@[^@\s]+\.[^@\s]{2,}$",
            ErrorMessage = "El correo debe tener un formato válido.")]
        public string? Correo { get; set; }

        [Required(ErrorMessage = "La dirección es obligatoria.")]
        [StringLength(255)]
        public string? Direccion { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext context)
        {
            if (!string.IsNullOrWhiteSpace(Nit) && !NitValido(Nit))
                yield return new ValidationResult(
                    "Ingresa un NIT guatemalteco con dígito verificador válido.",
                    new[] { nameof(Nit) });

            if (!string.IsNullOrWhiteSpace(Telefono) &&
                !Regex.IsMatch(Telefono.Trim(), @"^(?:\+502[ -]?)?[2-7][0-9]{3}[ -]?[0-9]{4}$"))
                yield return new ValidationResult(
                    "Ingresa un teléfono de 8 dígitos, por ejemplo 5555-1234.",
                    new[] { nameof(Telefono) });

            if (!string.IsNullOrWhiteSpace(Direccion) &&
                (Direccion.Trim().Length < 5 || !Direccion.Any(char.IsLetter)))
                yield return new ValidationResult(
                    "La dirección debe tener al menos 5 caracteres descriptivos.",
                    new[] { nameof(Direccion) });
        }

        public static bool NitValido(string nit)
        {
            nit = nit.Trim().ToUpperInvariant();
            if (!Regex.IsMatch(nit, @"^[0-9]{2,12}-[0-9K]$")) return false;
            var partes = nit.Split('-');
            var numeros = partes[0];
            int suma = 0;
            for (int i = 0; i < numeros.Length; i++)
                suma += (numeros[i] - '0') * (numeros.Length - i + 1);
            int resultado = 11 - (suma % 11);
            if (resultado == 11) resultado = 0;
            char esperado = resultado == 10 ? 'K' : (char)('0' + resultado);
            return partes[1][0] == esperado;
        }
    }

    public class FormularioVenta : IValidatableObject

    {

        [Range(1, int.MaxValue,

            ErrorMessage = "Selecciona un cliente.")]

        public int IdCliente { get; set; }

        [Range(1, int.MaxValue,

            ErrorMessage = "Selecciona un empleado.")]

