        {

            new LineaVentaFormulario()

        };

        public IEnumerable<ValidationResult> Validate(

            ValidationContext context)

        {

            if (Detalles == null || Detalles.Count == 0)

            {

                yield return new ValidationResult(

                    "Agrega al menos un producto.",

                    new[] { nameof(Detalles) });

                yield break;

            }

            if (Detalles.Count > 50)

            {

                yield return new ValidationResult(

                    "Máximo 50 productos por venta.",

                    new[] { nameof(Detalles) });

            }

            var productos = new HashSet<int>();

            decimal total = 0m;

            foreach (var linea in Detalles)

            {

                if (linea.IdProducto <= 0)

                {

                    yield return new ValidationResult(

                        "Selecciona un producto en cada fila.",

                        new[] { nameof(Detalles) });

                }

                else if (!productos.Add(linea.IdProducto))

                {

                    yield return new ValidationResult(

                        "No agregues el mismo producto dos veces.",

                        new[] { nameof(Detalles) });

                }

                if (linea.Cantidad < 1 ||

                    linea.Cantidad > 1000000)

                {

                    yield return new ValidationResult(

                        "La cantidad debe estar entre 1 y 1,000,000.",

                        new[] { nameof(Detalles) });

                }

                if (linea.PrecioVenta <= 0 ||

                    linea.PrecioVenta > 9999999999.99m ||

                    decimal.Round(linea.PrecioVenta, 2) !=

                    linea.PrecioVenta)

                {

                    yield return new ValidationResult(

                        "El precio debe ser positivo y tener máximo dos decimales.",

                        new[] { nameof(Detalles) });

                }

                if (linea.Cantidad > 0 && linea.PrecioVenta > 0)

                {

                    decimal subtotal =

                        linea.Cantidad * linea.PrecioVenta;

                    if (subtotal > 9999999999.99m)

                    {

                        yield return new ValidationResult(

                            "El subtotal supera el límite permitido.",

                            new[] { nameof(Detalles) });

                    }

                    total += subtotal;

                }

            }

            if (total > 9999999999.99m)

            {

                yield return new ValidationResult(

                    "El total supera el límite permitido.",

                    new[] { nameof(Detalles) });

            }

        }

    }

