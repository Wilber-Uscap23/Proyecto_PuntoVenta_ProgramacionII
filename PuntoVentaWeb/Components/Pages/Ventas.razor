

@page "/ventas"

@rendermode InteractiveServer

@using System.Net.Http.Json

@using System.ComponentModel.DataAnnotations

@using System.Globalization

@using System.Text.Json

@using System.Text.Json.Serialization
@using System.Text.RegularExpressions
@using PuntoVentaWeb.Servicios

@inject HttpClient Http
@inject SesionUsuario Sesion
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Ventas - Sistema Punto de Venta</PageTitle>

<style>
    /* El EditForm de Blazor envuelve modal-body y modal-footer.
       Por eso debe participar en el layout flex del modal de Bootstrap.
       Así el contenido se desplaza y los botones siguen visibles. */
    .pv-venta-modal .modal-dialog {
        height: calc(100vh - 1.5rem);
        height: calc(100dvh - 1.5rem);
        max-height: calc(100vh - 1.5rem);
        max-height: calc(100dvh - 1.5rem);
        margin-top: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .pv-venta-modal .modal-content {
        max-height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .pv-venta-modal .pv-venta-form {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }

    .pv-venta-modal .pv-venta-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .pv-venta-modal .pv-venta-footer {
        flex: 0 0 auto;
        background: var(--bs-modal-bg, #fff);
    }
</style>


<div class="container-fluid mt-4">

    <!-- ENCABEZADO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Administración de Ventas</h2>

        </div>

        @if (PuedeRegistrarVenta)
        {
            <button type="button" class="btn btn-primary" @onclick="AbrirNueva">
                + Nueva Venta
            </button>
        }
    </div>

    <!-- MENSAJES -->

    @if (!string.IsNullOrWhiteSpace(mensaje))

    {

        <div class="alert alert-success alert-dismissible">

            @mensaje

            <button type="button"

                    class="btn-close"

                    @onclick="() => mensaje = null">

            </button>

        </div>

    }

    @if (!string.IsNullOrWhiteSpace(error))

    {

        <div class="alert alert-danger alert-dismissible">

            @error

            <button type="button"

                    class="btn-close"

                    @onclick="() => error = null">

            </button>

        </div>

    }

    <!-- COMPROBANTE DISPONIBLE DESPUÉS DE GUARDAR -->

    @if (ultimaVentaId is int numeroComprobante)

    {

        <div class="card border-success shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div>

                        <h5 class="text-success mb-1">

                            Comprobante de venta listo

                        </h5>

                    </div>

                    <div class="d-flex gap-2 flex-wrap">

                        <button type="button" class="btn btn-primary"
                                disabled="@procesandoComprobante"
                                @onclick="() => GestionarComprobante(numeroComprobante, false)">
                                Ver / Imprimir PDF
                            </button>

                        <button type="button" class="btn btn-success"
                                disabled="@procesandoComprobante"
                                @onclick="() => GestionarComprobante(numeroComprobante, true)">
                                Descargar PDF
                            </button>

                        <button type="button"

                                class="btn btn-outline-secondary"

                                @onclick="() => ultimaVentaId = null">

                            Cerrar

                        </button>

                    </div>

                </div>

            </div>

        </div>

    }

    <!-- FILTROS -->

    <div class="card shadow-sm mb-3">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-8">

                    <label class="form-label">Buscar venta</label>

                    <input class="form-control"

                           placeholder="Número, cliente o empleado..."

                           @bind="busqueda"

                           @bind:event="oninput" />

                </div>

                <div class="col-md-4">

                    <label class="form-label">Estado</label>

                    <select class="form-select"

                            @bind="filtroEstado">

                        <option value="TODAS">Todas</option>

                        <option value="REGISTRADA">Registradas</option>

                        <option value="ANULADA">Anuladas</option>

                    </select>

                </div>

            </div>

        </div>

    </div>

    <!-- LISTADO DE VENTAS -->

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">Listado de Ventas</h5>

        </div>

        <div class="card-body">

            @if (cargando)

            {

                <p>Cargando ventas...</p>

            }

            else if (!VentasFiltradas.Any())

            {

                <div class="alert alert-info mb-0">

                    No se encontraron ventas.

                </div>

            }

            else

            {

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>No.</th>

                                <th>Fecha</th>

                                <th>Cliente</th>

                                <th>Empleado</th>

                                <th>Productos</th>

                                <th>Total</th>

                                <th>Estado</th>

                                <th>Acciones</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var venta in VentasFiltradas)

                            {

                                <tr>

                                    <td>@venta.IdVenta</td>

                                    <td>

                                        @venta.FechaVenta.ToString("dd/MM/yyyy HH:mm")

                                    </td>

                                    <td>@venta.NombreCliente</td>

                                    <td>@venta.NombreEmpleado</td>

                                    <td>@venta.CantidadProductos</td>

                                    <td>

                                        <strong>@Q(venta.Total)</strong>

                                    </td>

                                    <td>

                                        @if (venta.Estado == "REGISTRADA")

                                        {

                                            <span class="badge bg-success">

                                                Registrada

                                            </span>

                                        }

                                        else

                                        {

                                            <span class="badge bg-danger">

                                                @venta.Estado

                                            </span>

                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex gap-1 flex-wrap">

                                            <button type="button"

                                                    class="btn btn-info btn-sm"

                                                    @onclick="() => VerDetalle(venta.IdVenta)">

                                                Ver

                                            </button>

                                            <!-- NUEVO: IMPRIMIR O REIMPRIMIR -->

                                            <button type="button" class="btn btn-primary btn-sm"
                                disabled="@procesandoComprobante"
                                @onclick="() => GestionarComprobante(venta.IdVenta, false)">
                                Imprimir PDF
                            </button>

                                            <!-- NUEVO: DESCARGAR PDF -->

                                            <button type="button" class="btn btn-outline-primary btn-sm"
                                disabled="@procesandoComprobante"
                                @onclick="() => GestionarComprobante(venta.IdVenta, true)">
                                Descargar
                            </button>

                                            @if (PuedeAdministrar && venta.Estado == "REGISTRADA")

                                            {

                                                <button type="button"

                                                        class="btn btn-warning btn-sm"

                                                        @onclick="() => AbrirEditar(venta.IdVenta)">

                                                    Editar

                                                </button>

                                                <button type="button"

                                                        class="btn btn-danger btn-sm"

                                                        @onclick="() => PedirAnulacion(venta)">

                                                    Anular

                                                </button>

                                            }

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>

<!-- ========================================== -->

<!-- MODAL CREAR / EDITAR VENTA                 -->

<!-- ========================================== -->

@if (mostrarFormulario)

{

    <div class="modal fade show d-block pv-venta-modal"

         tabindex="-1"

         role="dialog"

         aria-modal="true"

         aria-label="Formulario de venta">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">

                        @(editando ? "Editar Venta" : "Registrar Nueva Venta")

                    </h5>

                    <button type="button"

                            class="btn-close btn-close-white"

                            disabled="@guardando"

                            @onclick="CerrarFormulario">

                    </button>

                </div>

                <EditForm Model="@formulario"

                          @key="formulario"

                          OnValidSubmit="GuardarVenta"

                          FormName="ventaForm"

                          class="pv-venta-form">

                    <DataAnnotationsValidator />

                    <div class="modal-body pv-venta-body">

                        @if (!string.IsNullOrWhiteSpace(errorModal))

                        {

                            <div class="alert alert-danger">

                                @errorModal

                            </div>

                        }

                        <h5 class="mb-3">Datos de la venta</h5>

                        <div class="row g-3 mb-4">

                            <!-- CLIENTE: BÚSQUEDA POR NOMBRE O NIT Y CONSUMIDOR FINAL -->
                            <div class="col-md-6">
                                <label class="form-label">Cliente *</label>
                                @if (!editando)
                                {
                                    <select class="form-select mb-2" value="@tipoCliente"
                                            disabled="@(preparandoCF || guardando)"
                                            @onchange="CambiarTipoCliente">
                                        <option value="REGISTRADO">Buscar cliente / registrar nuevo</option>
                                        <option value="CF">Consumidor Final (CF)</option>
                                    </select>
                                }
                                @if (tipoCliente == "CF")
                                {
                                    <div class="alert alert-info py-2 mb-1">
                                        <strong>Consumidor Final (CF).</strong>
                                        No se requiere NIT ni información personal para ventas de hasta Q2,500.00.
                                        @if (preparandoCF)
                                        {
                                            <span> Preparando registro CF...</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <label class="form-label small mb-1" for="buscar-cliente-venta">
                                        Buscar por NIT, nombre o apellido
                                    </label>
                                    <input id="buscar-cliente-venta" type="search"
                                           class="form-control mb-2"
                                           autocomplete="off"
                                           value="@nitBusqueda"
                                           @oninput="ActualizarBusquedaCliente"
                                           disabled="@guardando" />

                                    @if (nitBusqueda.Trim().Length >= 2)
                                    {
                                        var encontrados = ClientesCoincidentes;
                                        @if (encontrados.Count > 0)
                                        {
                                            <div class="list-group mb-2" style="max-height:220px;overflow-y:auto;">
                                                @foreach (var cliente in encontrados)
                                                {
                                                    <button type="button"
                                                            class="list-group-item list-group-item-action text-start"
                                                            disabled="@guardando"
                                                            @onclick="() => ElegirCliente(cliente)">
                                                        <strong>@cliente.Nombre @cliente.Apellido</strong>
                                                        <span class="text-muted small ms-2">NIT: @Mostrar(cliente.Nit)</span>
                                                    </button>
                                                }
                                            </div>
                                            <div class="form-text mb-2">Elegí el cliente correcto entre las coincidencias.</div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning py-2 mb-2">
                                                No se encontraron clientes activos con ese NIT o nombre.
                                                @if (!editando)
                                                {
                                                    <span> Podés registrar uno nuevo o continuar como CF.</span>
                                                }
                                            </div>
                                        }
                                    }

                                    @if (!string.IsNullOrWhiteSpace(mensajeNitBusqueda))
                                    {
                                        <div class="alert alert-warning py-2 mb-2">@mensajeNitBusqueda</div>
                                    }

                                    @if (ClienteSeleccionado is ClienteOpcion clienteActual)
                                    {
                                        <div class="border border-success rounded p-2 mb-2">
                                            <div class="text-success fw-semibold">
                                                Cliente seleccionado: @clienteActual.Nombre @clienteActual.Apellido
                                            </div>
                                            <div class="small">NIT: @Mostrar(clienteActual.Nit)</div>
                                            <div class="small">Teléfono: @Mostrar(clienteActual.Telefono)</div>
                                            <div class="small">Correo: @Mostrar(clienteActual.Correo)</div>
                                            <div class="small">Dirección: @Mostrar(clienteActual.Direccion)</div>
                                        </div>
                                    }

                                    @if (!editando && PuedeRegistrarVenta)
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            <button type="button" class="btn btn-outline-primary btn-sm"
                                                    disabled="@guardando"
                                                    @onclick="AbrirClienteRapido">
                                                + Registrar cliente nuevo
                                            </button>
                                            @if (nitBusqueda.Trim().Length >= 2 && ClientesCoincidentes.Count == 0)
                                            {
                                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        disabled="@guardando"
                                                        @onclick="SeleccionarConsumidorFinal">
                                                    Continuar como CF
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                                <ValidationMessage For="@(() => formulario.IdCliente)" class="text-danger" />
                            </div>

                            <!-- EMPLEADO -->
                            <div class="col-md-6">
                                <label class="form-label">Empleado que vende *</label>
                                @if (PuedeAdministrar)
                                {
                                    <InputSelect class="form-select" @bind-Value="formulario.IdEmpleado">
                                        <option value="0">-- Selecciona un empleado --</option>
                                        @foreach (var empleado in empleados.Where(e =>
                                            e.Estado == true || (editando && e.IdEmpleado == formulario.IdEmpleado)))
                                        {
                                            <option value="@empleado.IdEmpleado">
                                                @empleado.Nombre @empleado.Apellido
                                                @(empleado.Estado == true ? "" : " (Inactivo)")
                                            </option>
                                        }
                                    </InputSelect>
                                }
                                else
                                {
                                    <input class="form-control" readonly
                                           value="@NombreEmpleadoSesion" />
                                    <div class="form-text">Se utiliza el empleado de la sesión actual.</div>
                                }
                                <ValidationMessage For="@(() => formulario.IdEmpleado)" class="text-danger" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fecha de venta</label>
                                <input class="form-control" value="@FechaVentaVisible" readonly />
                            </div>

                        </div>

                        <!-- DETALLE -->

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <h5 class="mb-0">Productos de la venta</h5>

                            <button type="button"

                                    class="btn btn-outline-primary btn-sm"

                                    disabled="@(formulario.Detalles.Count >= 50 || guardando)"

                                    @onclick="AgregarLinea">

                                + Agregar Producto

                            </button>

                        </div>

                        <div class="table-responsive">

                            <table class="table table-bordered align-middle">

                                <thead class="table-dark">

                                    <tr>

                                        <th style="min-width:240px;">Producto</th>

                                        <th style="min-width:120px;">Cantidad</th>

                                        <th style="min-width:145px;">Precio (Q)</th>

                                        <th style="min-width:130px;">Subtotal</th>

                                        <th style="width:75px;">Acción</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var linea in formulario.Detalles)

                                    {

                                        <tr @key="linea.Clave">

                                            <td>
                                                <input type="search"
                                                       class="form-control form-control-sm mb-1"
                                                       placeholder="Buscar por código o descripción..."
                                                       aria-label="Buscar producto para la venta"
                                                       autocomplete="off"
                                                       @bind="linea.BusquedaProducto"
                                                       @bind:event="oninput" />

                                                <select class="form-select"
                                                        value="@linea.IdProducto"
                                                        @onchange="e => SeleccionarProducto(linea, e)">
                                                    <option value="0">-- Selecciona un producto --</option>
                                                    @foreach (var producto in ProductosFiltradosVenta(linea))
                                                    {
                                                        <option value="@producto.IdProducto">
                                                            @producto.Codigo - @producto.Descripcion
                                                            @(producto.Estado == true ? "" : " (Inactivo)")
                                                        </option>
                                                    }
                                                </select>

                                                <div class="form-text">

                                                    Disponible:

                                                    @StockDisponible(linea.IdProducto)

                                                    unidades

                                                </div>

                                            </td>

                                            <td>

                                                <InputNumber class="form-control"

                                                             min="1"

                                                             max="1000000"

                                                             step="1"

                                                             @bind-Value="linea.Cantidad" />

                                            </td>

                                            <td>

                                                <InputNumber class="form-control"

                                                             min="0.01"

                                                             step="0.01"

                                                             @bind-Value="linea.PrecioVenta"
                                                              readonly="@(!PuedeAdministrar)" />

                                            </td>

                                            <td>

                                                <strong>@Q(Subtotal(linea))</strong>

                                            </td>

                                            <td>

                                                <button type="button"

                                                        class="btn btn-outline-danger btn-sm"

                                                        disabled="@(formulario.Detalles.Count <= 1 || guardando)"

                                                        @onclick="() => QuitarLinea(linea.Clave)">

                                                    Quitar

                                                </button>

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                        <ValidationMessage

                            For="@(() => formulario.Detalles)"

                            class="text-danger" />

                        <!-- TOTAL -->

                        <div class="d-flex justify-content-end mt-3">

                            <div class="text-end">

                                <div class="text-muted">

                                    Total de la venta

                                </div>

                                <h3 class="text-primary">

                                    @Q(TotalFormulario)

                                </h3>
                                @if (SuperaLimiteConsumidorFinal)
                                {
                                    <div class="alert alert-danger mt-2 mb-0 text-start" role="alert">
                                        <strong>Venta bloqueada:</strong> Consumidor Final (CF) permite un máximo de Q2,500.00.
                                        Seleccioná o registrá un cliente con NIT válido para continuar.
                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                    <div class="modal-footer pv-venta-footer">

                        <button type="button"

                                class="btn btn-secondary"

                                disabled="@guardando"

                                @onclick="CerrarFormulario">

                            Cancelar

                        </button>

                        <button type="submit"

                                class="btn btn-success"

                                disabled="@(guardando || preparandoCF || formulario.IdCliente == 0 || SuperaLimiteConsumidorFinal)">

                                @(guardando

                                ? "Guardando..."

                                : editando

                                    ? "Guardar Cambios"

                                    : "Registrar Venta")

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>

    <div class="modal-backdrop fade show"></div>

}

<!-- ========================================== -->
<!-- MODAL REGISTRAR CLIENTE DESDE VENTAS       -->
<!-- ========================================== -->
@if (mostrarClienteRapido)
{
    <div class="modal fade show d-block" style="z-index:1070;"
         tabindex="-1" role="dialog" aria-modal="true" aria-label="Registrar cliente">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Registrar Cliente sin salir de Ventas</h5>
                    <button type="button" class="btn-close btn-close-white"
                            disabled="@guardandoCliente" @onclick="CerrarClienteRapido"></button>
                </div>
                <EditForm Model="@clienteRapido" @key="clienteRapido"
                          OnValidSubmit="GuardarClienteRapido" FormName="clienteVentaForm">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(errorClienteRapido))
                        {
                            <div class="alert alert-danger">@errorClienteRapido</div>
                        }
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="clienteRapido.Nombre" />
                                <ValidationMessage For="@(() => clienteRapido.Nombre)" class="text-danger" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellido *</label>
                                <InputText class="form-control" @bind-Value="clienteRapido.Apellido" />
                                <ValidationMessage For="@(() => clienteRapido.Apellido)" class="text-danger" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">NIT *</label>
                                <InputText class="form-control" @bind-Value="clienteRapido.Nit"
                                           placeholder="Ej. 1234578-4" />
                                <ValidationMessage For="@(() => clienteRapido.Nit)" class="text-danger" />
                                <div class="form-text">Ingresá el NIT con dígito verificador válido.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono (opcional)</label>
                                <InputText class="form-control" @bind-Value="clienteRapido.Telefono"
                                           placeholder="Ej. 5555-1234" />
                                <ValidationMessage For="@(() => clienteRapido.Telefono)" class="text-danger" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Correo electrónico *</label>
                                <InputText class="form-control" type="email" @bind-Value="clienteRapido.Correo" />
                                <ValidationMessage For="@(() => clienteRapido.Correo)" class="text-danger" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Dirección *</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="clienteRapido.Direccion" />
                                <ValidationMessage For="@(() => clienteRapido.Direccion)" class="text-danger" />
                            </div>
                        </div>
                        <div class="small text-muted mt-3">Los campos marcados con * son obligatorios. Al guardar, se seleccionará automáticamente para esta venta.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary"
                                disabled="@guardandoCliente" @onclick="CerrarClienteRapido">Cancelar</button>
                        <button type="submit" class="btn btn-success" disabled="@guardandoCliente">
                            @(guardandoCliente ? "Guardando..." : "Guardar y seleccionar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" style="z-index:1060;"></div>
}

<!-- ========================================== -->

<!-- MODAL VER DETALLE                         -->

<!-- ========================================== -->

@if (mostrarDetalle)

{

    <div class="modal fade show d-block"

         tabindex="-1"

         role="dialog"

         aria-modal="true"

         aria-label="Detalle de venta">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">Detalle de Venta</h5>

                    <button type="button"

                            class="btn-close btn-close-white"

                            @onclick="CerrarDetalle">

                    </button>

                </div>

                <div class="modal-body">

                    @if (cargandoDetalle)

                    {

                        <p>Cargando detalle...</p>

                    }

                    else if (!string.IsNullOrWhiteSpace(errorDetalle))

                    {

                        <div class="alert alert-danger">

                            @errorDetalle

                        </div>

                    }

                    else if (detalleSeleccionado != null)

                    {

                        <div class="row g-3 mb-3">

                            <div class="col-md-3">

                                <strong>Venta:</strong>

                                @detalleSeleccionado.IdVenta

                            </div>

                            <div class="col-md-3">

                                <strong>Cliente:</strong>

                                @detalleSeleccionado.NombreCliente

