    // ANULAR VENTA

    // ========================================

    private void PedirAnulacion(VentaResumen venta)

    {
        if (!PuedeAdministrar) return;

        ventaAnular = venta;

        errorAnulacion = null;

    }

    private void CerrarAnulacion()

    {

        if (anulando)

            return;

        ventaAnular = null;

        errorAnulacion = null;

    }

    private async Task ConfirmarAnulacion()

    {
        if (!PuedeAdministrar) return;

        if (ventaAnular == null || anulando)

            return;

        anulando = true;

        errorAnulacion = null;

        try

        {

            int id = ventaAnular.IdVenta;

            using var respuesta = await Http.PutAsync(

                $"api/Ventas/{id}/anular",

                null);

            if (!respuesta.IsSuccessStatusCode)

            {

                errorAnulacion = await LeerError(respuesta);

                return;

            }

            bool ventasActualizadas = await CargarVentas();

            bool catalogosActualizados = await CargarCatalogos();

            ventaAnular = null;

            ultimaVentaId = id;

            if (ventasActualizadas && catalogosActualizados)

            {

                mensaje = "Venta anulada. El comprobante ahora aparecerá marcado como ANULADA.";

            }

            else

            {

                error = "La venta fue anulada, pero no se pudo actualizar el listado. Recargá la página.";

            }

        }

        catch (Exception)

        {

            errorAnulacion = "No se pudo anular la venta. Revisá la API.";

        }

        finally

        {

            anulando = false;

        }

    }

    // ========================================

    // MENSAJES DE ERROR DE LA API

    // ========================================

    private static async Task<string> LeerError(

        HttpResponseMessage respuesta)

    {

        string contenido =

            await respuesta.Content.ReadAsStringAsync();

        try

        {

            using var documento = JsonDocument.Parse(contenido);

            var raiz = documento.RootElement;

            if (raiz.TryGetProperty("mensaje", out var mensajeApi))

            {

                string? texto = mensajeApi.GetString();

                if (!string.IsNullOrWhiteSpace(texto))

                    return texto;

            }

            if (raiz.TryGetProperty("errors", out var errores) &&

                errores.ValueKind == JsonValueKind.Object)

            {

                foreach (var campo in errores.EnumerateObject())

                {

                    if (campo.Value.ValueKind != JsonValueKind.Array)

                        continue;

                    foreach (var detalle in campo.Value.EnumerateArray())

                    {

                        if (detalle.ValueKind == JsonValueKind.String)

                        {

                            return detalle.GetString()

                                ?? "Los datos no son válidos.";

                        }

                    }

                }

            }

        }

        catch (JsonException)

        {

            // La respuesta no es JSON.

        }

        return $"No se pudo completar la operación. HTTP {(int)respuesta.StatusCode}.";

    }

}
