    // ========================================

    // NUEVA VENTA

    // ========================================

    // ============================================================
    // CLIENTES EN VENTAS / CONSUMIDOR FINAL
    // ============================================================
    // Ignorar guion y espacios al comparar; no confundir mayúscula K.
    private static string NormalizarNitBusqueda(string? valor) =>
        new string((valor ?? "").Trim().ToUpperInvariant()
            .Where(c => c != '-' && !char.IsWhiteSpace(c)).ToArray());

    private static string NitConGuion(string? valor)
    {
        var limpio = NormalizarNitBusqueda(valor);
        return limpio.Length > 1
            ? limpio[..^1] + "-" + limpio[^1]
            : limpio;
    }

    // Búsqueda instantánea por nombre, apellido o NIT (con o sin guion).
    private List<ClienteOpcion> ClientesCoincidentes
    {
        get
        {
            string texto = nitBusqueda.Trim();
            if (texto.Length < 2) return new();
            string nitBuscado = NormalizarNitBusqueda(texto);

            return clientes
                .Where(c => !EsClienteCF(c) &&
                    (c.Estado == true || (editando && c.IdCliente == idClienteOriginalEdicion)) &&
                    (
                        c.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                        c.Apellido.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                        ($"{c.Nombre} {c.Apellido}").Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                        (!string.IsNullOrWhiteSpace(c.Nit) &&
                         NormalizarNitBusqueda(c.Nit).Contains(nitBuscado, StringComparison.OrdinalIgnoreCase))
                    ))
                .OrderBy(c => c.Nombre)
                .ThenBy(c => c.Apellido)
                .Take(15)
                .ToList();
        }
    }

    private void ActualizarBusquedaCliente(ChangeEventArgs evento)
    {
        nitBusqueda = evento.Value?.ToString() ?? "";
        mensajeNitBusqueda = null;
        // La selección anterior deja de ser válida al buscar otra persona.
        formulario.IdCliente = 0;
    }

    private void ElegirCliente(ClienteOpcion cliente)
    {
        if (guardando || !PuedeRegistrarVenta ||
            (cliente.Estado != true && !(editando && cliente.IdCliente == idClienteOriginalEdicion)))
            return;

        formulario.IdCliente = cliente.IdCliente;
        nitBusqueda = "";
        mensajeNitBusqueda = null;
        errorModal = null;
    }

    private async Task SeleccionarConsumidorFinal()
    {
        if (!PuedeRegistrarVenta || editando || guardando) return;
        await CambiarTipoCliente(new ChangeEventArgs { Value = "CF" });
    }

    private static bool EsClienteCF(ClienteOpcion c) =>
        string.Equals(c.Nombre.Trim(), "Consumidor", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(c.Apellido.Trim(), "Final", StringComparison.OrdinalIgnoreCase);

    private async Task CambiarTipoCliente(ChangeEventArgs e)
    {
        if (!PuedeRegistrarVenta || editando) return;
        tipoCliente = e.Value?.ToString() == "CF" ? "CF" : "REGISTRADO";
        formulario.IdCliente = 0;
        nitBusqueda = "";
        mensajeNitBusqueda = null;
        errorModal = null;
        if (tipoCliente == "CF")
        {
            preparandoCF = true;
            try
            {
                var cf = clientes.FirstOrDefault(EsClienteCF);
                if (cf != null && cf.Estado != true)
                {
                    errorModal = "El registro Consumidor Final está inactivo. Solicitá a ADMIN que lo active.";
                    return;
                }
                if (cf == null)
                {
                    // Primera vez: crear un único cliente genérico sin NIT.
                    // Se reutiliza en ventas futuras; no se crean clientes por cada venta.
                    using var respuesta = await Http.PostAsJsonAsync("api/Clientes", new
                    {
                        Nombre = "Consumidor", Apellido = "Final",
                        Nit = (string?)null, Telefono = (string?)null,
                        Correo = (string?)null, Direccion = (string?)null
                    });
                    if (!respuesta.IsSuccessStatusCode)
                    {
                        errorModal = await LeerError(respuesta);
                        return;
                    }
                    var actualizados = await Http.GetFromJsonAsync<List<ClienteOpcion>>("api/Clientes");
                    if (actualizados != null) clientes = actualizados;
                    cf = clientes.FirstOrDefault(EsClienteCF);
                }
                if (cf == null || cf.IdCliente <= 0)
                {
                    errorModal = "No se pudo localizar el registro CF creado. Actualizá los clientes y revisá antes de repetir.";
                    return;
                }
                formulario.IdCliente = cf.IdCliente;
            }
            catch (Exception)
            {
                errorModal = "No se pudo preparar Consumidor Final. Revisá la conexión con la API.";
            }
            finally
            {
                preparandoCF = false;
            }
        }
    }

    private void AbrirClienteRapido()
    {
        if (!PuedeRegistrarVenta || editando || guardando) return;
        clienteRapido = new ClienteRapidoDto();
        errorClienteRapido = null;
        // Reutilizar el NIT buscado, evitando escribirlo dos veces.
        // Si se buscó por nombre, abrimos el registro sin intentar usarlo como NIT.
        // Únicamente precargamos NIT cuando el texto tiene formato numérico válido.
        string nitSinGuion = NormalizarNitBusqueda(nitBusqueda);
        if (Regex.IsMatch(nitSinGuion, @"^[0-9]{2,12}[0-9K]$"))
        {
            string formateado = NitConGuion(nitBusqueda);
            if (!ClienteRapidoDto.NitValido(formateado))
            {
                mensajeNitBusqueda = "El NIT ingresado no es válido. Revisá el dígito verificador.";
                return;
            }
            var yaExiste = clientes.FirstOrDefault(c =>
                !string.IsNullOrWhiteSpace(c.Nit) &&
                NormalizarNitBusqueda(c.Nit) == nitSinGuion);
            if (yaExiste != null)
            {
                if (yaExiste.Estado == true)
                {
                    formulario.IdCliente = yaExiste.IdCliente;
                    nitBusqueda = "";
                    mensajeNitBusqueda = null;
                }
                else
                    mensajeNitBusqueda = "El cliente existe, pero está inactivo. Solicitá a ADMIN activarlo.";
                return;
            }
            clienteRapido.Nit = formateado;
        }
        mostrarClienteRapido = true;
    }

    private void CerrarClienteRapido()
    {
        if (guardandoCliente) return;
        mostrarClienteRapido = false;
        errorClienteRapido = null;
    }

    private static string? LimpiarOpcional(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    private async Task GuardarClienteRapido()
    {
        if (!PuedeRegistrarVenta || editando || guardandoCliente) return;
        if (string.IsNullOrWhiteSpace(clienteRapido.Nit) ||
            string.IsNullOrWhiteSpace(clienteRapido.Correo) ||
            string.IsNullOrWhiteSpace(clienteRapido.Direccion))
        {
            errorClienteRapido = "Para registrar al cliente completá NIT, correo electrónico y dirección.";
            return;
        }
        guardandoCliente = true;
        errorClienteRapido = null;
        try
        {
            var datos = new
            {
                Nombre = clienteRapido.Nombre.Trim(),
                Apellido = clienteRapido.Apellido.Trim(),
                Nit = LimpiarOpcional(clienteRapido.Nit)?.ToUpperInvariant(),
                Telefono = LimpiarOpcional(clienteRapido.Telefono),
                Correo = LimpiarOpcional(clienteRapido.Correo)?.ToLowerInvariant(),
                Direccion = LimpiarOpcional(clienteRapido.Direccion)
            };
            using var respuesta = await Http.PostAsJsonAsync("api/Clientes", datos);
            if (!respuesta.IsSuccessStatusCode)
            {
                errorClienteRapido = await LeerError(respuesta);
                return;
            }
            int nuevoId = 0;
            using (var doc = JsonDocument.Parse(await respuesta.Content.ReadAsStringAsync()))
            {
                if (doc.RootElement.TryGetProperty("idCliente", out var propiedad) &&
                    propiedad.TryGetInt32(out var id)) nuevoId = id;
            }
            // Refrescar el catálogo para que el nuevo cliente aparezca en el selector.
            var actualizados = await Http.GetFromJsonAsync<List<ClienteOpcion>>("api/Clientes");
            if (actualizados != null) clientes = actualizados;
            var cliente = clientes.FirstOrDefault(c => c.IdCliente == nuevoId);
            if (cliente == null)
            {
                errorClienteRapido = "El cliente fue guardado, pero no se pudo seleccionar. Cerrá y abrí Nueva Venta antes de volver a intentar.";
                return;
            }
            tipoCliente = "REGISTRADO";
            formulario.IdCliente = cliente.IdCliente;
            nitBusqueda = "";
            mensajeNitBusqueda = null;
            mostrarClienteRapido = false;
            errorModal = null;
        }
        catch (Exception)
        {
            errorClienteRapido = "No se pudo confirmar el registro. Revisá el listado de Clientes antes de intentar de nuevo.";
        }
        finally
        {
            guardandoCliente = false;
        }
    }

    // Para la interfaz usamos el empleado vinculado a la sesión.
    // El servidor debe verificar igualmente el idEmpleado del JWT.
    private int ObtenerEmpleadoSesion()
    {
        var propiedad = typeof(SesionUsuario).GetProperty("IdEmpleado");
        var idSesion = propiedad?.GetValue(Sesion);
        if (int.TryParse(idSesion?.ToString(), out int id) && id > 0)
            return empleados.Any(e => e.IdEmpleado == id && e.Estado == true) ? id : 0;

        // Compatibilidad con versiones del servicio que solo guardan NombreCompleto.
        var candidatos = empleados.Where(e => e.Estado == true &&
            string.Equals($"{e.Nombre} {e.Apellido}".Trim(), Sesion.NombreCompleto?.Trim(),
                StringComparison.OrdinalIgnoreCase)).ToList();
        return candidatos.Count == 1 ? candidatos[0].IdEmpleado : 0;
    }

    private async Task AbrirNueva()

    {
        if (!PuedeRegistrarVenta) return;

        if (!await CargarCatalogos())

            return;

        if (!empleados.Any(e => e.Estado == true))

        {

            error = "Debes registrar un empleado activo.";

            return;

        }

        if (!productos.Any(p => p.Estado == true))

        {

            error = "Debes registrar un producto activo.";

            return;

        }

        formulario = new FormularioVenta();
        fechaVentaOriginal = DateTime.Now;
        idClienteOriginalEdicion = 0;
        tipoCliente = "REGISTRADO";
        nitBusqueda = "";
        mensajeNitBusqueda = null;
        if (!PuedeAdministrar)
        {
            int idEmpleado = ObtenerEmpleadoSesion();
            if (idEmpleado <= 0)
            {
                error = "No se pudo identificar al empleado de la sesión. Verificá su asociación con el usuario.";
                return;
            }
            formulario.IdEmpleado = idEmpleado;
        }
        cantidadesOriginales = new();

        editando = false;

        idVentaEditar = 0;

        errorModal = null;

        mensaje = null;

        error = null;

        ultimaVentaId = null;

        mostrarFormulario = true;

    }

    // ========================================

    // EDITAR VENTA

    // ========================================

    private async Task AbrirEditar(int id)

    {
        if (!PuedeAdministrar) return;

        if (!await CargarCatalogos())

            return;

        var venta = await BuscarVenta(id);

        if (venta == null)

        {

            error = "No se pudo cargar la venta.";

            return;

        }

        if (venta.Estado != "REGISTRADA")

        {

            error = "Solo se pueden editar ventas registradas.";

            return;

        }

        fechaVentaOriginal = venta.FechaVenta;
        idClienteOriginalEdicion = venta.IdCliente;
        cantidadesOriginales = venta.Detalles

            .GroupBy(d => d.IdProducto)

            .ToDictionary(

                g => g.Key,

                g => g.Sum(d => (long)d.Cantidad));

        nitBusqueda = "";
        mensajeNitBusqueda = null;
        formulario = new FormularioVenta

        {

            IdCliente = venta.IdCliente,

            IdEmpleado = venta.IdEmpleado,

            Observaciones = venta.Observaciones,

            Detalles = venta.Detalles

                .Select(d => new LineaVentaFormulario

                {

                    IdProducto = d.IdProducto,

                    Cantidad = d.Cantidad,

                    PrecioVenta = d.PrecioVenta

                })

                .ToList()

        };

        tipoCliente = clientes.Any(c => c.IdCliente == venta.IdCliente && EsClienteCF(c))
            ? "CF" : "REGISTRADO";
        editando = true;

        idVentaEditar = id;

        errorModal = null;

        mensaje = null;

        error = null;

        ultimaVentaId = null;

        mostrarFormulario = true;

    }

    private void CerrarFormulario()

    {
        if (mostrarClienteRapido) return;

        if (guardando)

            return;

        mostrarFormulario = false;

        errorModal = null;

    }

    // ========================================

    // AGREGAR Y QUITAR PRODUCTOS

    // ========================================

    private void AgregarLinea()

    {

        if (formulario.Detalles.Count >= 50)

        {

            errorModal = "Máximo 50 productos por venta.";

            return;

        }

        formulario.Detalles.Add(new LineaVentaFormulario());

        errorModal = null;

    }

    private void QuitarLinea(Guid clave)

    {

        if (formulario.Detalles.Count <= 1)

            return;

        var linea = formulario.Detalles

            .FirstOrDefault(l => l.Clave == clave);

        if (linea != null)

            formulario.Detalles.Remove(linea);

        errorModal = null;

    }

    // Filtro independiente para cada línea de venta. Siempre conserva el producto elegido.
    private IEnumerable<ProductoOpcion> ProductosFiltradosVenta(LineaVentaFormulario linea)
    {
        string filtro = linea.BusquedaProducto?.Trim() ?? "";
        return productos
            .Where(p => (p.Estado == true || p.IdProducto == linea.IdProducto) &&
                (filtro.Length == 0 || p.IdProducto == linea.IdProducto ||
                 p.Codigo.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                 p.Descripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(p => p.Codigo);
    }

    private void SeleccionarProducto(

        LineaVentaFormulario linea,

        ChangeEventArgs e)

    {

        if (!int.TryParse(e.Value?.ToString(), out int id))

            id = 0;

        linea.IdProducto = id;

        var producto = productos

            .FirstOrDefault(p => p.IdProducto == id);

        linea.PrecioVenta = producto?.PrecioVenta ?? 0m;

        errorModal = null;

    }

    // ========================================

    // VALIDACIONES DE VENTA

    // ========================================

    // Límite solicitado: CF admite hasta Q2,500.00 inclusive.
    private const decimal LimiteVentaCF = 2500.00m;

    private bool EsVentaConsumidorFinal =>
        tipoCliente == "CF" || clientes.Any(c =>
            c.IdCliente == formulario.IdCliente && EsClienteCF(c));

    private bool SuperaLimiteConsumidorFinal =>
        EsVentaConsumidorFinal && TotalFormulario > LimiteVentaCF;

    private string? ValidarVenta()

    {

        var ventaAnterior = editando

            ? ventas.FirstOrDefault(v => v.IdVenta == idVentaEditar)

            : null;

        bool clienteValido = clientes.Any(c =>

            c.IdCliente == formulario.IdCliente &&

            (c.Estado == true ||

             (editando && c.IdCliente == ventaAnterior?.IdCliente)));

        if (!clienteValido)

            return "Selecciona un cliente activo y válido.";

        bool empleadoValido = empleados.Any(e =>

            e.IdEmpleado == formulario.IdEmpleado &&

            (e.Estado == true ||

             (editando && e.IdEmpleado == ventaAnterior?.IdEmpleado)));

        if (!empleadoValido)

            return "Selecciona un empleado activo y válido.";

        if (formulario.Observaciones?.Trim().Length > 255)

            return "Las observaciones no deben superar 255 caracteres.";

        if (formulario.Detalles.Count == 0)

            return "Agrega al menos un producto.";

        if (formulario.Detalles.Count > 50)

            return "Máximo 50 productos por venta.";

        var seleccionados = new HashSet<int>();

        decimal total = 0m;

        foreach (var linea in formulario.Detalles)

        {

            var producto = productos

                .FirstOrDefault(p => p.IdProducto == linea.IdProducto);

            if (producto == null)

                return "Selecciona un producto en cada fila.";

            if (!seleccionados.Add(linea.IdProducto))

                return $"El producto {producto.Codigo} está repetido.";

            long cantidadAnterior = editando

                ? cantidadesOriginales.GetValueOrDefault(linea.IdProducto)

                : 0;

            if (producto.Estado != true &&

                linea.Cantidad > cantidadAnterior)

            {

                return $"El producto {producto.Codigo} está inactivo.";

            }

            if (linea.Cantidad < 1 || linea.Cantidad > 1000000)

            {

                return $"Cantidad inválida para {producto.Codigo}.";

            }

            if (linea.PrecioVenta <= 0 ||

                linea.PrecioVenta > 9999999999.99m ||

                decimal.Round(linea.PrecioVenta, 2) != linea.PrecioVenta)

            {

                return $"Precio inválido para {producto.Codigo}. Usa máximo dos decimales.";

            }

            long disponible =

                (long)producto.Existencia + cantidadAnterior;

            if (linea.Cantidad > disponible)

            {

                return $"No hay existencias suficientes de {producto.Codigo}. Disponibles: {disponible}.";

            }

            decimal subtotal =

                linea.Cantidad * linea.PrecioVenta;

            if (subtotal > 9999999999.99m)

                return $"El subtotal de {producto.Codigo} supera el límite.";

            total += subtotal;

            if (total > 9999999999.99m)

                return "El total de la venta supera el límite.";

        }

        if (SuperaLimiteConsumidorFinal ||
            (EsVentaConsumidorFinal && total > LimiteVentaCF))
        {
            return "No se permiten ventas mayores de Q2,500.00 a Consumidor Final (CF). Seleccioná o registrá un cliente con NIT válido.";
        }

        return null;

    }

    // ========================================

    // GUARDAR VENTA

    // ========================================

    private async Task GuardarVenta()
    {
        if (!PuedeRegistrarVenta || (editando && !PuedeAdministrar)) return;
        if (tipoCliente == "CF" && preparandoCF) return;

        if (!PuedeAdministrar)
        {
            int idEmpleado = ObtenerEmpleadoSesion();
            if (idEmpleado <= 0)
            {
                errorModal = "No se pudo identificar el empleado del usuario conectado.";
                return;
            }

            formulario.IdEmpleado = idEmpleado;
            foreach (var linea in formulario.Detalles)
            {
                var producto = productos.FirstOrDefault(p => p.IdProducto == linea.IdProducto);
                if (producto != null) linea.PrecioVenta = producto.PrecioVenta;
            }
        }

        if (guardando) return;

        guardando = true;
        errorModal = null;

        // La pestaña se reserva DURANTE el envío del formulario, antes del POST.
        // Abrirla después de esperar a la API suele activar el bloqueador de ventanas.
        string? ventanaComprobante = null;
        bool ventanaBloqueada = false;
        bool ventaGuardada = false;

        try
        {
            string? validacion = ValidarVenta();
            if (validacion != null)
            {
                errorModal = validacion;
                return;
            }

            if (!editando)
            {
                try
                {
                    moduloComprobantes ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                        "import", "./js/comprobantes.js");
                    ventanaComprobante = await moduloComprobantes.InvokeAsync<string?>("prepararVistaPdf");
                    ventanaBloqueada = string.IsNullOrWhiteSpace(ventanaComprobante);
                }
                catch (Microsoft.JSInterop.JSException)
                {
                    // Un bloqueador o un módulo JS no disponible no deben cancelar la venta.
                    ventanaBloqueada = true;
                }
            }

            formulario.Observaciones = string.IsNullOrWhiteSpace(formulario.Observaciones)
                ? null
                : formulario.Observaciones.Trim();

            HttpResponseMessage respuesta;
            if (editando)
            {
                respuesta = await Http.PutAsJsonAsync($"api/Ventas/{idVentaEditar}", formulario);
            }
            else
            {
                respuesta = await Http.PostAsJsonAsync("api/Ventas", formulario);
            }

            using (respuesta)
            {
                if (!respuesta.IsSuccessStatusCode)
                {
                    errorModal = await LeerError(respuesta);
                    return;
                }

                ventaGuardada = true;

                if (editando)
                {
                    ultimaVentaId = idVentaEditar;
                }
                else
                {
                    var resultado = await respuesta.Content.ReadFromJsonAsync<RespuestaGuardarVenta>();
                    ultimaVentaId = resultado?.IdVenta > 0 ? resultado.IdVenta : null;
                }
            }

            // Mostrar el comprobante enseguida, sin necesidad de presionar "Imprimir PDF".
            // El endpoint sigue protegido por JWT; el token nunca va en la URL.
            if (!editando && !ultimaVentaId.HasValue)
                ventanaBloqueada = true;

            if (!editando && ultimaVentaId is int idNuevaVenta &&
                !string.IsNullOrWhiteSpace(ventanaComprobante))
            {
                string ventanaYaReservada = ventanaComprobante;
                ventanaComprobante = null;
                await GestionarComprobante(idNuevaVenta, false, ventanaYaReservada);
            }

            bool ventasActualizadas = await CargarVentas();
            bool catalogosActualizados = await CargarCatalogos();
            mostrarFormulario = false;

            if (ventasActualizadas && catalogosActualizados)
            {
                mensaje = editando
                    ? "Venta actualizada correctamente. Ya podés reimprimir el comprobante."
                    : ventanaBloqueada
                        ? "Venta registrada correctamente. Permití ventanas emergentes para este sitio y usá «Ver / Imprimir PDF» para abrir el comprobante."
                        : "Venta registrada correctamente. Se solicitó abrir el PDF automáticamente; también podés verlo o descargarlo desde esta pantalla.";
            }
            else
            {
                error = "La venta fue guardada, pero no se pudo actualizar el listado. Recargá la página.";
            }
        }
        catch (Exception)
        {
            errorModal = ventaGuardada
                ? "La venta fue guardada, pero ocurrió un problema al actualizar la pantalla. Revisá el listado antes de intentar nuevamente."
                : "No fue posible completar la operación. Revisá la API y el listado antes de intentar guardar nuevamente.";
        }
        finally
        {
            // Si el POST falló o no devolvió ID, cerrar la pestaña provisional.
            // Nunca se deja abierto un PDF vacío ni se registra una segunda venta.
            if (!string.IsNullOrWhiteSpace(ventanaComprobante) && moduloComprobantes != null)
            {
                try
                {
                    await moduloComprobantes.InvokeVoidAsync("cerrarVistaPdf", ventanaComprobante);
                }
                catch (Microsoft.JSInterop.JSException) { }
            }
            guardando = false;
        }
    }

