@page "/marcas"

@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using PuntoVentaWeb.Models
@using PuntoVentaWeb.Servicios

@inject HttpClient Http
@inject SesionUsuario Sesion

<PageTitle>Marcas - Sistema Punto de Venta</PageTitle>

<div class="container-fluid mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>
                @(PuedeAdministrar
                    ? "Administración de Marcas"
                    : "Consulta de Marcas")
            </h2>
        </div>

        @if (PuedeAdministrar)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="AbrirNueva">
                + Nueva Marca
            </button>
        }

    </div>

    <!-- MENSAJES -->
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-success alert-dismissible">

            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="() => mensaje = null">
            </button>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible">

            @error

            <button type="button"
                    class="btn-close"
                    @onclick="() => error = null">
            </button>

        </div>
    }

    <!-- BÚSQUEDA Y FILTROS -->
    <div class="card shadow-sm mb-3">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-8">

                    <label class="form-label">
                        Buscar marca
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Buscar por nombre o descripción..."
                           @bind="busqueda"
                           @bind:event="oninput" />

                </div>

                <div class="col-md-4">

                    <label class="form-label">
                        Estado
                    </label>

                    <select class="form-select"
                            @bind="filtroEstado">

                        <option value="todos">
                            Todos
                        </option>

                        <option value="activos">
                            Activos
                        </option>

                        <option value="inactivos">
                            Inactivos
                        </option>

                    </select>

                </div>

            </div>

        </div>

    </div>

    <!-- LISTADO DE MARCAS -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Listado de Marcas
            </h5>

        </div>

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando marcas...</p>
            }
            else if (!MarcasFiltradas.Any())
            {
                <div class="alert alert-info mb-0">
                    No se encontraron marcas.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Estado</th>

                                @if (PuedeAdministrar)
                                {
                                    <th>Acciones</th>
                                }

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var marca in MarcasFiltradas)
                            {
                                <tr>

                                    <td>
                                        @marca.IdMarca
                                    </td>

                                    <td>
                                        <strong>
                                            @marca.Nombre
                                        </strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(marca.Descripcion)
                                            ? "Sin descripción"
                                            : marca.Descripcion)
                                    </td>

                                    <td>

                                        @if (marca.Estado == true)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }

                                    </td>

                                    @if (PuedeAdministrar)
                                    {
                                        <td>

                                            <div class="d-flex gap-1">

                                                <button type="button"
                                                        class="btn btn-warning btn-sm"
                                                        @onclick="() => AbrirEditar(marca)">
                                                    Editar
                                                </button>

                                                @if (marca.Estado == true)
                                                {
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm"
                                                            @onclick="() => AbrirConfirmacion(marca)">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-success btn-sm"
                                                            @onclick="() => AbrirConfirmacion(marca)">
                                                        Activar
                                                    </button>
                                                }

                                            </div>

                                        </td>
                                    }

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<!-- MODAL DE REGISTRO Y EDICIÓN -->
@if (mostrarModal && PuedeAdministrar)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Formulario de marca">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">

                        @(editando
                            ? "Editar Marca"
                            : "Registrar Nueva Marca")

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@guardando"
                            @onclick="CerrarModal">
                    </button>

                </div>

                <EditForm Model="@formulario"
                          OnValidSubmit="GuardarMarca"
                          FormName="marcaForm">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        @if (!string.IsNullOrWhiteSpace(errorModal))
                        {
                            <div class="alert alert-danger">
                                @errorModal
                            </div>
                        }

                        <div class="row g-3">

                            <div class="col-12">

                                <label class="form-label">
                                    Nombre de la marca *
                                </label>

                                <InputText class="form-control"
                                           maxlength="100"
                                           @bind-Value="formulario.Nombre" />

                                <ValidationMessage
                                    For="@(() => formulario.Nombre)"
                                    class="text-danger" />

                            </div>

                            <div class="col-12">

                                <label class="form-label">
                                    Descripción
                                </label>

                                <InputTextArea class="form-control"
                                               rows="3"
                                               maxlength="255"
                                               @bind-Value="formulario.Descripcion" />

                                <ValidationMessage
                                    For="@(() => formulario.Descripcion)"
                                    class="text-danger" />

                                <div class="form-text">
                                    Máximo 255 caracteres.
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@guardando"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardando">

                            @(guardando
                                ? "Guardando..."
                                : editando
                                    ? "Guardar Cambios"
                                    : "Guardar Marca")

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>

    <div class="modal-backdrop fade show"></div>
}


<!-- MODAL DE CONFIRMACIÓN -->
@if (marcaConfirmacion != null && PuedeAdministrar)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Confirmar cambio de estado de la marca">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Confirmar Acción
                    </h5>

                    <button type="button"
                            class="btn-close"
                            disabled="@procesandoEstado"
                            @onclick="CerrarConfirmacion">
                    </button>

                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(errorConfirmacion))
                    {
                        <div class="alert alert-danger">
                            @errorConfirmacion
                        </div>
                    }

                    <p>

                        ¿Estás segura de que deseas

                        <strong>
                            @(marcaConfirmacion.Estado == true
                                ? "desactivar"
                                : "activar")
                        </strong>

                        la marca

                        <strong>
                            @marcaConfirmacion.Nombre
                        </strong>?

                    </p>

                    @if (marcaConfirmacion.Estado == true)
                    {
                        <div class="alert alert-warning mb-0">

                            Si esta marca tiene productos activos,
                            primero deberás desactivarlos o
                            asignarles otra marca.

                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">

                            La marca volverá a estar disponible
                            para registrar productos.

                        </p>
                    }

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@procesandoEstado"
                            @onclick="CerrarConfirmacion">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn @(marcaConfirmacion.Estado == true
                                ? "btn-danger"
                                : "btn-success")"
                            disabled="@procesandoEstado"
                            @onclick="CambiarEstado">

                        @(procesandoEstado
                            ? "Procesando..."
                            : marcaConfirmacion.Estado == true
                                ? "Desactivar"
                                : "Activar")

                    </button>

                </div>

            </div>

        </div>

    </div>

    <div class="modal-backdrop fade show"></div>
}


@code {

    // ============================================
    // PERMISOS POR ROL
    // ============================================

    // Únicamente ADMIN puede registrar,
    // editar, activar y desactivar marcas.

    private bool PuedeAdministrar =>
        Sesion.EstaAutenticado &&
        string.Equals(
            Sesion.Rol,
            "ADMIN",
            StringComparison.OrdinalIgnoreCase);


    // ============================================
    // MODELO DEL FORMULARIO
    // ============================================

    private class FormularioMarca
    {
        [Required(
            ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(
            100,
            ErrorMessage = "El nombre no debe superar 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [StringLength(
            255,
            ErrorMessage = "La descripción no debe superar 255 caracteres.")]
        public string? Descripcion { get; set; }
    }


    // ============================================
    // LISTADO Y FORMULARIO
    // ============================================

    private List<MarcaDto> marcas = new();

    private FormularioMarca formulario = new();


    // ============================================
    // ESTADOS
    // ============================================

    private bool cargando = true;

    private bool mostrarModal;

    private bool editando;

    private bool guardando;

    private bool procesandoEstado;

    private int idMarcaEditar;


    // ============================================
    // CONFIRMACIÓN
    // ============================================

    private MarcaDto? marcaConfirmacion;


    // ============================================
    // FILTROS
    // ============================================

    private string busqueda = string.Empty;

    private string filtroEstado = "todos";


    // ============================================
    // MENSAJES
    // ============================================

    private string? mensaje;

    private string? error;

    private string? errorModal;

    private string? errorConfirmacion;


    // ============================================
    // FILTRAR MARCAS
    // ============================================

    private IEnumerable<MarcaDto> MarcasFiltradas =>
        marcas.Where(m =>
            (
                filtroEstado == "todos" ||
                (filtroEstado == "activos" && m.Estado == true) ||
                (filtroEstado == "inactivos" && m.Estado != true)
            )
            &&
            (
                string.IsNullOrWhiteSpace(busqueda) ||

                m.Nombre.Contains(
                    busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ||

                (m.Descripcion?.Contains(
                    busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ?? false)
            )
        ).OrderBy(m => m.IdMarca);


    // ============================================
    // CARGA INICIAL
    // ============================================

    protected override async Task OnInitializedAsync()
    {
        await CargarMarcas();
    }


    // ============================================
    // CONSULTAR MARCAS
    // ============================================

    private async Task<bool> CargarMarcas()
    {
        cargando = true;

        try
        {
            marcas = await Http.GetFromJsonAsync<List<MarcaDto>>(
                "api/Marcas") ?? new();

            error = null;

            return true;
        }
        catch (Exception)
        {
            error =
                "No se pudieron consultar las marcas. " +
                "Verifica que la API esté funcionando.";

            return false;
        }
        finally
        {
            cargando = false;
        }
    }


    // ============================================
    // ABRIR MODAL NUEVA MARCA
    // ============================================

    private void AbrirNueva()
    {
        if (!PuedeAdministrar)
            return;

        formulario = new FormularioMarca();

        editando = false;

        idMarcaEditar = 0;

        errorModal = null;

        mostrarModal = true;
    }


    // ============================================
    // ABRIR MODAL EDITAR MARCA
    // ============================================

    private void AbrirEditar(MarcaDto marca)
    {
        if (!PuedeAdministrar)
            return;

        formulario = new FormularioMarca
        {
            Nombre = marca.Nombre,
            Descripcion = marca.Descripcion
        };

        idMarcaEditar = marca.IdMarca;

        editando = true;

        errorModal = null;

        mostrarModal = true;
    }


    // ============================================
    // CERRAR MODAL
    // ============================================

    private void CerrarModal()
    {
        if (guardando)
            return;

        mostrarModal = false;

        errorModal = null;
    }


    // ============================================
    // VALIDACIONES ADICIONALES
    // ============================================

    private string? ValidarFormulario()
    {
        if (string.IsNullOrWhiteSpace(formulario.Nombre))
        {
            return "El nombre de la marca es obligatorio.";
        }

        if (formulario.Nombre.Trim().Length > 100)
        {
            return "El nombre no debe superar 100 caracteres.";
        }

        if (formulario.Descripcion?.Trim().Length > 255)
        {
            return "La descripción no debe superar 255 caracteres.";
        }

        return null;
    }


    // ============================================
    // GUARDAR MARCA NUEVA O EDITAR
    // ============================================

    private async Task GuardarMarca()
    {
        // Validación adicional del rol.

        if (!PuedeAdministrar || guardando)
            return;

        guardando = true;

        errorModal = null;

        try
        {
            string? validacion = ValidarFormulario();

            if (validacion != null)
            {
                errorModal = validacion;

                return;
            }

            formulario.Nombre = formulario.Nombre.Trim();

            formulario.Descripcion =
                string.IsNullOrWhiteSpace(formulario.Descripcion)
                    ? null
                    : formulario.Descripcion.Trim();

            HttpResponseMessage respuesta;

            if (editando)
            {
                respuesta = await Http.PutAsJsonAsync(
                    $"api/Marcas/{idMarcaEditar}",
                    formulario);
            }
            else
            {
                respuesta = await Http.PostAsJsonAsync(
                    "api/Marcas",
                    formulario);
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                errorModal = await LeerError(respuesta);

                return;
            }

            bool actualizado = await CargarMarcas();

            mostrarModal = false;

            if (actualizado)
            {
                mensaje = editando
                    ? "Marca actualizada correctamente."
                    : "Marca registrada correctamente.";
            }
        }
        catch (Exception)
        {
            errorModal = "No fue posible conectar con la API.";
        }
        finally
        {
            guardando = false;
        }
    }


    // ============================================
    // ABRIR CONFIRMACIÓN DE ESTADO
    // ============================================

    private void AbrirConfirmacion(MarcaDto marca)
    {
        if (!PuedeAdministrar)
            return;

        marcaConfirmacion = marca;

        errorConfirmacion = null;
    }


    // ============================================
    // CERRAR CONFIRMACIÓN
    // ============================================

    private void CerrarConfirmacion()
    {
        if (procesandoEstado)
            return;

        marcaConfirmacion = null;

        errorConfirmacion = null;
    }


    // ============================================
    // ACTIVAR O DESACTIVAR MARCA
    // ============================================

    private async Task CambiarEstado()
    {
        // Solo ADMIN puede cambiar estados.

        if (!PuedeAdministrar ||
            marcaConfirmacion == null ||
            procesandoEstado)
        {
            return;
        }

        procesandoEstado = true;

        errorConfirmacion = null;

        try
        {
            int id = marcaConfirmacion.IdMarca;

            bool activar = marcaConfirmacion.Estado != true;

            HttpResponseMessage respuesta;

            if (activar)
            {
                respuesta = await Http.PutAsync(
                    $"api/Marcas/{id}/activar",
                    null);
            }
            else
            {
                respuesta = await Http.DeleteAsync(
                    $"api/Marcas/{id}");
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                errorConfirmacion = await LeerError(respuesta);

                return;
            }

            bool actualizado = await CargarMarcas();

            marcaConfirmacion = null;

            if (actualizado)
            {
                mensaje = activar
                    ? "Marca activada correctamente."
                    : "Marca desactivada correctamente.";
            }
        }
        catch (Exception)
        {
            errorConfirmacion =
                "No se pudo conectar con la API.";
        }
        finally
        {
            procesandoEstado = false;
        }
    }


    // ============================================
    // LEER MENSAJES DE ERROR DE LA API
    // ============================================

    private async Task<string> LeerError(
        HttpResponseMessage respuesta)
    {
        string contenido =
            await respuesta.Content.ReadAsStringAsync();

        try
        {
            using var documento =
                JsonDocument.Parse(contenido);

            var raiz = documento.RootElement;

            if (raiz.TryGetProperty(
                "mensaje",
                out var propiedad))
            {
                string? texto = propiedad.GetString();

                if (!string.IsNullOrWhiteSpace(texto))
                    return texto;
            }

            if (raiz.TryGetProperty(
                "errors",
                out var errores) &&
                errores.ValueKind == JsonValueKind.Object)
            {
                foreach (var campo in errores.EnumerateObject())
                {
                    if (campo.Value.ValueKind ==
                        JsonValueKind.Array)
                    {
                        foreach (var detalle in
                            campo.Value.EnumerateArray())
                        {
                            if (detalle.ValueKind ==
                                JsonValueKind.String)
                            {
                                return detalle.GetString()
                                    ?? "Los datos no son válidos.";
                            }
                        }
                    }
                }
            }
        }
        catch (JsonException)
        {
            // La API devolvió una respuesta
            // que no es JSON.
        }

        return
            $"No se pudo completar la operación. HTTP {(int)respuesta.StatusCode}.";
    }
}