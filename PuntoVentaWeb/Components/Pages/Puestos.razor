
@page "/puestos"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.RegularExpressions
@inject HttpClient Http

<PageTitle>Puestos - Sistema Punto de Venta</PageTitle>

<div class="container-fluid mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de Puestos</h2>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="AbrirNuevo">
            + Nuevo Puesto
        </button>
    </div>

    <!-- MENSAJES -->
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-success alert-dismissible">
            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="() => mensaje = null">
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible">
            @error

            <button type="button"
                    class="btn-close"
                    @onclick="() => error = null">
            </button>
        </div>
    }

    <!-- BÚSQUEDA Y FILTROS -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-8">
                    <label class="form-label">
                        Buscar puesto
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Buscar por nombre o descripción..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Estado
                    </label>

                    <select class="form-select"
                            @bind="filtroEstado">
                        <option value="todos">Todos</option>
                        <option value="activos">Activos</option>
                        <option value="inactivos">Inactivos</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- LISTADO DE PUESTOS -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Listado de Puestos
            </h5>
        </div>

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando puestos...</p>
            }
            else if (!PuestosFiltrados.Any())
            {
                <div class="alert alert-info mb-0">
                    No se encontraron puestos.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var puesto in PuestosFiltrados)
                            {
                                <tr>
                                    <td>@puesto.IdPuesto</td>

                                    <td>
                                        <strong>@puesto.Nombre</strong>
                                    </td>

                                    <td>
                                        @Mostrar(puesto.Descripcion)
                                    </td>

                                    <td>
                                        @if (puesto.Estado == true)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1">

                                            <button type="button"
                                                    class="btn btn-warning btn-sm"
                                                    @onclick="() => AbrirEditar(puesto)">
                                                Editar
                                            </button>

                                            @if (puesto.Estado == true)
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        @onclick="() => AbrirConfirmacion(puesto)">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-success btn-sm"
                                                        @onclick="() => AbrirConfirmacion(puesto)">
                                                    Activar
                                                </button>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>

</div>

<!-- ========================================= -->
<!-- MODAL PARA CREAR Y EDITAR PUESTOS         -->
<!-- ========================================= -->
@if (mostrarModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Formulario de puesto">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        @(editando
                            ? "Editar Puesto"
                            : "Registrar Nuevo Puesto")
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@guardando"
                            @onclick="CerrarModal">
                    </button>
                </div>

                <EditForm Model="@formulario"
                          OnValidSubmit="GuardarPuesto"
                          FormName="puestoForm">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        @if (!string.IsNullOrWhiteSpace(errorModal))
                        {
                            <div class="alert alert-danger">
                                @errorModal
                            </div>
                        }

                        <div class="row g-3">

                            <!-- NOMBRE -->
                            <div class="col-12">
                                <label class="form-label">
                                    Nombre del puesto *
                                </label>

                                <InputText class="form-control"
                                           maxlength="100"
                                           @bind-Value="formulario.Nombre" />

                                <ValidationMessage
                                    For="@(() => formulario.Nombre)"
                                    class="text-danger" />

                                <div class="form-text">
                                    Debe contener letras.
                                    No se permiten puestos repetidos.
                                </div>
                            </div>

                            <!-- DESCRIPCIÓN -->
                            <div class="col-12">
                                <label class="form-label">
                                    Descripción
                                </label>

                                <InputTextArea class="form-control"
                                               rows="3"
                                               maxlength="255"
                                               @bind-Value="formulario.Descripcion" />

                                <ValidationMessage
                                    For="@(() => formulario.Descripcion)"
                                    class="text-danger" />

                            </div>

                        </div>

                        <p class="text-muted small mt-3 mb-0">
                            Los campos marcados con * son obligatorios.
                        </p>
                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@guardando"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardando">
                            @(guardando
                                ? "Guardando..."
                                : editando
                                    ? "Guardar Cambios"
                                    : "Guardar Puesto")
                        </button>

                    </div>
                </EditForm>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

<!-- ========================================= -->
<!-- MODAL DE ACTIVACIÓN / DESACTIVACIÓN       -->
<!-- ========================================= -->
@if (puestoConfirmacion != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Confirmar cambio de estado">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Confirmar Acción
                    </h5>

                    <button type="button"
                            class="btn-close"
                            disabled="@procesandoEstado"
                            @onclick="CerrarConfirmacion">
                    </button>
                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(errorConfirmacion))
                    {
                        <div class="alert alert-danger">
                            @errorConfirmacion
                        </div>
                    }

                    <p>
                        ¿Estás segura de que deseas
                        <strong>
                            @(puestoConfirmacion.Estado == true
                                ? "desactivar"
                                : "activar")
                        </strong>
                        el puesto
                        <strong>@puestoConfirmacion.Nombre</strong>?
                    </p>

                    @if (puestoConfirmacion.Estado == true)
                    {
                        <div class="alert alert-warning mb-0">
                            Si tiene empleados activos asignados,
                            no podrá desactivarse hasta que
                            sean reasignados o desactivados.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            El puesto volverá a estar disponible
                            para asignarlo a empleados.
                        </p>
                    }

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@procesandoEstado"
                            @onclick="CerrarConfirmacion">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn @(puestoConfirmacion.Estado == true
                                ? "btn-danger"
                                : "btn-success")"
                            disabled="@procesandoEstado"
                            @onclick="CambiarEstado">

                        @(procesandoEstado
                            ? "Procesando..."
                            : puestoConfirmacion.Estado == true
                                ? "Desactivar"
                                : "Activar")

                    </button>

                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {

    // ========================================
    // MODELO PARA RECIBIR DATOS DE LA API
    // ========================================
    public class PuestoDto
    {
        public int IdPuesto { get; set; }

        public string Nombre { get; set; } = string.Empty;

        public string? Descripcion { get; set; }

        public bool? Estado { get; set; }
    }

    // ========================================
    // FORMULARIO CON VALIDACIONES
    // ========================================
    public class FormularioPuesto : IValidatableObject
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, MinimumLength = 3,
            ErrorMessage = "El nombre debe tener entre 3 y 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [StringLength(255,
            ErrorMessage = "La descripción no debe superar 255 caracteres.")]
        public string? Descripcion { get; set; }

        public IEnumerable<ValidationResult> Validate(
            ValidationContext validationContext)
        {
            string nombre = Nombre?.Trim() ?? string.Empty;

            if (!string.IsNullOrEmpty(nombre))
            {
                if (nombre.Length < 3 ||
                    nombre.Length > 100)
                {
                    yield return new ValidationResult(
                        "El nombre debe tener entre 3 y 100 caracteres.",
                        new[] { nameof(Nombre) });
                }
                else if (!Regex.IsMatch(
                    nombre, @"^[\p{L}\p{M}\p{N} .,&()'/\-]+$"))
                {
                    yield return new ValidationResult(
                        "El nombre contiene caracteres no permitidos.",
                        new[] { nameof(Nombre) });
                }
                else if (!nombre.Any(char.IsLetter))
                {
                    yield return new ValidationResult(
                        "El nombre debe contener letras, no solo números.",
                        new[] { nameof(Nombre) });
                }
            }

            if (!string.IsNullOrWhiteSpace(Descripcion) &&
                !Descripcion.Trim().Any(char.IsLetter))
            {
                yield return new ValidationResult(
                    "La descripción debe contener información descriptiva.",
                    new[] { nameof(Descripcion) });
            }
        }
    }

    // ========================================
    // LISTADOS Y FORMULARIOS
    // ========================================
    private List<PuestoDto> puestos = new();

    private FormularioPuesto formulario = new();

    // ========================================
    // ESTADOS
    // ========================================
    private bool cargando = true;
    private bool mostrarModal;
    private bool editando;
    private bool guardando;
    private bool procesandoEstado;

    private int idPuestoEditar;

    private PuestoDto? puestoConfirmacion;

    // ========================================
    // FILTROS
    // ========================================
    private string busqueda = string.Empty;
    private string filtroEstado = "todos";

    // ========================================
    // MENSAJES
    // ========================================
    private string? mensaje;
    private string? error;
    private string? errorModal;
    private string? errorConfirmacion;

    // ========================================
    // LISTADO FILTRADO
    // ========================================
    private IEnumerable<PuestoDto> PuestosFiltrados =>
        puestos.Where(p =>
            (
                filtroEstado == "todos" ||
                (filtroEstado == "activos" && p.Estado == true) ||
                (filtroEstado == "inactivos" && p.Estado != true)
            )
            &&
            (
                string.IsNullOrWhiteSpace(busqueda) ||
                p.Nombre.Contains(
                    busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ||
                (p.Descripcion?.Contains(
                    busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ?? false)
            )
        ).OrderBy(p => p.IdPuesto);

    // ========================================
    // CARGA INICIAL
    // ========================================
    protected override async Task OnInitializedAsync()
    {
        await CargarPuestos();
    }

    // ========================================
    // CONSULTAR PUESTOS
    // ========================================
    private async Task<bool> CargarPuestos()
    {
        cargando = true;

        try
        {
            puestos = await Http
                .GetFromJsonAsync<List<PuestoDto>>(
                    "api/Puestos") ?? new();

            error = null;
            return true;
        }
        catch (Exception)
        {
            error = "No se pudieron consultar los puestos. Verifica la API.";
            return false;
        }
        finally
        {
            cargando = false;
        }
    }

    private static string Mostrar(string? texto)
    {
        return string.IsNullOrWhiteSpace(texto)
            ? "Sin descripción"
            : texto;
    }

    // ========================================
    // ABRIR MODAL NUEVO PUESTO
    // ========================================
    private void AbrirNuevo()
    {
        formulario = new FormularioPuesto();

        editando = false;
        idPuestoEditar = 0;

        errorModal = null;
        mensaje = null;
        mostrarModal = true;
    }

    // ========================================
    // ABRIR MODAL EDITAR PUESTO
    // ========================================
    private void AbrirEditar(PuestoDto puesto)
    {
        formulario = new FormularioPuesto
        {
            Nombre = puesto.Nombre,
            Descripcion = puesto.Descripcion
        };

        idPuestoEditar = puesto.IdPuesto;
        editando = true;

        errorModal = null;
        mensaje = null;
        mostrarModal = true;
    }

    // ========================================
    // CERRAR MODAL
    // ========================================
    private void CerrarModal()
    {
        if (guardando)
            return;

        mostrarModal = false;
        errorModal = null;
    }

    // ========================================
    // GUARDAR PUESTO NUEVO O EDITADO
    // ========================================
    private async Task GuardarPuesto()
    {
        if (guardando)
            return;

        guardando = true;
        errorModal = null;

        try
        {
            formulario.Nombre = Regex.Replace(
                formulario.Nombre.Trim(), @"\s+", " ");

            formulario.Descripcion =
                string.IsNullOrWhiteSpace(formulario.Descripcion)
                    ? null
                    : formulario.Descripcion.Trim();

            HttpResponseMessage respuesta;

            if (editando)
            {
                respuesta = await Http.PutAsJsonAsync(
                    $"api/Puestos/{idPuestoEditar}",
                    formulario);
            }
            else
            {
                respuesta = await Http.PostAsJsonAsync(
                    "api/Puestos", formulario);
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                errorModal = await LeerError(respuesta);
                return;
            }

            bool actualizado = await CargarPuestos();

            mostrarModal = false;

            if (actualizado)
            {
                mensaje = editando
                    ? "Puesto actualizado correctamente."
                    : "Puesto registrado correctamente.";
            }
        }
        catch (Exception)
        {
            errorModal = "No fue posible guardar el puesto. Verifica la API.";
        }
        finally
        {
            guardando = false;
        }
    }

    // ========================================
    // ABRIR CONFIRMACIÓN
    // ========================================
    private void AbrirConfirmacion(PuestoDto puesto)
    {
        puestoConfirmacion = puesto;
        errorConfirmacion = null;
    }

    // ========================================
    // CERRAR CONFIRMACIÓN
    // ========================================
    private void CerrarConfirmacion()
    {
        if (procesandoEstado)
            return;

        puestoConfirmacion = null;
        errorConfirmacion = null;
    }

    // ========================================
    // ACTIVAR O DESACTIVAR
    // ========================================
    private async Task CambiarEstado()
    {
        if (puestoConfirmacion == null || procesandoEstado)
            return;

        procesandoEstado = true;
        errorConfirmacion = null;

        try
        {
            int id = puestoConfirmacion.IdPuesto;
            bool activar = puestoConfirmacion.Estado != true;

            HttpResponseMessage respuesta;

            if (activar)
            {
                respuesta = await Http.PutAsync(
                    $"api/Puestos/{id}/activar", null);
            }
            else
            {
                respuesta = await Http.DeleteAsync(
                    $"api/Puestos/{id}");
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                errorConfirmacion = await LeerError(respuesta);
                return;
            }

            bool actualizado = await CargarPuestos();

            puestoConfirmacion = null;

            if (actualizado)
            {
                mensaje = activar
                    ? "Puesto activado correctamente."
                    : "Puesto desactivado correctamente.";
            }
        }
        catch (Exception)
        {
            errorConfirmacion = "No fue posible conectar con la API.";
        }
        finally
        {
            procesandoEstado = false;
        }
    }

    // ========================================
    // MOSTRAR ERRORES DE LA API
    // ========================================
    private static async Task<string> LeerError(
        HttpResponseMessage respuesta)
    {
        string contenido =
            await respuesta.Content.ReadAsStringAsync();

        try
        {
            using var documento = JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;

            if (raiz.TryGetProperty("mensaje", out var mensajeApi))
            {
                string? texto = mensajeApi.GetString();

                if (!string.IsNullOrWhiteSpace(texto))
                    return texto;
            }

            if (raiz.TryGetProperty("errors", out var errores) &&
                errores.ValueKind == JsonValueKind.Object)
            {
                foreach (var campo in errores.EnumerateObject())
                {
                    if (campo.Value.ValueKind != JsonValueKind.Array)
                        continue;

                    foreach (var detalle in campo.Value.EnumerateArray())
                    {
                        if (detalle.ValueKind == JsonValueKind.String)
                        {
                            return detalle.GetString()
                                ?? "Los datos ingresados no son válidos.";
                        }
                    }
                }
            }
        }
        catch (JsonException)
        {
            // La respuesta no contiene JSON válido.
        }

        return $"No se pudo completar la operación. HTTP {(int)respuesta.StatusCode}.";
    }
}
