@page "/empleados"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.RegularExpressions
@inject HttpClient Http
<PageTitle>Empleados - Sistema Punto de Venta</PageTitle>
<div class="container-fluid mt-4">
    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de Empleados</h2>
        </div>
        <button type="button"
                class="btn btn-primary"
                @onclick="AbrirNuevo">
            + Nuevo Empleado
        </button>
    </div>
    <!-- MENSAJES -->
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-success alert-dismissible">
            @mensaje
            <button type="button"
                    class="btn-close"
                    @onclick="() => mensaje = null">
            </button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger alert-dismissible">
            @error
            <button type="button"
                    class="btn-close"
                    @onclick="() => error = null">
            </button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(errorPuestos))
    {
        <div class="alert alert-warning">
            @errorPuestos
        </div>
    }
    <!-- BÚSQUEDA Y FILTROS -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Buscar empleado</label>
                    <input class="form-control"
                           placeholder="Buscar nombre, apellido, teléfono, correo o puesto..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select class="form-select"
                            @bind="filtroEstado">
                        <option value="todos">Todos</option>
                        <option value="activos">Activos</option>
                        <option value="inactivos">Inactivos</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <!-- LISTADO -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Listado de Empleados</h5>
        </div>
        <div class="card-body">
            @if (cargando)
            {
                <p>Cargando empleados...</p>
            }
            else if (!EmpleadosFiltrados.Any())
            {
                <div class="alert alert-info mb-0">
                    No se encontraron empleados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Dirección</th>
                                <th>Ingreso</th>
                                <th>Puesto</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var empleado in EmpleadosFiltrados)
                            {
                                <tr>
                                    <td>@empleado.IdEmpleado</td>
                                    <td>@empleado.Nombre</td>
                                    <td>@empleado.Apellido</td>
                                    <td>@Mostrar(empleado.Telefono)</td>
                                    <td>@Mostrar(empleado.Correo)</td>
                                    <td>@Mostrar(empleado.Direccion)</td>
                                    <td>
                                        @empleado.FechaIngreso.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @Mostrar(empleado.NombrePuesto)
                                    </td>
                                    <td>
                                        @if (empleado.Estado == true)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button type="button"
                                                    class="btn btn-warning btn-sm"
                                                    @onclick="() => AbrirEditar(empleado)">
                                                Editar
                                            </button>
                                            @if (empleado.Estado == true)
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        @onclick="() => AbrirConfirmacion(empleado)">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-success btn-sm"
                                                        @onclick="() => AbrirConfirmacion(empleado)">
                                                    Activar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
<!-- ========================================== -->
<!-- MODAL PARA CREAR Y EDITAR EMPLEADOS        -->
<!-- ========================================== -->
@if (mostrarModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Formulario de empleado">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        @(editando
                            ? "Editar Empleado"
                            : "Registrar Nuevo Empleado")
                    </h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@guardando"
                            @onclick="CerrarModal">
                    </button>
                </div>
                <EditForm Model="@formulario"
                          @key="formulario"
                          OnValidSubmit="GuardarEmpleado"
                          FormName="empleadoForm">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(errorModal))
                        {
                            <div class="alert alert-danger">
                                @errorModal
                            </div>
                        }
                        <div class="row g-3">
                            <!-- NOMBRE -->
                            <div class="col-md-6">
                                <label class="form-label">
                                    Nombre *
                                </label>
                                <InputText class="form-control"
                                           maxlength="100"
                                           @bind-Value="formulario.Nombre" />
                                <ValidationMessage
                                    For="@(() => formulario.Nombre)"
                                    class="text-danger" />
                            </div>
                            <!-- APELLIDO -->
                            <div class="col-md-6">
                                <label class="form-label">
                                    Apellido *
                                </label>
                                <InputText class="form-control"
                                           maxlength="100"
                                           @bind-Value="formulario.Apellido" />
                                <ValidationMessage
                                    For="@(() => formulario.Apellido)"
                                    class="text-danger" />
                            </div>
                            <!-- TELÉFONO -->
                            <div class="col-md-6">
                                <label class="form-label">
                                    Teléfono *
                                </label>
                                <InputText class="form-control"
                                           type="tel"
                                           maxlength="20"
                                           @bind-Value="formulario.Telefono" />
                                <ValidationMessage
                                    For="@(() => formulario.Telefono)"
                                    class="text-danger" />
                            </div>
                            <!-- CORREO -->
                            <div class="col-md-6">
                                <label class="form-label">
                                    Correo electrónico *
                                </label>
                                <InputText class="form-control"
                                           type="email"
                                           maxlength="150"
                                           @bind-Value="formulario.Correo" />
                                <ValidationMessage
                                    For="@(() => formulario.Correo)"
                                    class="text-danger" />
                            </div>
                            <!-- PUESTO -->
                            <div class="col-md-6">
                                <label class="form-label">
                                    Puesto *
                                </label>
                                <InputSelect class="form-select"
                                             @bind-Value="formulario.IdPuesto">
                                    <option value="0">
                                        -- Selecciona un puesto --
                                    </option>
                                    @foreach (var puesto in puestos.Where(p =>
                                        p.Estado == true ||
                                        (editando && p.IdPuesto == formulario.IdPuesto)))
                                    {
                                        <option value="@puesto.IdPuesto">
                                            @puesto.Nombre
                                            @(puesto.Estado == true ? "" : " (Inactivo)")
                                        </option>
                                    }
                                </InputSelect>
                                <ValidationMessage
                                    For="@(() => formulario.IdPuesto)"
                                    class="text-danger" />
                            </div>
                            <!-- FECHA DE INGRESO -->
                            <div class="col-md-6">
                                <label class="form-label">
                                    Fecha de ingreso *
                                </label>
                                <InputDate class="form-control"
                                           min="1900-01-01"
                                           max="@FechaMaxima"
                                           @bind-Value="formulario.FechaIngreso" />
                                <ValidationMessage
                                    For="@(() => formulario.FechaIngreso)"
                                    class="text-danger" />
                            </div>
                            <!-- DIRECCIÓN -->
                            <div class="col-12">
                                <label class="form-label">
                                    Dirección
                                </label>
                                <InputTextArea class="form-control"
                                               maxlength="255"
                                               rows="3"
                                               @bind-Value="formulario.Direccion" />
                                <ValidationMessage
                                    For="@(() => formulario.Direccion)"
                                    class="text-danger" />
                            </div>
                        </div>
                        <p class="text-muted small mt-3 mb-0">
                            Los campos marcados con * son obligatorios.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@guardando"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardando">
                            @(guardando
                                ? "Guardando..."
                                : editando
                                    ? "Guardar Cambios"
                                    : "Guardar Empleado")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
<!-- ========================================== -->
<!-- MODAL PARA ACTIVAR Y DESACTIVAR EMPLEADO   -->
<!-- ========================================== -->
@if (empleadoConfirmacion != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Confirmación de estado del empleado">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Confirmar Acción
                    </h5>
                    <button type="button"
                            class="btn-close"
                            disabled="@procesandoEstado"
                            @onclick="CerrarConfirmacion">
                    </button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(errorConfirmacion))
                    {
                        <div class="alert alert-danger">
                            @errorConfirmacion
                        </div>
                    }
                    <p>
                        ¿Deseas
                        <strong>
                            @(empleadoConfirmacion.Estado == true
                                ? "desactivar"
                                : "activar")
                        </strong>
                        al empleado
                        <strong>
                            @empleadoConfirmacion.Nombre
                            @empleadoConfirmacion.Apellido
                        </strong>?
                    </p>
                    @if (empleadoConfirmacion.Estado == true)
                    {
                        <div class="alert alert-warning mb-0">
                            Si tiene una cuenta de usuario activa,
                            primero tendrás que desactivar esa cuenta.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            Para reactivarlo, su puesto debe estar activo.
                        </p>
                    }
                    <p class="text-muted small mt-2 mb-0">
                        Las ventas anteriores del empleado no se eliminarán.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@procesandoEstado"
                            @onclick="CerrarConfirmacion">
                        Cancelar
                    </button>
                    <button type="button"
                            class="btn @(empleadoConfirmacion.Estado == true ? "btn-danger" : "btn-success")"
                            disabled="@procesandoEstado"
                            @onclick="CambiarEstado">
                        @(procesandoEstado
                            ? "Procesando..."
                            : empleadoConfirmacion.Estado == true
                                ? "Desactivar"
                                : "Activar")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
@code {
    // ========================================
    // MODELOS PARA CONSULTAS
    // ========================================
    public class EmpleadoDto
    {
        public int IdEmpleado { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Apellido { get; set; } = string.Empty;
        public string? Telefono { get; set; }
        public string? Correo { get; set; }
        public string? Direccion { get; set; }
        public DateOnly FechaIngreso { get; set; }
        public int IdPuesto { get; set; }
        public string? NombrePuesto { get; set; }
        public bool? Estado { get; set; }
    }
    public class PuestoDto
    {
        public int IdPuesto { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public bool? Estado { get; set; }
    }
    // ========================================
    // FORMULARIO CON VALIDACIONES
    // ========================================
    public class FormularioEmpleado : IValidatableObject
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, MinimumLength = 2,
            ErrorMessage = "El nombre debe tener entre 2 y 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;
        [Required(ErrorMessage = "El apellido es obligatorio.")]
        [StringLength(100, MinimumLength = 2,
            ErrorMessage = "El apellido debe tener entre 2 y 100 caracteres.")]
        public string Apellido { get; set; } = string.Empty;
        [Required(ErrorMessage = "El teléfono es obligatorio.")]
        [StringLength(20)]
        public string? Telefono { get; set; }
        [Required(ErrorMessage = "El correo electrónico es obligatorio.")]
        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        [StringLength(150)]
        [RegularExpression(@"^[^@\s]+@[^@\s]+\.[^@\s]{2,}$",
            ErrorMessage = "Ingresa un correo electrónico válido.")]
        public string? Correo { get; set; }
        [StringLength(255)]
        public string? Direccion { get; set; }
        public DateOnly FechaIngreso { get; set; } =
            DateOnly.FromDateTime(DateTime.Today);
        [Range(1, int.MaxValue,
            ErrorMessage = "Selecciona un puesto.")]
        public int IdPuesto { get; set; }
        public IEnumerable<ValidationResult> Validate(
            ValidationContext validationContext)
        {
            foreach (var error in ValidarNombre(
                Nombre, nameof(Nombre), "nombre"))
                yield return error;
            foreach (var error in ValidarNombre(
                Apellido, nameof(Apellido), "apellido"))
                yield return error;
            if (!string.IsNullOrWhiteSpace(Telefono))
            {
                bool valido = Regex.IsMatch(
                    Telefono.Trim(),
                    @"^(?:\+502[ -]?)?[2-7][0-9]{3}[ -]?[0-9]{4}$");
                if (!valido)
                {
                    yield return new ValidationResult(
                        "El teléfono debe tener 8 dígitos válidos de Guatemala.",
                        new[] { nameof(Telefono) });
                }
            }
            if (!string.IsNullOrWhiteSpace(Direccion))
            {
                string texto = Direccion.Trim();
                if (texto.Length < 5 ||
                    !texto.Any(char.IsLetter))
                {
                    yield return new ValidationResult(
                        "La dirección debe tener al menos 5 caracteres y contener letras.",
                        new[] { nameof(Direccion) });
                }
            }
            var hoy = DateOnly.FromDateTime(DateTime.Today);
            if (FechaIngreso < new DateOnly(1900, 1, 1) ||
                FechaIngreso > hoy)
            {
                yield return new ValidationResult(
                    "La fecha de ingreso no puede ser futura.",
                    new[] { nameof(FechaIngreso) });
            }
        }
        private static IEnumerable<ValidationResult> ValidarNombre(
            string? valor, string campo, string etiqueta)
        {
            if (string.IsNullOrWhiteSpace(valor))
                yield break;
            string texto = valor.Trim();
            if (texto.Length < 2 || texto.Length > 100)
            {
                yield return new ValidationResult(
                    $"El {etiqueta} debe tener entre 2 y 100 caracteres.",
                    new[] { campo });
            }
            else if (!Regex.IsMatch(
                texto,
                @"^[\p{L}\p{M}]+(?:[ '\-][\p{L}\p{M}]+)*$"))
            {
                yield return new ValidationResult(
                    $"El {etiqueta} solo admite letras, espacios, guiones y apóstrofes.",
                    new[] { campo });
            }
        }
    }
    // ========================================
    // VARIABLES
    // ========================================
    private List<EmpleadoDto> empleados = new();
    private List<PuestoDto> puestos = new();
    private FormularioEmpleado formulario = new();
    private bool cargando = true;
    private bool mostrarModal;
    private bool editando;
    private bool guardando;
    private bool procesandoEstado;
    private int idEmpleadoEditar;
    private EmpleadoDto? empleadoConfirmacion;
    private string busqueda = string.Empty;
    private string filtroEstado = "todos";
    private string? mensaje;
    private string? error;
    private string? errorPuestos;
    private string? errorModal;
    private string? errorConfirmacion;
    private string FechaMaxima =>
        DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    // ========================================
    // FILTRAR EMPLEADOS
    // ========================================
    private IEnumerable<EmpleadoDto> EmpleadosFiltrados =>
        empleados.Where(e =>
            (
                filtroEstado == "todos" ||
                (filtroEstado == "activos" && e.Estado == true) ||
                (filtroEstado == "inactivos" && e.Estado != true)
            )
            &&
            (
                string.IsNullOrWhiteSpace(busqueda) ||
                e.Nombre.Contains(busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ||
                e.Apellido.Contains(busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ||
                (e.Telefono?.Contains(busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.Correo?.Contains(busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.NombrePuesto?.Contains(busqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase) ?? false)
            )
        ).OrderBy(e => e.IdEmpleado);
    // ========================================
    // CARGA INICIAL
    // ========================================
    protected override async Task OnInitializedAsync()
    {
        await CargarPuestos();
        await CargarEmpleados();
    }
    // ========================================
    // CONSULTAR PUESTOS
    // ========================================
    private async Task<bool> CargarPuestos()
    {
        try
        {
            puestos = await Http.GetFromJsonAsync<List<PuestoDto>>(
                "api/Puestos") ?? new();
            errorPuestos = null;
            return true;
        }
        catch (Exception)
        {
            puestos = new();
            errorPuestos = "No se pudieron cargar los puestos. Verifica la API.";
            return false;
        }
    }
    // ========================================
    // CONSULTAR EMPLEADOS
    // ========================================
    private async Task<bool> CargarEmpleados()
    {
        cargando = true;
        try
        {
            empleados = await Http.GetFromJsonAsync<List<EmpleadoDto>>(
                "api/Empleados") ?? new();
            error = null;
            return true;
        }
        catch (Exception)
        {
            error = "No se pudieron consultar los empleados. Verifica la API.";
            return false;
        }
        finally
        {
            cargando = false;
        }
    }
    private static string Mostrar(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor;
    }
    // ========================================
    // ABRIR NUEVO EMPLEADO
    // ========================================
    private async Task AbrirNuevo()
    {
        await CargarPuestos();
        formulario = new FormularioEmpleado();
        editando = false;
        idEmpleadoEditar = 0;
        errorModal = null;
        mensaje = null;
        mostrarModal = true;
    }
    // ========================================
    // ABRIR EDICIÓN DE EMPLEADO
    // ========================================
    private async Task AbrirEditar(EmpleadoDto empleado)
    {
        await CargarPuestos();
        formulario = new FormularioEmpleado
        {
            Nombre = empleado.Nombre,
            Apellido = empleado.Apellido,
            Telefono = empleado.Telefono,
            Correo = empleado.Correo,
            Direccion = empleado.Direccion,
            FechaIngreso = empleado.FechaIngreso,
            IdPuesto = empleado.IdPuesto
        };
        idEmpleadoEditar = empleado.IdEmpleado;
        editando = true;
        errorModal = null;
        mensaje = null;
        mostrarModal = true;
    }
    // ========================================
    // CERRAR FORMULARIO
    // ========================================
    private void CerrarModal()
    {
        if (guardando)
            return;
        mostrarModal = false;
        errorModal = null;
    }
    // ========================================
    // VALIDAR PUESTO
    // ========================================
    private string? ValidarPuesto()
    {
        bool existe = puestos.Any(p =>
            p.IdPuesto == formulario.IdPuesto &&
            (p.Estado == true ||
             (editando && p.IdPuesto == formulario.IdPuesto)));
        if (!existe)
        {
            return "Selecciona un puesto válido y activo.";
        }
        return null;
    }
    // ========================================
    // GUARDAR EMPLEADO
    // ========================================
    private async Task GuardarEmpleado()
    {
        if (guardando)
            return;
        guardando = true;
        errorModal = null;
        try
        {
            string? validacion = ValidarPuesto();
            if (validacion != null)
            {
                errorModal = validacion;
                return;
            }
            formulario.Nombre = formulario.Nombre.Trim();
            formulario.Apellido = formulario.Apellido.Trim();
            formulario.Telefono = Limpiar(formulario.Telefono);
            formulario.Correo = Limpiar(formulario.Correo)?.ToLowerInvariant();
            formulario.Direccion = Limpiar(formulario.Direccion);
            HttpResponseMessage respuesta;
            if (editando)
            {
                respuesta = await Http.PutAsJsonAsync(
                    $"api/Empleados/{idEmpleadoEditar}", formulario);
            }
            else
            {
                respuesta = await Http.PostAsJsonAsync(
                    "api/Empleados", formulario);
            }
            if (!respuesta.IsSuccessStatusCode)
            {
                errorModal = await LeerError(respuesta);
                return;
            }
            bool actualizado = await CargarEmpleados();
            mostrarModal = false;
            if (actualizado)
            {
                mensaje = editando
                    ? "Empleado actualizado correctamente."
                    : "Empleado registrado correctamente.";
            }
        }
        catch (Exception)
        {
            errorModal = "No fue posible guardar el empleado. Revisa la API.";
        }
        finally
        {
            guardando = false;
        }
    }
    // ========================================
    // ABRIR CONFIRMACIÓN
    // ========================================
    private void AbrirConfirmacion(EmpleadoDto empleado)
    {
        empleadoConfirmacion = empleado;
        errorConfirmacion = null;
    }
    private void CerrarConfirmacion()
    {
        if (procesandoEstado)
            return;
        empleadoConfirmacion = null;
        errorConfirmacion = null;
    }
    // ========================================
    // ACTIVAR O DESACTIVAR
    // ========================================
    private async Task CambiarEstado()
    {
        if (empleadoConfirmacion == null || procesandoEstado)
            return;
        procesandoEstado = true;
        errorConfirmacion = null;
        try
        {
            int id = empleadoConfirmacion.IdEmpleado;
            bool activar = empleadoConfirmacion.Estado != true;
            HttpResponseMessage respuesta;
            if (activar)
            {
                respuesta = await Http.PutAsync(
                    $"api/Empleados/{id}/activar", null);
            }
            else
            {
                respuesta = await Http.DeleteAsync(
                    $"api/Empleados/{id}");
            }
            if (!respuesta.IsSuccessStatusCode)
            {
                errorConfirmacion = await LeerError(respuesta);
                return;
            }
            bool actualizado = await CargarEmpleados();
            empleadoConfirmacion = null;
            if (actualizado)
            {
                mensaje = activar
                    ? "Empleado activado correctamente."
                    : "Empleado desactivado correctamente.";
            }
        }
        catch (Exception)
        {
            errorConfirmacion = "No fue posible conectar con la API.";
        }
        finally
        {
            procesandoEstado = false;
        }
    }
    // ========================================
    // LIMPIAR CAMPOS OPCIONALES
    // ========================================
    private static string? Limpiar(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? null
            : valor.Trim();
    }
    // ========================================
    // LEER ERRORES DE LA API
    // ========================================
    private static async Task<string> LeerError(
        HttpResponseMessage respuesta)
    {
        string contenido =
            await respuesta.Content.ReadAsStringAsync();
        try
        {
            using var documento = JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;
            if (raiz.TryGetProperty("mensaje", out var mensajeApi))
            {
                string? texto = mensajeApi.GetString();
                if (!string.IsNullOrWhiteSpace(texto))
                    return texto;
            }
            if (raiz.TryGetProperty("errors", out var errores) &&
                errores.ValueKind == JsonValueKind.Object)
            {
                foreach (var campo in errores.EnumerateObject())
                {
                    if (campo.Value.ValueKind != JsonValueKind.Array)
                        continue;
                    foreach (var detalle in campo.Value.EnumerateArray())
                    {
                        if (detalle.ValueKind == JsonValueKind.String)
                        {
                            return detalle.GetString()
                                ?? "Los datos ingresados no son válidos.";
                        }
                    }
                }
            }
        }
        catch (JsonException)
        {
            // La respuesta no es JSON.
        }
        return $"No se pudo completar la operación. HTTP {(int)respuesta.StatusCode}.";
    }
}
