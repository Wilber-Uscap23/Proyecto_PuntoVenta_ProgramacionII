
@page "/inventario"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http

<PageTitle>Inventario - Sistema Punto de Venta</PageTitle>

<div class="container-fluid mt-4">

    <!-- ===================================== -->
    <!-- ENCABEZADO                            -->
    <!-- ===================================== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de Inventario</h2>
        </div>

        <button type="button"
                class="btn btn-primary"
                disabled="@cargando"
                @onclick="CargarInventario">
            Actualizar Inventario
        </button>
    </div>

    <!-- ===================================== -->
    <!-- MENSAJES                              -->
    <!-- ===================================== -->
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <!-- ===================================== -->
    <!-- INDICADORES                          -->
    <!-- ===================================== -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Productos activos
                    </div>

                    <h3 class="text-primary mb-0">
                        @ProductosActivos
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Unidades disponibles
                    </div>

                    <h3 class="mb-0">
                        @UnidadesActivas.ToString("N0")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Productos con stock bajo
                    </div>

                    <h3 class="text-warning mb-0">
                        @ProductosStockBajo
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Productos agotados
                    </div>

                    <h3 class="text-danger mb-0">
                        @ProductosAgotados
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- ===================================== -->
    <!-- VALOR DEL INVENTARIO                 -->
    <!-- ===================================== -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>
                    <h5 class="mb-1">
                        Valor estimado del inventario activo
                    </h5>

                </div>

                <h3 class="text-success mb-0">
                    @Q(ValorInventario)
                </h3>

            </div>
        </div>
    </div>

    <!-- ===================================== -->
    <!-- FILTROS                              -->
    <!-- ===================================== -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">
                        Buscar producto
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Código, producto o marca..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">
                        Marca
                    </label>

                    <select class="form-select"
                            @bind="filtroMarca">

                        <option value="0">
                            Todas
                        </option>

                        @foreach (var marca in MarcasDisponibles)
                        {
                            <option value="@marca.IdMarca">
                                @marca.NombreMarca
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">
                        Estado
                    </label>

                    <select class="form-select"
                            @bind="filtroEstado">

                        <option value="TODOS">Todos</option>
                        <option value="ACTIVOS">Activos</option>
                        <option value="INACTIVOS">Inactivos</option>

                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">
                        Existencias
                    </label>

                    <select class="form-select"
                            @bind="filtroStock">

                        <option value="TODOS">Todas</option>
                        <option value="DISPONIBLE">Disponibles</option>
                        <option value="BAJO">Stock bajo</option>
                        <option value="AGOTADO">Agotados</option>

                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">
                        Alerta de stock bajo
                    </label>

                    <input type="number"
                           class="form-control"
                           min="1"
                           max="1000000"
                           @bind="umbralStock" />
                </div>

            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">

                <span class="text-muted small">
                    Se muestran @ProductosFiltrados.Count()
                    de @productos.Count productos.
                </span>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="LimpiarFiltros">
                    Limpiar Filtros
                </button>

            </div>
        </div>
    </div>

    <!-- ===================================== -->
    <!-- LISTADO DE INVENTARIO                -->
    <!-- ===================================== -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Existencias de Productos
            </h5>
        </div>

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando inventario...</p>
            }
            else if (!ProductosFiltrados.Any())
            {
                <div class="alert alert-info mb-0">
                    No se encontraron productos con los filtros seleccionados.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th>Marca</th>
                                <th>Costo</th>
                                <th>Venta</th>
                                <th>Existencia</th>
                                <th>Valor a costo</th>
                                <th>Stock</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var producto in ProductosFiltrados)
                            {
                                <tr @key="producto.IdProducto">

                                    <td>
                                        @producto.Codigo
                                    </td>

                                    <td>
                                        <strong>
                                            @producto.Descripcion
                                        </strong>
                                    </td>

                                    <td>
                                        @producto.NombreMarca
                                    </td>

                                    <td>
                                        @Q(producto.PrecioCosto)
                                    </td>

                                    <td>
                                        @Q(producto.PrecioVenta)
                                    </td>

                                    <td>
                                        <strong>
                                            @producto.Existencia
                                        </strong>
                                    </td>

                                    <td>
                                        @Q(producto.Existencia * producto.PrecioCosto)
                                    </td>

                                    <td>
                                        @if (producto.Existencia <= 0)
                                        {
                                            <span class="badge bg-danger">
                                                Agotado
                                            </span>
                                        }
                                        else if (producto.Existencia <= UmbralEfectivo)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Stock bajo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Disponible
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (producto.Estado == true)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                @onclick="() => AbrirOperaciones(producto)">
                                            Ver Movimientos
                                        </button>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }


        </div>
    </div>

</div>

<!-- ========================================== -->
<!-- MODAL DE OPERACIONES POR PRODUCTO           -->
<!-- ========================================== -->
@if (productoSeleccionado != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Operaciones del inventario">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        Movimientos de Inventario
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@cargandoOperaciones"
                            @onclick="CerrarOperaciones">
                    </button>
                </div>

                <div class="modal-body">

                    <!-- DATOS DEL PRODUCTO -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <strong>Producto:</strong>
                            @productoSeleccionado.Codigo -
                            @productoSeleccionado.Descripcion
                        </div>

                        <div class="col-md-3">
                            <strong>Marca:</strong>
                            @productoSeleccionado.NombreMarca
                        </div>

                        <div class="col-md-3">
                            <strong>Existencia:</strong>
                            @productoSeleccionado.Existencia
                        </div>

                    </div>

                    <!-- FILTRO DE MOVIMIENTOS -->
                    <div class="row mb-3">

                        <div class="col-md-5">
                            <label class="form-label">
                                Filtrar operaciones
                            </label>

                            <select class="form-select"
                                    @bind="filtroOperacion">

                                <option value="TODOS">
                                    Todas las operaciones
                                </option>

                                <option value="COMPRA">
                                    Entradas por compras
                                </option>

                                <option value="VENTA">
                                    Salidas por ventas
                                </option>

                                <option value="ANULADAS">
                                    Operaciones anuladas
                                </option>

                            </select>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorOperaciones))
                    {
                        <div class="alert alert-danger">
                            @errorOperaciones
                        </div>
                    }

                    @if (cargandoOperaciones)
                    {
                        <p>Cargando operaciones...</p>
                    }
                    else if (!OperacionesFiltradas.Any() &&
                             string.IsNullOrWhiteSpace(errorOperaciones))
                    {
                        <div class="alert alert-info">
                            No hay operaciones para este producto
                            con el filtro seleccionado.
                        </div>
                    }
                    else if (string.IsNullOrWhiteSpace(errorOperaciones))
                    {
                        <div class="table-responsive">

                            <table class="table table-striped table-hover align-middle">

                                <thead class="table-dark">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Tipo</th>
                                        <th>Documento</th>
                                        <th>Proveedor / Cliente</th>
                                        <th>Cantidad</th>
                                        <th>Costo / Precio</th>
                                        <th>Efecto neto</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var operacion in OperacionesFiltradas)
                                    {
                                        <tr>
                                            <td>
                                                @operacion.Fecha.ToString("dd/MM/yyyy HH:mm")
                                            </td>

                                            <td>
                                                @if (operacion.Tipo == "COMPRA")
                                                {
                                                    <span class="badge bg-success">
                                                        Entrada
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">
                                                        Salida
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @(operacion.Tipo == "COMPRA" ? "Compra" : "Venta")
                                                #@operacion.IdDocumento
                                            </td>

                                            <td>
                                                @operacion.Tercero
                                            </td>

                                            <td>
                                                @operacion.Cantidad
                                            </td>

                                            <td>
                                                @Q(operacion.PrecioUnitario)
                                            </td>

                                            <td>
                                                @if (operacion.EfectoInventario > 0)
                                                {
                                                    <strong class="text-success">
                                                        +@operacion.EfectoInventario
                                                    </strong>
                                                }
                                                else if (operacion.EfectoInventario < 0)
                                                {
                                                    <strong class="text-danger">
                                                        @operacion.EfectoInventario
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        0
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @if (operacion.EstadoDocumento == "REGISTRADA")
                                                {
                                                    <span class="badge bg-success">
                                                        Registrada
                                                    </span>
                                                }
                                                else if (operacion.EstadoDocumento == "ANULADA")
                                                {
                                                    <span class="badge bg-secondary">
                                                        Anulada
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        @operacion.EstadoDocumento
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>
                    }


                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@cargandoOperaciones"
                            @onclick="CerrarOperaciones">
                        Cerrar
                    </button>

                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {

    // ========================================
    // MODELO DE PRODUCTO EN INVENTARIO
    // ========================================
    public class InventarioProducto
    {
        public int IdProducto { get; set; }

        public string Codigo { get; set; } = string.Empty;

        public string Descripcion { get; set; } = string.Empty;

        public int IdMarca { get; set; }

        public string NombreMarca { get; set; } = string.Empty;

        public int Existencia { get; set; }

        public decimal PrecioCosto { get; set; }

        public decimal PrecioVenta { get; set; }

        public DateTime FechaIngreso { get; set; }

        public string? ImagenUrl { get; set; }

        public bool? Estado { get; set; }
    }

    // ========================================
    // MODELO DE OPERACIÓN
    // ========================================
    public class OperacionInventario
    {
        public string Tipo { get; set; } = string.Empty;

        public int IdDocumento { get; set; }

        public DateTime Fecha { get; set; }

        public string Tercero { get; set; } = string.Empty;

        public int Cantidad { get; set; }

        public decimal PrecioUnitario { get; set; }

        public decimal Subtotal { get; set; }

        public int EfectoInventario { get; set; }

        public string EstadoDocumento { get; set; } = string.Empty;
    }

    // ========================================
    // LISTADOS
    // ========================================
    private List<InventarioProducto> productos = new();

    private List<OperacionInventario> operaciones = new();

    private InventarioProducto? productoSeleccionado;

    // ========================================
    // ESTADOS
    // ========================================
    private bool cargando = true;

    private bool cargandoOperaciones;

    // ========================================
    // FILTROS
    // ========================================
    private string busqueda = string.Empty;

    private int filtroMarca = 0;

    private string filtroEstado = "TODOS";

    private string filtroStock = "TODOS";

    private string filtroOperacion = "TODOS";

    private int umbralStock = 5;

    private int UmbralEfectivo =>
        Math.Clamp(umbralStock, 1, 1000000);

    // ========================================
    // MENSAJES
    // ========================================
    private string? error;

    private string? errorOperaciones;

    // ========================================
    // FORMATO EN QUETZALES
    // ========================================
    private static readonly CultureInfo Cultura =
        CultureInfo.GetCultureInfo("es-GT");

    private static string Q(decimal valor)
    {
        return "Q" + valor.ToString("N2", Cultura);
    }

    // ========================================
    // INDICADORES
    // ========================================
    private int ProductosActivos =>
        productos.Count(p => p.Estado == true);

    private long UnidadesActivas =>
        productos
            .Where(p => p.Estado == true)
            .Sum(p => (long)p.Existencia);

    private int ProductosStockBajo =>
        productos.Count(p =>
            p.Estado == true &&
            p.Existencia > 0 &&
            p.Existencia <= UmbralEfectivo);

    private int ProductosAgotados =>
        productos.Count(p =>
            p.Estado == true &&
            p.Existencia <= 0);

    private decimal ValorInventario =>
        productos
            .Where(p => p.Estado == true)
            .Sum(p => p.Existencia * p.PrecioCosto);

    // ========================================
    // MARCAS PARA EL FILTRO
    // ========================================
    private IEnumerable<InventarioProducto> MarcasDisponibles =>
        productos
            .DistinctBy(p => p.IdMarca)
            .OrderBy(p => p.NombreMarca);

    // ========================================
    // LISTADO FILTRADO DE PRODUCTOS
    // ========================================
    private IEnumerable<InventarioProducto> ProductosFiltrados =>
        productos.Where(p =>

            // FILTRAR MARCA
            (filtroMarca == 0 ||
             p.IdMarca == filtroMarca)

            &&

            // FILTRAR ESTADO
            (filtroEstado == "TODOS" ||
             (filtroEstado == "ACTIVOS" &&
              p.Estado == true) ||
             (filtroEstado == "INACTIVOS" &&
              p.Estado != true))

            &&

            // FILTRAR EXISTENCIAS
            (filtroStock == "TODOS" ||
             (filtroStock == "DISPONIBLE" &&
              p.Existencia > UmbralEfectivo) ||
             (filtroStock == "BAJO" &&
              p.Existencia > 0 &&
              p.Existencia <= UmbralEfectivo) ||
             (filtroStock == "AGOTADO" &&
              p.Existencia <= 0))

            &&

            // BUSCAR PRODUCTO
            (string.IsNullOrWhiteSpace(busqueda) ||
             p.Codigo.Contains(
                busqueda.Trim(),
                StringComparison.OrdinalIgnoreCase) ||
             p.Descripcion.Contains(
                busqueda.Trim(),
                StringComparison.OrdinalIgnoreCase) ||
             p.NombreMarca.Contains(
                busqueda.Trim(),
                StringComparison.OrdinalIgnoreCase))

        ).OrderBy(p => p.Codigo);

    // ========================================
    // FILTRAR OPERACIONES
    // ========================================
    private IEnumerable<OperacionInventario> OperacionesFiltradas =>
        operaciones.Where(o =>
            filtroOperacion == "TODOS" ||
            (filtroOperacion == "COMPRA" &&
             o.Tipo == "COMPRA") ||
            (filtroOperacion == "VENTA" &&
             o.Tipo == "VENTA") ||
            (filtroOperacion == "ANULADAS" &&
             o.EstadoDocumento == "ANULADA")
        );

    // ========================================
    // CARGA INICIAL
    // ========================================
    protected override async Task OnInitializedAsync()
    {
        await CargarInventario();
    }

    // ========================================
    // CONSULTAR INVENTARIO
    // ========================================
    private async Task CargarInventario()
    {
        if (cargando && productos.Count > 0)
            return;

        cargando = true;
        error = null;

        try
        {
            var resultado = await Http
                .GetFromJsonAsync<List<InventarioProducto>>(
                    "api/Inventario/productos");

            productos = resultado ?? new();
        }
        catch (Exception)
        {
            error = "No se pudo consultar el inventario. Verifica que la API esté funcionando.";
        }
        finally
        {
            cargando = false;
        }
    }

    // ========================================
    // LIMPIAR FILTROS
    // ========================================
    private void LimpiarFiltros()
    {
        busqueda = string.Empty;
        filtroMarca = 0;
        filtroEstado = "TODOS";
        filtroStock = "TODOS";
        umbralStock = 5;
    }

    // ========================================
    // CONSULTAR OPERACIONES DE UN PRODUCTO
    // ========================================
    private async Task AbrirOperaciones(
        InventarioProducto producto)
    {
        productoSeleccionado = producto;

        operaciones = new();
        filtroOperacion = "TODOS";
        errorOperaciones = null;
        cargandoOperaciones = true;

        try
        {
            operaciones = await Http
                .GetFromJsonAsync<List<OperacionInventario>>(
                    $"api/Inventario/{producto.IdProducto}/operaciones")
                ?? new();
        }
        catch (Exception)
        {
            errorOperaciones =
                "No se pudieron consultar las operaciones del producto.";
        }
        finally
        {
            cargandoOperaciones = false;
        }
    }

    // ========================================
    // CERRAR MODAL
    // ========================================
    private void CerrarOperaciones()
    {
        if (cargandoOperaciones)
            return;

        productoSeleccionado = null;
        operaciones = new();
        errorOperaciones = null;
    }
}
