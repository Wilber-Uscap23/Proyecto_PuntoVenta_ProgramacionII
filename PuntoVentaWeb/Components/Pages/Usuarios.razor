
@page "/usuarios"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json
@using PuntoVentaWeb.Servicios

@inject HttpClient Http
@inject SesionUsuario Sesion

<PageTitle>Usuarios - Punto de Venta</PageTitle>

<div class="container-fluid mt-4">

    <!-- ===================================== -->
    <!-- ENCABEZADO                            -->
    <!-- ===================================== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de Usuarios</h2>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="AbrirNuevo">
            + Nuevo Usuario
        </button>
    </div>

    <!-- ===================================== -->
    <!-- MENSAJES                              -->
    <!-- ===================================== -->
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-success">
            @mensaje
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <!-- ===================================== -->
    <!-- INDICADORES                          -->
    <!-- ===================================== -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <span class="text-muted">Total de usuarios</span>
                    <h3 class="text-primary mt-2">
                        @usuarios.Count
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <span class="text-muted">Usuarios activos</span>
                    <h3 class="text-success mt-2">
                        @usuarios.Count(u => u.Estado == true)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <span class="text-muted">Administradores</span>
                    <h3 class="text-primary mt-2">
                        @usuarios.Count(u =>
                            u.Rol == "ADMIN" && u.Estado == true)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <span class="text-muted">Usuarios inactivos</span>
                    <h3 class="text-danger mt-2">
                        @usuarios.Count(u => u.Estado != true)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- ===================================== -->
    <!-- FILTROS                               -->
    <!-- ===================================== -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">
                        Buscar usuario
                    </label>

                    <input class="form-control"
                           placeholder="Usuario, empleado o puesto..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Rol
                    </label>

                    <select class="form-select"
                            @bind="filtroRol">
                        <option value="TODOS">Todos</option>
                        <option value="ADMIN">Administrador</option>
                        <option value="VENDEDOR">Vendedor</option>
                        <option value="CONSULTA">Consulta</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Estado
                    </label>

                    <select class="form-select"
                            @bind="filtroEstado">
                        <option value="TODOS">Todos</option>
                        <option value="ACTIVOS">Activos</option>
                        <option value="INACTIVOS">Inactivos</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- ===================================== -->
    <!-- TABLA DE USUARIOS                     -->
    <!-- ===================================== -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Listado de Usuarios
            </h5>
        </div>

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando usuarios...</p>
            }
            else if (!UsuariosFiltrados.Any())
            {
                <div class="alert alert-info mb-0">
                    No se encontraron usuarios.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Usuario</th>
                                <th>Empleado</th>
                                <th>Puesto</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th>Último acceso</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var usuario in UsuariosFiltrados)
                            {
                                <tr @key="usuario.IdUsuario">

                                    <td>@usuario.IdUsuario</td>

                                    <td>
                                        <strong>@usuario.Usuario</strong>
                                        @if (usuario.Usuario == Sesion.Usuario)
                                        {
                                            <span class="badge bg-info text-dark ms-1">
                                                Tú
                                            </span>
                                        }
                                    </td>

                                    <td>@usuario.NombreEmpleado</td>

                                    <td>@usuario.NombrePuesto</td>

                                    <td>
                                        @if (usuario.Rol == "ADMIN")
                                        {
                                            <span class="badge bg-primary">
                                                Administrador
                                            </span>
                                        }
                                        else if (usuario.Rol == "VENDEDOR")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Vendedor
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Consulta
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (usuario.Estado == true)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(usuario.UltimoAcceso?.ToString(
                                            "dd/MM/yyyy HH:mm") ?? "Nunca")
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1 flex-wrap">

                                            <button type="button"
                                                    class="btn btn-warning btn-sm"
                                                    disabled="@(usuario.Usuario == Sesion.Usuario)"
                                                    @onclick="() => AbrirEditar(usuario)">
                                                Editar
                                            </button>

                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    @onclick="() => AbrirClave(usuario)">
                                                Contraseña
                                            </button>

                                            @if (usuario.Estado == true)
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        disabled="@(usuario.Usuario == Sesion.Usuario)"
                                                        @onclick="() => AbrirEstado(usuario, false)">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-success btn-sm"
                                                        @onclick="() => AbrirEstado(usuario, true)">
                                                    Activar
                                                </button>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL REGISTRAR / EDITAR                   -->
<!-- ========================================== -->
@if (mostrarFormulario)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Formulario de usuario">

        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        @(editando
                            ? "Editar Usuario"
                            : "Registrar Nuevo Usuario")
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@guardando"
                            @onclick="CerrarFormulario">
                    </button>
                </div>

                <EditForm Model="@formulario"
                          @key="formulario"
                          OnValidSubmit="Guardar"
                          FormName="usuariosForm">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        @if (!string.IsNullOrWhiteSpace(errorModal))
                        {
                            <div class="alert alert-danger">
                                @errorModal
                            </div>
                        }

                        <!-- EMPLEADO -->
                        <div class="mb-3">
                            <label class="form-label">
                                Empleado *
                            </label>

                            @if (editando)
                            {
                                <input class="form-control"
                                       value="@empleadoEditado"
                                       readonly />

                                <div class="form-text">
                                    El empleado vinculado no puede cambiarse.
                                </div>
                            }
                            else
                            {
                                <InputSelect class="form-select"
                                             @bind-Value="formulario.IdEmpleado"
                                             @bind-Value:after="ActualizarCorreoEmpleado">
                                    <option value="0">
                                        -- Selecciona un empleado --
                                    </option>

                                    @foreach (var empleado in empleadosDisponibles)
                                    {
                                        <option value="@empleado.IdEmpleado">
                                            @empleado.NombreCompleto -
                                            @empleado.Puesto
                                        </option>
                                    }
                                </InputSelect>

                                <ValidationMessage
                                    For="@(() => formulario.IdEmpleado)"
                                    class="text-danger" />
                            }
                        </div>

                        <!-- USUARIO -->
                        <div class="mb-3">
                            <label class="form-label">
                                Correo empresarial (usuario) *
                            </label>

                            <InputText class="form-control"
                                       maxlength="150"
                                       readonly
                                       placeholder="Selecciona primero un empleado"
                                       @bind-Value="formulario.Usuario" />

                            <ValidationMessage
                                For="@(() => formulario.Usuario)"
                                class="text-danger" />

                        </div>

                        <!-- ROL -->
                        <div class="mb-3">
                            <label class="form-label">
                                Rol *
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="formulario.Rol">

                                <option value="VENDEDOR">Vendedor</option>
                                <option value="CONSULTA">Consulta</option>
                                <option value="ADMIN">Administrador</option>

                            </InputSelect>

                            <ValidationMessage
                                For="@(() => formulario.Rol)"
                                class="text-danger" />
                        </div>

                        <!-- CONTRASEÑA SOLO EN REGISTRO -->
                        @if (!editando)
                        {
                            <div class="mb-3">
                                <label class="form-label">
                                    Contraseña inicial *
                                </label>

                                <InputText class="form-control"
                                           type="password"
                                           autocomplete="new-password"
                                           placeholder="Contraseña segura"
                                           @bind-Value="formulario.Contrasena" />

                                <ValidationMessage
                                    For="@(() => formulario.Contrasena)"
                                    class="text-danger" />

                                <div class="form-text">
                                    Mínimo 12 caracteres, mayúsculas,
                                    minúsculas, números y un símbolo.
                                </div>
                            </div>
                        }

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@guardando"
                                @onclick="CerrarFormulario">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardando">
                            @(guardando
                                ? "Guardando..."
                                : editando
                                    ? "Guardar Cambios"
                                    : "Registrar Usuario")
                        </button>
                    </div>

                </EditForm>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

<!-- ========================================== -->
<!-- MODAL CAMBIAR CONTRASEÑA                  -->
<!-- ========================================== -->
@if (usuarioClave != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Cambiar contraseña">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        Cambiar Contraseña
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@guardando"
                            @onclick="CerrarClave">
                    </button>
                </div>

                <EditForm Model="@formularioClave"
                          @key="formularioClave"
                          OnValidSubmit="GuardarClave"
                          FormName="cambiarClaveUsuarioForm">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        <p>
                            Usuario:
                            <strong>@usuarioClave.Usuario</strong>
                        </p>

                        @if (!string.IsNullOrWhiteSpace(errorModal))
                        {
                            <div class="alert alert-danger">
                                @errorModal
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">
                                Nueva contraseña *
                            </label>

                            <InputText type="password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       @bind-Value="formularioClave.NuevaContrasena" />

                            <ValidationMessage
                                For="@(() => formularioClave.NuevaContrasena)"
                                class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Confirmar contraseña *
                            </label>

                            <InputText type="password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       @bind-Value="formularioClave.ConfirmarContrasena" />

                            <ValidationMessage
                                For="@(() => formularioClave.ConfirmarContrasena)"
                                class="text-danger" />
                        </div>

                        <p class="text-muted small mb-0">
                            La nueva contraseña debe contener al menos
                            12 caracteres, mayúsculas, minúsculas,
                            números y un símbolo.
                        </p>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@guardando"
                                @onclick="CerrarClave">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardando">
                            @(guardando
                                ? "Actualizando..."
                                : "Cambiar Contraseña")
                        </button>
                    </div>

                </EditForm>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

<!-- ========================================== -->
<!-- MODAL ACTIVAR / DESACTIVAR                 -->
<!-- ========================================== -->
@if (usuarioEstado != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Confirmar estado del usuario">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @(nuevoEstado
                            ? "Activar Usuario"
                            : "Desactivar Usuario")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            disabled="@guardando"
                            @onclick="CerrarEstado">
                    </button>
                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(errorModal))
                    {
                        <div class="alert alert-danger">
                            @errorModal
                        </div>
                    }

                    <p>
                        ¿Deseas
                        @(nuevoEstado ? "activar" : "desactivar")
                        la cuenta
                        <strong>@usuarioEstado.Usuario</strong>?
                    </p>

                    <div class="alert alert-warning mb-0">
                        @if (nuevoEstado)
                        {
                            <span>
                                Esta cuenta podrá iniciar sesión
                                nuevamente si su empleado y puesto
                                permanecen activos.
                            </span>
                        }
                        else
                        {
                            <span>
                                La cuenta no podrá seguir utilizando
                                sus accesos, pero conservará
                                su historial.
                            </span>
                        }
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@guardando"
                            @onclick="CerrarEstado">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn @(nuevoEstado ? "btn-success" : "btn-danger")"
                            disabled="@guardando"
                            @onclick="GuardarEstado">
                        @(guardando
                            ? "Procesando..."
                            : nuevoEstado
                                ? "Sí, Activar"
                                : "Sí, Desactivar")
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {

    // ========================================
    // MODELOS DE RESPUESTA
    // ========================================
    public class UsuarioListado
    {
        public int IdUsuario { get; set; }
        public int IdEmpleado { get; set; }
        public string Usuario { get; set; } = "";
        public string NombreEmpleado { get; set; } = "";
        public string NombrePuesto { get; set; } = "";
        public string Rol { get; set; } = "";
        public bool? Estado { get; set; }
        public DateTime FechaCreacion { get; set; }
        public DateTime? UltimoAcceso { get; set; }
    }

    public class EmpleadoDisponible
    {
        public int IdEmpleado { get; set; }
        public string NombreCompleto { get; set; } = "";
        public string Puesto { get; set; } = "";
        public string Correo { get; set; } = "";
    }

    // ========================================
    // FORMULARIO REGISTRAR / EDITAR
    // ========================================
    public class FormularioUsuario : IValidatableObject
    {
        public bool EsNuevo { get; set; } = true;

        [Range(1, int.MaxValue,
            ErrorMessage = "Selecciona un empleado.")]
        public int IdEmpleado { get; set; }

        [Required(ErrorMessage = "Selecciona un empleado con correo empresarial.")]
        [StringLength(150)]
        public string Usuario { get; set; } = "";

        [Required]
        [RegularExpression(
            "^(ADMIN|VENDEDOR|CONSULTA)$",
            ErrorMessage = "Selecciona un rol válido.")]
        public string Rol { get; set; } = "VENDEDOR";

        public string Contrasena { get; set; } = "";

        public IEnumerable<ValidationResult> Validate(
            ValidationContext context)
        {
            if (!EsNuevo)
                yield break;

            if (string.IsNullOrWhiteSpace(Contrasena) ||
                Contrasena.Length < 12 ||
                Contrasena.Length > 128)
            {
                yield return new ValidationResult(
                    "La contraseña debe tener entre 12 y 128 caracteres.",
                    new[] { nameof(Contrasena) });
            }
            else if (!Contrasena.Any(char.IsUpper) ||
                     !Contrasena.Any(char.IsLower) ||
                     !Contrasena.Any(char.IsDigit) ||
                     !Contrasena.Any(c =>
                         char.IsPunctuation(c) ||
                         char.IsSymbol(c)))
            {
                yield return new ValidationResult(
                    "Agrega mayúsculas, minúsculas, números y un símbolo.",
                    new[] { nameof(Contrasena) });
            }
        }
    }

    // ========================================
    // FORMULARIO CONTRASEÑA
    // ========================================
    public class FormularioCambiarClave : IValidatableObject
    {
        [Required(ErrorMessage = "Ingresa una contraseña.")]
        public string NuevaContrasena { get; set; } = "";

        [Required(ErrorMessage = "Confirma la contraseña.")]
        [Compare(nameof(NuevaContrasena),
            ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmarContrasena { get; set; } = "";

        public IEnumerable<ValidationResult> Validate(
            ValidationContext context)
        {
            var clave = NuevaContrasena;

            if (clave.Length < 12 || clave.Length > 128)
            {
                yield return new ValidationResult(
                    "La contraseña debe tener entre 12 y 128 caracteres.",
                    new[] { nameof(NuevaContrasena) });
            }
            else if (!clave.Any(char.IsUpper) ||
                     !clave.Any(char.IsLower) ||
                     !clave.Any(char.IsDigit) ||
                     !clave.Any(c =>
                         char.IsPunctuation(c) ||
                         char.IsSymbol(c)))
            {
                yield return new ValidationResult(
                    "Agrega mayúsculas, minúsculas, números y un símbolo.",
                    new[] { nameof(NuevaContrasena) });
            }
        }
    }

    // ========================================
    // VARIABLES
    // ========================================
    private List<UsuarioListado> usuarios = new();
    private List<EmpleadoDisponible> empleadosDisponibles = new();

    private FormularioUsuario formulario = new();
    private FormularioCambiarClave formularioClave = new();

    private UsuarioListado? usuarioClave;
    private UsuarioListado? usuarioEstado;

    private bool cargando = true;
    private bool guardando;
    private bool mostrarFormulario;
    private bool editando;
    private bool nuevoEstado;

    private int idEditar;
    private string empleadoEditado = "";

    private string busqueda = "";
    private string filtroRol = "TODOS";
    private string filtroEstado = "TODOS";

    private string? mensaje;
    private string? error;
    private string? errorModal;

    // ========================================
    // FILTROS
    // ========================================
    private IEnumerable<UsuarioListado> UsuariosFiltrados =>
        usuarios.Where(u =>
            (filtroRol == "TODOS" || u.Rol == filtroRol)
            &&
            (filtroEstado == "TODOS" ||
             (filtroEstado == "ACTIVOS" &&
              u.Estado == true) ||
             (filtroEstado == "INACTIVOS" &&
              u.Estado != true))
            &&
            (string.IsNullOrWhiteSpace(busqueda) ||
             u.Usuario.Contains(busqueda.Trim(),
                 StringComparison.OrdinalIgnoreCase) ||
             u.NombreEmpleado.Contains(busqueda.Trim(),
                 StringComparison.OrdinalIgnoreCase) ||
             u.NombrePuesto.Contains(busqueda.Trim(),
                 StringComparison.OrdinalIgnoreCase)))
        .OrderBy(u => u.Usuario);

    // ========================================
    // CARGAR USUARIOS
    // ========================================
    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task<bool> CargarUsuarios()
    {
        cargando = true;

        try
        {
            usuarios = await Http
                .GetFromJsonAsync<List<UsuarioListado>>(
                    "api/Usuarios") ?? new();

            error = null;
            return true;
        }
        catch (Exception)
        {
            error = "No se pudieron cargar los usuarios. Verifica que la API esté funcionando y que hayas iniciado sesión como ADMIN.";
            return false;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task<bool> CargarEmpleados()
    {
        try
        {
            empleadosDisponibles = await Http
                .GetFromJsonAsync<List<EmpleadoDisponible>>(
                    "api/Usuarios/empleados-disponibles")
                ?? new();

            return true;
        }
        catch (Exception)
        {
            error = "No se pudo consultar los empleados disponibles.";
            return false;
        }
    }

    // ========================================
    // REGISTRAR
    // ========================================
    private async Task AbrirNuevo()
    {
        if (!await CargarEmpleados())
            return;

        if (empleadosDisponibles.Count == 0)
        {
            error = "No hay empleados activos sin cuenta. Primero registra otro empleado.";
            return;
        }

        formulario = new FormularioUsuario();
        editando = false;
        idEditar = 0;
        error = null;
        errorModal = null;
        mensaje = null;
        mostrarFormulario = true;
    }

    // ========================================
    // CORREO EMPRESARIAL DEL EMPLEADO
    // ========================================
    private void ActualizarCorreoEmpleado()
    {
        var empleado = empleadosDisponibles
            .FirstOrDefault(e => e.IdEmpleado == formulario.IdEmpleado);

        formulario.Usuario = empleado?.Correo?
            .Trim()
            .ToLowerInvariant() ?? "";
    }

    // ========================================
    // EDITAR
    // ========================================
    private void AbrirEditar(UsuarioListado usuario)
    {
        formulario = new FormularioUsuario
        {
            EsNuevo = false,
            IdEmpleado = usuario.IdEmpleado,
            Usuario = usuario.Usuario,
            Rol = usuario.Rol
        };

        empleadoEditado = usuario.NombreEmpleado;
        idEditar = usuario.IdUsuario;
        editando = true;
        error = null;
        errorModal = null;
        mensaje = null;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        if (guardando)
            return;

        mostrarFormulario = false;
        formulario = new();
        errorModal = null;
    }

    // ========================================
    // GUARDAR USUARIO
    // ========================================
    private async Task Guardar()
    {
        if (guardando)
            return;

        guardando = true;
        errorModal = null;

        try
        {
            HttpResponseMessage respuesta;

            if (editando)
            {
                respuesta = await Http.PutAsJsonAsync(
                    $"api/Usuarios/{idEditar}",
                    new
                    {
                        usuario = formulario.Usuario.Trim(),
                        rol = formulario.Rol
                    });
            }
            else
            {
                respuesta = await Http.PostAsJsonAsync(
                    "api/Usuarios",
                    new
                    {
                        idEmpleado = formulario.IdEmpleado,
                        rol = formulario.Rol,
                        contrasena = formulario.Contrasena
                    });
            }

            using (respuesta)
            {
                if (!respuesta.IsSuccessStatusCode)
                {
                    errorModal = await LeerError(respuesta);
                    return;
                }
            }

            bool cargado = await CargarUsuarios();

            mostrarFormulario = false;
            formulario.Contrasena = "";
            formulario = new();

            if (cargado)
            {
                mensaje = editando
                    ? "Usuario actualizado correctamente."
                    : "Usuario registrado correctamente.";
            }
        }
        catch (Exception)
        {
            errorModal = "No fue posible guardar el usuario. Verifica la conexión.";
        }
        finally
        {
            guardando = false;
        }
    }

    // ========================================
    // CAMBIAR CONTRASEÑA
    // ========================================
    private void AbrirClave(UsuarioListado usuario)
    {
        usuarioClave = usuario;
        formularioClave = new();
        errorModal = null;
        mensaje = null;
    }

    private void CerrarClave()
    {
        if (guardando)
            return;

        usuarioClave = null;
        formularioClave = new();
        errorModal = null;
    }

    private async Task GuardarClave()
    {
        if (usuarioClave == null || guardando)
            return;

        guardando = true;
        errorModal = null;

        try
        {
            using var respuesta = await Http.PutAsJsonAsync(
                $"api/Usuarios/{usuarioClave.IdUsuario}/contrasena",
                new
                {
                    nuevaContrasena =
                        formularioClave.NuevaContrasena
                });

            if (!respuesta.IsSuccessStatusCode)
            {
                errorModal = await LeerError(respuesta);
                return;
            }

            formularioClave = new();
            usuarioClave = null;

            mensaje = "Contraseña actualizada correctamente.";
        }
        catch (Exception)
        {
            errorModal = "No fue posible actualizar la contraseña.";
        }
        finally
        {
            guardando = false;
        }
    }

    // ========================================
    // ACTIVAR O DESACTIVAR
    // ========================================
    private void AbrirEstado(
        UsuarioListado usuario,
        bool activar)
    {
        usuarioEstado = usuario;
        nuevoEstado = activar;
        errorModal = null;
        mensaje = null;
    }

    private void CerrarEstado()
    {
        if (guardando)
            return;

        usuarioEstado = null;
        errorModal = null;
    }

    private async Task GuardarEstado()
    {
        if (usuarioEstado == null || guardando)
            return;

        guardando = true;
        errorModal = null;

        try
        {
            using var respuesta = await Http.PutAsJsonAsync(
                $"api/Usuarios/{usuarioEstado.IdUsuario}/estado",
                new
                {
                    activo = nuevoEstado
                });

            if (!respuesta.IsSuccessStatusCode)
            {
                errorModal = await LeerError(respuesta);
                return;
            }

            bool cargado = await CargarUsuarios();

            usuarioEstado = null;

            if (cargado)
            {
                mensaje = nuevoEstado
                    ? "Usuario activado correctamente."
                    : "Usuario desactivado correctamente.";
            }
        }
        catch (Exception)
        {
            errorModal = "No fue posible cambiar el estado del usuario.";
        }
        finally
        {
            guardando = false;
        }
    }

    // ========================================
    // LEER ERRORES DE LA API
    // ========================================
    private static async Task<string> LeerError(
        HttpResponseMessage respuesta)
    {
        try
        {
            string contenido = await respuesta.Content
                .ReadAsStringAsync();

            using var documento = JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;

            if (raiz.TryGetProperty(
                "mensaje", out var mensajeApi) &&
                mensajeApi.ValueKind == JsonValueKind.String)
            {
                return mensajeApi.GetString()
                    ?? "No se pudo completar la operación.";
            }

            if (raiz.TryGetProperty(
                "errors", out var errores) &&
                errores.ValueKind == JsonValueKind.Object)
            {
                foreach (var campo in errores.EnumerateObject())
                {
                    if (campo.Value.ValueKind != JsonValueKind.Array)
                        continue;

                    foreach (var detalle in campo.Value.EnumerateArray())
                    {
                        if (detalle.ValueKind == JsonValueKind.String)
                        {
                            return detalle.GetString()
                                ?? "Los datos ingresados no son válidos.";
                        }
                    }
                }
            }
        }
        catch (JsonException)
        {
            // Respuesta no JSON.
        }

        return $"Error HTTP {(int)respuesta.StatusCode}.";
    }
}
