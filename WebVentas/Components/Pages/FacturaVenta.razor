@page "/ventas/factura/{IdVenta:int}"
@rendermode InteractiveServer
@using WebVentas.Models
@using WebVentas.Services
@inject VentasService Servicio
@inject IJSRuntime JS

<PageTitle>Factura</PageTitle>

<style>
    .factura {
        max-width: 820px;
        margin: 0 auto;
        background: #fff;
        color: #000;
        border: 1px solid #bbb;
        padding: 28px 32px;
        font-family: Arial, Helvetica, sans-serif;
    }
    .factura h4, .factura h5 { margin: 0; letter-spacing: .5px; }
    .factura .seccion { border-top: 1px dashed #777; margin-top: 14px; padding-top: 10px; }
    .factura .titulo-seccion { font-weight: bold; text-align: center; margin-bottom: 6px; }
    .factura table { width: 100%; border-collapse: collapse; margin-top: 6px; }
    .factura th { border-bottom: 1px solid #000; padding: 4px 6px; font-size: .9rem; }
    .factura td { padding: 4px 6px; font-size: .95rem; }
    .factura .derecha { text-align: right; }
    .factura .total { font-size: 1.25rem; font-weight: bold; border-top: 1px solid #000; margin-top: 6px; padding-top: 6px; }

    @@page { margin: 12mm; }
    @@media print {
        .sidebar, .top-row, .navbar-toggler, #blazor-error-ui, .no-imprimir { display: none !important; }
        article.content { padding: 0 !important; }
        main { width: 100% !important; }
        body { background: #fff !important; }
        .factura { border: none !important; padding: 0 !important; max-width: 100% !important; }
    }
</style>

<div class="no-imprimir mb-3 d-flex gap-2 flex-wrap align-items-center">
    <button class="btn btn-primary" @onclick="Imprimir" disabled="@(factura is null)">Imprimir</button>
    <a class="btn btn-secondary" href="ventas">Volver a ventas</a>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger no-imprimir">@error</div>
}

@if (cargando)
{
    <p class="no-imprimir">Generando factura...</p>
}
else if (factura != null)
{
    <div class="factura">
        <div class="text-center">
            <h5>DOCUMENTO TRIBUTARIO ELECTRÓNICO</h5>
            <h4>FACTURA</h4>
        </div>

        <div class="seccion">
            <table>
                <tr>
                    <td><strong>Serie:</strong> @factura.serie</td>
                    <td class="derecha"><strong>No. FEL:</strong> @factura.numero_fel.ToString("D6")</td>
                </tr>
                <tr>
                    <td><strong>Venta No.:</strong> @factura.id_venta</td>
                    <td class="derecha"><strong>Fecha de emisión:</strong> @factura.fecha_emision.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            </table>
        </div>

        <div class="seccion">
            <div class="titulo-seccion">DATOS DEL VENDEDOR</div>
            <div class="text-center">
                <div>@factura.emisor_nombre</div>
                <div>NIT: @factura.emisor_nit</div>
                <div>@factura.emisor_direccion</div>
            </div>
        </div>

        <div class="seccion">
            <div class="titulo-seccion">DATOS DEL COMPRADOR</div>
            <div class="text-center">
                <div>NIT: @factura.comprador_nit</div>
                <div>@factura.comprador_nombre</div>
            </div>
        </div>

        <div class="seccion">
            <div class="titulo-seccion">DETALLE DE LA FACTURA</div>
            <table>
                <thead>
                    <tr>
                        <th class="derecha" style="width:90px">Cantidad</th>
                        <th>Descripción</th>
                        <th class="derecha">Precio unitario</th>
                        <th class="derecha">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in factura.Detalles)
                    {
                        <tr>
                            <td class="derecha">@l.cantidad</td>
                            <td>@l.descripcion</td>
                            <td class="derecha">Q @l.precio_unitario.ToString("N2")</td>
                            <td class="derecha">Q @l.subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="seccion">
            <div class="derecha">Total de unidades: <strong>@factura.total_unidades</strong></div>
            <div class="derecha">Descuento: Q @factura.descuento.ToString("N2")</div>
            <div class="derecha total">TOTAL: Q @factura.total.ToString("N2")</div>
            <div class="text-center mt-3"><strong>@factura.total_letras</strong></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(factura.observaciones))
        {
            <div class="seccion text-center">Observaciones: @factura.observaciones</div>
        }

        <div class="seccion text-center" style="font-size:.75rem; color:#555;">
            Documento de demostración elaborado para un proyecto académico. No tiene validez tributaria ante la SAT.
        </div>
    </div>
}

@code {
    [Parameter] public int IdVenta { get; set; }

    private FacturaDocumento? factura;
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            (factura, error) = await Servicio.EmitirFacturaAsync(IdVenta);
        }
        catch (Exception)
        {
            error = "No se pudo conectar con la API. Verifica que ApiVentas esté ejecutándose.";
        }
        cargando = false;
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("print");
}
