@page "/ventas/nueva"
@page "/ventas/editar/{Id:int}"
@rendermode InteractiveServer
@using WebVentas.Components
@using WebVentas.Models
@using WebVentas.Services
@inject VentasService Servicio
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Nueva venta" : "Editar venta")</PageTitle>

@if (vista == null)
{
    <h3>@(Id is null ? "Nueva venta" : $"Editar venta #{Id}")</h3>
}
else
{
    <h3 class="no-imprimir">Vista previa de la factura</h3>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger no-imprimir">@error</div>
}

@if (cargando)
{
    <p>Cargando...</p>
}
else if (vista != null)
{
    @* ===== PASO 2: vista previa de la factura (todavía NO se guarda nada) ===== *@
    <div class="no-imprimir mb-3 d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-success" @onclick="Confirmar" disabled="@guardando">Confirmar venta</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="VolverAEditar" disabled="@guardando">Volver a editar</button>
        <button type="button" class="btn btn-primary" @onclick="Imprimir">Imprimir</button>
    </div>
    <p class="no-imprimir text-muted small">
        Revisa la factura. La venta y la factura solo se guardan al presionar «Confirmar venta».
    </p>

    <FacturaVista Factura="vista" VistaPrevia="true" />
}
else
{
    @* ===== PASO 1: datos de la venta ===== *@
    <div class="card mb-3">
        <div class="card-header">Datos de la venta</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Cliente (NIT) *</label>
                    <div class="input-group">
                        <input class="form-control" placeholder="Ej: 3602978-5 (vacío = CF)"
                               @bind="nitBusqueda" @bind:after="LimpiarCliente" @onkeyup="TeclaCliente" />
                        <button type="button" class="btn btn-primary" @onclick="BuscarCliente">Buscar</button>
                    </div>
                    <div class="form-text">Escribe el NIT y presiona Buscar (o Enter). Si lo dejas vacío se usa CF (Consumidor Final).</div>
                    @if (clienteSel != null)
                    {
                        <div class="text-success small mt-1">
                            Cliente: @clienteSel.nombre @clienteSel.apellido (NIT: @(string.IsNullOrWhiteSpace(clienteSel.nit) ? "CF" : clienteSel.nit))
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(errorCliente))
                    {
                        <div class="text-danger small mt-1">@errorCliente</div>
                    }
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Empleado (id o nombre) *</label>
                    <div class="input-group">
                        <input class="form-control" placeholder="Ej: 3 o María López"
                               @bind="textoEmpleado" @bind:after="LimpiarEmpleado" @onkeyup="TeclaEmpleado" />
                        <button type="button" class="btn btn-primary" @onclick="BuscarEmpleado">Buscar</button>
                    </div>
                    <div class="form-text">Escribe el id o parte del nombre y presiona Buscar (o Enter).</div>
                    @if (resultadosEmpleado.Count > 1)
                    {
                        <div class="list-group mt-1">
                            @foreach (var e in resultadosEmpleado)
                            {
                                <button type="button" class="list-group-item list-group-item-action"
                                        @onclick="() => SeleccionarEmpleado(e)">
                                    #@e.id_empleado - @e.nombre @e.apellido
                                </button>
                            }
                        </div>
                    }
                    @if (empleadoSel != null)
                    {
                        <div class="text-success small mt-1">Empleado: #@empleadoSel.id_empleado - @empleadoSel.nombre @empleadoSel.apellido</div>
                    }
                    @if (!string.IsNullOrEmpty(errorEmpleado))
                    {
                        <div class="text-danger small mt-1">@errorEmpleado</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Detalle de la venta</div>
        <div class="card-body">
            @if (Id is null)
            {
                <label class="form-label">Producto: escanea el código de barras o escribe el código / id</label>
                <div class="input-group">
                    <input @ref="inputProducto" class="form-control" placeholder="Escanea o escribe el código y presiona Enter"
                           @bind="codigoProducto" @onkeyup="TeclaProducto" />
                    <button type="button" class="btn btn-primary" @onclick="AgregarProducto">Agregar</button>
                </div>
                @if (!string.IsNullOrEmpty(mensajeProducto))
                {
                    <div class="text-success small mt-1">@mensajeProducto</div>
                }
                @if (!string.IsNullOrEmpty(errorProducto))
                {
                    <div class="text-danger small mt-1">@errorProducto</div>
                }

                <table class="table table-sm align-middle mt-3">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Existencia</th>
                            <th>Precio</th>
                            <th style="width:130px">Cantidad</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in lineas)
                        {
                            <tr>
                                <td>
                                    @l.Producto.descripcion
                                    <div class="text-muted small">Código: @l.Producto.codigo</div>
                                </td>
                                <td>@l.Producto.existencia</td>
                                <td>Q @l.Producto.precio_venta.ToString("N2")</td>
                                <td>
                                    <input type="number" min="1" class="form-control"
                                           @bind="l.Cantidad" @bind:event="oninput" />
                                </td>
                                <td>Q @((l.Cantidad * l.Producto.precio_venta).ToString("N2"))</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Quitar(l)">Quitar</button>
                                </td>
                            </tr>
                            @if (l.Cantidad > l.Producto.existencia)
                            {
                                <tr>
                                    <td colspan="6" class="text-danger small">
                                        Inventario insuficiente para "@l.Producto.descripcion": disponible @l.Producto.existencia.
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                @if (lineas.Count == 0)
                {
                    <p class="text-muted small mb-0">Todavía no has agregado productos.</p>
                }
            }
            else
            {
                <p class="text-muted small">
                    Los productos de una venta ya confirmada no se modifican, para no alterar el inventario.
                </p>
                <table class="table table-sm table-bordered mb-0">
                    <thead>
                        <tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in venta.Detalles)
                        {
                            <tr>
                                <td>@(productosCat.TryGetValue(d.id_producto, out var prod) ? prod.descripcion : $"#{d.id_producto}")</td>
                                <td>@d.cantidad</td>
                                <td>Q @d.precio_venta.ToString("N2")</td>
                                <td>Q @d.subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="card-footer text-end fs-5">
            <strong>Total: Q @TotalMostrado.ToString("N2")</strong>
        </div>
    </div>

    <button type="button" class="btn btn-success" @onclick="Continuar" disabled="@guardando">
        @(Id is null ? "Ver vista previa de la factura" : "Guardar cambios")
    </button>
    <a class="btn btn-secondary" href="ventas">Cancelar</a>
}

@code {
    [Parameter] public int? Id { get; set; }

    // Línea del detalle mientras se arma la venta
    private class LineaVenta
    {
        public OpcionProducto Producto { get; set; } = default!;
        public int Cantidad { get; set; } = 1;
    }

    private Venta venta = new();
    private OpcionCliente? clienteSel;
    private OpcionEmpleado? empleadoSel;
    private List<OpcionEmpleado> resultadosEmpleado = new();
    private List<LineaVenta> lineas = new();
    private Dictionary<int, OpcionProducto> productosCat = new();

    private string nitBusqueda = "";
    private string textoEmpleado = "";
    private string codigoProducto = "";

    private string? error;
    private string? errorCliente;
    private string? errorEmpleado;
    private string? errorProducto;
    private string? mensajeProducto;

    private FacturaDocumento? vista;   // si no es null, se muestra la vista previa
    private bool cargando = true;
    private bool guardando;
    private ElementReference inputProducto;

    private const string SinConexion = "No se pudo conectar con la API. Verifica que ApiVentas esté ejecutándose.";

    private decimal TotalMostrado => Id is null
        ? lineas.Sum(l => l.Cantidad * l.Producto.precio_venta)
        : venta.total;

    protected override async Task OnInitializedAsync()
    {
        if (Id is not null)
        {
            try
            {
                var existente = await Servicio.ObtenerAsync(Id.Value);
                if (existente == null)
                {
                    error = "No se encontró la venta.";
                }
                else
                {
                    venta = existente;
                    var cat = await Servicio.CatalogosAsync();
                    productosCat = cat.Productos.ToDictionary(p => p.id_producto);

                    clienteSel = cat.Clientes.FirstOrDefault(c => c.id_cliente == venta.id_cliente);
                    nitBusqueda = clienteSel?.nit ?? "";

                    empleadoSel = cat.Empleados.FirstOrDefault(e => e.id_empleado == venta.id_empleado);
                    textoEmpleado = empleadoSel is null ? "" : $"{empleadoSel.nombre} {empleadoSel.apellido}";
                }
            }
            catch (Exception)
            {
                error = SinConexion;
            }
        }
        cargando = false;
    }

    // ---------- Cliente ----------
    private void LimpiarCliente()
    {
        clienteSel = null;
        errorCliente = null;
    }

    private async Task TeclaCliente(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarCliente();
    }

    private async Task BuscarCliente()
    {
        errorCliente = null;
        try
        {
            var (cliente, mensaje) = await Servicio.BuscarClienteAsync(nitBusqueda);
            if (mensaje != null)
            {
                clienteSel = null;
                errorCliente = mensaje;
                return;
            }
            clienteSel = cliente;
        }
        catch (Exception)
        {
            errorCliente = SinConexion;
        }
    }

    // ---------- Empleado ----------
    private void LimpiarEmpleado()
    {
        empleadoSel = null;
        errorEmpleado = null;
        resultadosEmpleado = new();
    }

    private async Task TeclaEmpleado(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarEmpleado();
    }

    private async Task BuscarEmpleado()
    {
        errorEmpleado = null;
        empleadoSel = null;
        resultadosEmpleado = new();

        var texto = (textoEmpleado ?? "").Trim();
        if (texto == "")
        {
            errorEmpleado = "Escribe el id o parte del nombre del empleado.";
            return;
        }

        try
        {
            var (lista, mensaje) = await Servicio.BuscarEmpleadosAsync(texto);
            if (mensaje != null)
            {
                errorEmpleado = mensaje;
                return;
            }
            if (lista.Count == 0)
            {
                errorEmpleado = "No se encontró ningún empleado activo con ese dato.";
                return;
            }
            if (lista.Count == 1) empleadoSel = lista[0];
            else resultadosEmpleado = lista;
        }
        catch (Exception)
        {
            errorEmpleado = SinConexion;
        }
    }

    private void SeleccionarEmpleado(OpcionEmpleado e)
    {
        empleadoSel = e;
        resultadosEmpleado = new();
        errorEmpleado = null;
    }

    // ---------- Productos ----------
    private async Task TeclaProducto(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AgregarProducto();
    }

    private async Task AgregarProducto()
    {
        mensajeProducto = null;
        errorProducto = null;

        var codigo = (codigoProducto ?? "").Trim();
        if (codigo == "")
        {
            errorProducto = "Escribe o escanea un código.";
            return;
        }

        try
        {
            var (prod, mensaje) = await Servicio.BuscarProductoAsync(codigo);
            if (mensaje != null)
            {
                errorProducto = mensaje;
                return;
            }

            var p = prod!;
            if (p.existencia <= 0)
            {
                errorProducto = $"\"{p.descripcion}\" no tiene existencia.";
                return;
            }

            var linea = lineas.FirstOrDefault(l => l.Producto.id_producto == p.id_producto);
            if (linea != null)
            {
                if (linea.Cantidad + 1 > p.existencia)
                {
                    errorProducto = $"Inventario insuficiente para \"{p.descripcion}\": disponible {p.existencia}.";
                    return;
                }
                linea.Cantidad++;
                linea.Producto = p;
            }
            else
            {
                lineas.Add(new LineaVenta { Producto = p, Cantidad = 1 });
            }

            mensajeProducto = $"Agregado: {p.descripcion} (Q {p.precio_venta:N2}, existencia {p.existencia}).";
            codigoProducto = "";
        }
        catch (Exception)
        {
            errorProducto = SinConexion;
        }
        finally
        {
            try { await inputProducto.FocusAsync(); } catch { }
        }
    }

    private void Quitar(LineaVenta l) => lineas.Remove(l);

    // ---------- Flujo: vista previa -> confirmar ----------
    private async Task Continuar()
    {
        error = null;

        // Si buscaste pero no presionaste Buscar, se busca ahora con lo que escribiste.
        if (clienteSel == null) await BuscarCliente();
        if (empleadoSel == null && !string.IsNullOrWhiteSpace(textoEmpleado)) await BuscarEmpleado();

        if (clienteSel == null)
        {
            error = "Busca y selecciona un cliente (si dejas el NIT vacío se usa CF).";
            return;
        }
        if (empleadoSel == null)
        {
            error = "Busca y selecciona un empleado.";
            return;
        }

        if (Id is null) await VerVistaPrevia();
        else await GuardarEdicion();
    }

    private async Task VerVistaPrevia()
    {
        if (lineas.Count == 0)
        {
            error = "Agrega al menos un producto a la venta.";
            return;
        }
        if (lineas.Any(l => l.Cantidad <= 0))
        {
            error = "La cantidad de cada producto debe ser mayor a 0.";
            return;
        }
        foreach (var grupo in lineas.GroupBy(l => l.Producto.id_producto))
        {
            var pedido = grupo.Sum(l => l.Cantidad);
            var prod = grupo.First().Producto;
            if (pedido > prod.existencia)
            {
                error = $"Inventario insuficiente para \"{prod.descripcion}\": disponible {prod.existencia}, solicitado {pedido}.";
                return;
            }
        }

        ArmarVenta();

        guardando = true;
        try
        {
            var (documento, mensaje) = await Servicio.VistaPreviaAsync(venta);
            if (mensaje != null)
            {
                error = mensaje;     // por ejemplo: venta mayor a Q 2,500 con consumidor final
                return;
            }
            vista = documento;
        }
        catch (Exception)
        {
            error = SinConexion;
        }
        finally
        {
            guardando = false;
        }
    }

    // Aquí es donde por fin se guarda la venta y su factura.
    private async Task Confirmar()
    {
        error = null;
        ArmarVenta();

        guardando = true;
        try
        {
            var (idVenta, mensaje) = await Servicio.CrearVentaAsync(venta);
            if (mensaje != null)
            {
                vista = null;        // vuelve al formulario para corregir
                error = mensaje;
                return;
            }
            Nav.NavigateTo($"ventas/factura/{idVenta}");
        }
        catch (Exception)
        {
            error = SinConexion;
        }
        finally
        {
            guardando = false;
        }
    }

    private void VolverAEditar() => vista = null;

    private void ArmarVenta()
    {
        venta = new Venta
        {
            id_cliente = clienteSel!.id_cliente,
            id_empleado = empleadoSel!.id_empleado,
            observaciones = null,
            Detalles = lineas.Select(l => new VentasDetalle
            {
                id_producto = l.Producto.id_producto,
                cantidad = l.Cantidad,
                precio_venta = l.Producto.precio_venta,
                subtotal = l.Cantidad * l.Producto.precio_venta
            }).ToList()
        };
        venta.total = venta.Detalles.Sum(d => d.subtotal);
    }

    private async Task GuardarEdicion()
    {
        venta.id_cliente = clienteSel!.id_cliente;
        venta.id_empleado = empleadoSel!.id_empleado;

        guardando = true;
        try
        {
            var resultado = await Servicio.EditarAsync(venta);
            if (resultado != null)
            {
                error = resultado;
                return;
            }
            Nav.NavigateTo("ventas");
        }
        catch (Exception)
        {
            error = SinConexion;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("print");
}
