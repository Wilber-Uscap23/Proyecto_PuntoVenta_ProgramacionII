<?xml version="1.0" encoding="utf-8"?>
<!--
  Módulo: Publicación en IIS — Rodrigo Rodríguez
  Visual Studio: clic derecho al proyecto > Publicar > IIS-Carpeta > Publicar.
  Consola:       dotnet publish PuntoVenta.Web -p:PublishProfile=IIS-Carpeta
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishUrl>C:\inetpub\PuntoVenta\Web</PublishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
</Project>
