@page "/compras"
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Compras</h3>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="proveedores">Ir a Proveedores</a>
        <a class="btn btn-primary" href="compras/nueva">+ Nueva compra</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger py-2">@error</div> }

@if (cargando) { <p>Cargando...</p> }
else if (compras.Count == 0) { <p class="text-muted">Aún no hay compras registradas.</p> }
else
{
    <table class="table table-striped align-middle">
        <thead class="table-dark"><tr><th>#</th><th>Fecha</th><th>Proveedor</th><th class="text-end">Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in compras)
        {
            <tr>
                <td>@c.IdCompra</td>
                <td>@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@c.Proveedor</td>
                <td class="text-end">Q @c.Total.ToString("N2")</td>
                <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => Ver(c.IdCompra)">@(abierta?.IdCompra == c.IdCompra ? "Ocultar" : "Ver detalle")</button></td>
            </tr>
            @if (abierta?.IdCompra == c.IdCompra)
            {
                <tr><td colspan="5" class="bg-light">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Precio costo</th><th class="text-end">Subtotal</th></tr></thead>
                        <tbody>
                        @foreach (var d in abierta.Detalles)
                        {
                            <tr><td>@d.Producto</td><td class="text-end">@d.Cantidad</td>
                                <td class="text-end">Q @d.PrecioCosto.ToString("N2")</td><td class="text-end">Q @d.Subtotal.ToString("N2")</td></tr>
                        }
                        </tbody>
                    </table>
                </td></tr>
            }
        }
        </tbody>
    </table>
}

@code {
    List<CompraResumen> compras = new();
    CompraView? abierta;
    string? error;
    bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var r = await Http.GetAsync("api/compras");
            if (r.IsSuccessStatusCode) compras = await r.Content.ReadFromJsonAsync<List<CompraResumen>>() ?? new();
            else error = await ApiErrors.ReadAsync(r);
        }
        catch (HttpRequestException) { error = "No se pudo conectar con el servidor."; }
        cargando = false;
    }

    async Task Ver(int id)
    {
        if (abierta?.IdCompra == id) { abierta = null; return; }
        var r = await Http.GetAsync($"api/compras/{id}");
        if (r.IsSuccessStatusCode) abierta = await r.Content.ReadFromJsonAsync<CompraView>();
        else error = await ApiErrors.ReadAsync(r);
    }
}
