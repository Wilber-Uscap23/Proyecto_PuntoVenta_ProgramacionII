@page "/proveedores"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Proveedores</h3>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="compras">&larr; Volver a Compras</a>
        <button class="btn btn-primary" @onclick="Nuevo">+ Nuevo proveedor</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success py-2">@mensaje</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="input-group mb-3">
    <input class="form-control" placeholder="Buscar por nombre, NIT, correo o teléfono..."
           @bind="buscar" @bind:event="oninput" @onkeydown="TeclaBuscar" />
    <button class="btn btn-outline-primary" @onclick="Cargar">Buscar</button>
    <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
</div>

@if (editando is not null)
{
    <div class="card mb-4">
        <div class="card-header">@(editando.IdProveedor == 0 ? "Nuevo proveedor" : $"Editar proveedor #{editando.IdProveedor}")</div>
        <div class="card-body">
            <EditForm Model="editando" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="editando.Nombre" />
                        <ValidationMessage For="() => editando.Nombre" class="text-danger" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">NIT</label>
                        <InputText class="form-control" @bind-Value="editando.Nit" />
                        <ValidationMessage For="() => editando.Nit" class="text-danger" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="editando.Telefono" />
                        <ValidationMessage For="() => editando.Telefono" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Dirección</label>
                        <InputText class="form-control" @bind-Value="editando.Direccion" />
                        <ValidationMessage For="() => editando.Direccion" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo</label>
                        <InputText class="form-control" @bind-Value="editando.Correo" />
                        <ValidationMessage For="() => editando.Correo" class="text-danger" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success" disabled="@guardando">Guardar</button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (cargando)
{
    <p>Cargando...</p>
}
else if (lista.Count == 0)
{
    <p class="text-muted">No se encontraron proveedores.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr><th>#</th><th>Nombre</th><th>NIT</th><th>Teléfono</th><th>Correo</th><th>Dirección</th><th style="width:170px"></th></tr>
            </thead>
            <tbody>
            @foreach (var p in lista)
            {
                <tr>
                    <td>@p.IdProveedor</td><td>@p.Nombre</td><td>@p.Nit</td>
                    <td>@p.Telefono</td><td>@p.Correo</td><td>@p.Direccion</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(p)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(p)">Eliminar</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    List<Proveedor> lista = new();
    Proveedor? editando;
    string buscar = "";
    string? error, mensaje;
    bool cargando, guardando;

    protected override async Task OnInitializedAsync() => await Cargar();

    async Task Cargar()
    {
        cargando = true; error = null;
        try
        {
            var url = string.IsNullOrWhiteSpace(buscar) ? "api/proveedores" : $"api/proveedores?buscar={Uri.EscapeDataString(buscar)}";
            var r = await Http.GetAsync(url);
            if (r.IsSuccessStatusCode) lista = await r.Content.ReadFromJsonAsync<List<Proveedor>>() ?? new();
            else error = await ApiErrors.ReadAsync(r);
        }
        catch (HttpRequestException) { error = "No se pudo conectar con el servidor."; }
        cargando = false;
    }

    async Task TeclaBuscar(KeyboardEventArgs e) { if (e.Key == "Enter") await Cargar(); }
    async Task Limpiar() { buscar = ""; await Cargar(); }

    void Nuevo() { editando = new(); mensaje = error = null; }
    void Editar(Proveedor p)
    {
        editando = new Proveedor { IdProveedor = p.IdProveedor, Nombre = p.Nombre, Nit = p.Nit,
            Telefono = p.Telefono, Direccion = p.Direccion, Correo = p.Correo };
        mensaje = error = null;
    }
    void Cancelar() => editando = null;

    async Task Guardar()
    {
        if (editando is null) return;
        guardando = true; error = mensaje = null;
        try
        {
            var nuevo = editando.IdProveedor == 0;
            var r = nuevo
                ? await Http.PostAsJsonAsync("api/proveedores", editando)
                : await Http.PutAsJsonAsync($"api/proveedores/{editando.IdProveedor}", editando);

            if (r.IsSuccessStatusCode)
            {
                mensaje = nuevo ? "Proveedor creado correctamente." : "Proveedor actualizado correctamente.";
                editando = null;
                await Cargar();
            }
            else error = await ApiErrors.ReadAsync(r);
        }
        catch (HttpRequestException) { error = "No se pudo conectar con el servidor."; }
        guardando = false;
    }

    async Task Eliminar(Proveedor p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar al proveedor \"{p.Nombre}\"?")) return;
        error = mensaje = null;
        var r = await Http.DeleteAsync($"api/proveedores/{p.IdProveedor}");
        if (r.IsSuccessStatusCode) { mensaje = "Proveedor eliminado."; await Cargar(); }
        else error = await ApiErrors.ReadAsync(r);
    }
}
