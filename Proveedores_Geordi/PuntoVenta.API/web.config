<?xml version="1.0" encoding="utf-8"?>
<!--
  Módulo: Publicación en IIS — Rodrigo Rodríguez
  Al publicar, Visual Studio / dotnet publish completa processPath y arguments.
  Para ver errores 500.30 / 502.5 cambie stdoutLogEnabled a "true" y revise la carpeta logs.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\PuntoVenta.API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
